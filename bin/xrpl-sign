#!/usr/bin/env python3
"""xrpl-sign v0.5: the POLICY-GATED SIGNER half of the hardened XRPL skill.

This is the only program that ever sees the wallet seed. It signs NOTHING
unless ALL of these hold:

  1. A proposal built by `xrpl-trade` exists, its hash-bound ENVELOPE
     verifies exactly (network, account, action, creation time, policy
     version, canonical binary transaction), it is younger than the
     policy TTL, and its internal invariants hold (envelope account ==
     tx Account, action matches type and buy/sell orientation, required
     fields present, no signature material in the unsigned proposal,
     created_at not from the future). Old-format proposals are rejected.
  2. Signer state files (policy, allowlist, spend state, audit log) are
     owner-only — otherwise signing is refused outright.
  3. The proposal's network matches the policy's network_lock
     (default: testnet — mainnet proposals hard-fail until you opt in).
  4. The transaction type is allowlisted (OfferCreate, OfferCancel,
     TrustSet, Payment, NFTokenMint, NFTokenCreateOffer), every field
     matches the strict per-type schema, and every amount/fee/sequence is
     finite and sane. Unknown types, smuggled fields (Paths, SendMax,
     memos, partial-payment flags, NFToken Owner/Issuer…), NaN/Infinity
     amounts are rejected.
  5. Every non-XRP token is in the approved allowlist, extracted from the
     TX JSON itself; offers must match an approved PAIR exactly. NFT
     mints/listings touch no IOUs: mints enforce the nft policy (URI
     <= max_uri_bytes, TransferFee <= min(policy cap, 50000), flags
     restricted to the policy-gated set, mints per rolling 24h capped);
     listings must be XRP-denominated sell offers (tfSellNFToken) with a
     bounded Expiration — buy offers are unrepresentable (no Owner field
     in the schema).
  6. Fee <= max_fee_drops. Offers carry an Expiration inside the allowed
     lifetime window and price within max_deviation_bps of the live
     depth-weighted book mid (both sides present, spread and depth
     checked, fail-closed).
  7. Payments go only to allowlisted (address, destination-tag) pairs;
     destinations requiring a tag are enforced (fail-closed on lookup
     trouble).
  8. Per-asset per-transaction and true rolling-24h caps hold, reserved
     atomically at signing time. Reservations stay pending through
     ambiguous submission outcomes and are released only on proven
     failure or proof of non-inclusion.
  9. A human passed --approve for THIS EXACT hash. Without it, this program
     only checks policy and prints the DERIVED summary — it never signs.

Seed: read ONLY from the XRPL_SEED environment variable. In production the
Muse vault injects it after genuine human confirmation; it must never be a
raw exported variable in a shared shell. The derived address must match the
proposal's account or that account's ledger-verified RegularKey (e.g. the
main wallet whose master key is disabled and whose regular key is the
Musegives key), or signing is refused.

Giveaway mode: `xrpl-sign --hash <h> --approve --seed-env XRPL_GIVEAWAY_SEED
--policy ~/.xrpl/giveaway_policy.json` signs donation-wallet gifts under a
separate narrow policy (Payment + NFTokenCreateOffer only, per-gift XRP
cap, separate spend accounting). The vault injects XRPL_GIVEAWAY_SEED the
same way; `xrpl-trade giveaway setup` is the deliberate local fallback.

Submission is crash-safe: the transaction is signed, the reservation is
bound to the signed hash + LastLedgerSequence, and both are persisted to
the audit log BEFORE submit_and_wait, so a crash between signing and
submission still leaves a reconciliation trail (XRPL reliable-submission
guidance).
"""
import argparse
import json
import os
import sys
import time
from decimal import Decimal

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import xrpl_common as C

try:
    from xrpl.models.currencies import IssuedCurrency, XRP
    from xrpl.models.requests import AccountInfo, BookOffers
    from xrpl.transaction import sign as sign_tx, submit_and_wait
    from xrpl.utils import drops_to_xrp
    from xrpl.wallet import Wallet
except ImportError:
    sys.exit("xrpl-py not installed. Run: pip install -r requirements.txt")


# ---------- policy ----------

def cmd_init_policy(_args):
    if C.POLICY_PATH.exists():
        sys.exit(f"Policy already exists: {C.POLICY_PATH} (edit it directly)")
    C.XRPL_DIR.mkdir(parents=True, exist_ok=True)
    C.POLICY_PATH.write_text(json.dumps(C.DEFAULT_POLICY, indent=2))
    os.chmod(C.POLICY_PATH, 0o600)
    print(f"Wrote default policy v{C.POLICY_VERSION} to {C.POLICY_PATH}:")
    print(json.dumps(C.DEFAULT_POLICY, indent=2))
    print("\nMainnet is LOCKED OUT by default (network_lock=testnet).")
    print("To allow mainnet, set \"network_lock\": \"mainnet\" — and fund a")
    print("dedicated limited-funds wallet. Add per-asset spend_limits for")
    print("every token you trade (assets without limits are BLOCKED).")


def cmd_migrate_policy(_args):
    """Upgrade a policy file to v4 (keeps a .bak), or backfill a v4
    policy with the v0.5 nft defaults.

    Conservative like the v0.4 migration: operator settings are
    preserved, and allowed_tx_types is NEVER widened silently — an
    operator opts into NFTokenMint / NFTokenCreateOffer by editing the
    list themselves."""
    if not C.POLICY_PATH.exists():
        sys.exit(f"No policy file at {C.POLICY_PATH}")
    old = json.loads(C.POLICY_PATH.read_text())
    ver = old.get("policy_version", 2)
    if ver == C.POLICY_VERSION:
        missing = [k for k in ("nft",) if k not in old]
        if not missing:
            sys.exit("Policy is already up to date.")
        bak = C.POLICY_PATH.with_suffix(".json.v4.bak")
        bak.write_text(json.dumps(old, indent=2))
        new = dict(old)
        new["nft"] = json.loads(json.dumps(C.DEFAULT_POLICY["nft"]))
        C.POLICY_PATH.write_text(json.dumps(new, indent=2))
        os.chmod(C.POLICY_PATH, 0o600)
        print(f"Backed up v4 policy to {bak}")
        print(f"Backfilled v0.5 defaults: {', '.join(missing)}")
        print("NOTE: allowed_tx_types was NOT widened — add NFTokenMint / "
              "NFTokenCreateOffer yourself to enable NFTs.")
        return
    if ver == 3:
        bak = C.POLICY_PATH.with_suffix(".json.v3.bak")
        bak.write_text(json.dumps(old, indent=2))
        new = dict(old)
        new["policy_version"] = C.POLICY_VERSION
        new["nft"] = json.loads(json.dumps(C.DEFAULT_POLICY["nft"]))
        C.POLICY_PATH.write_text(json.dumps(new, indent=2))
        os.chmod(C.POLICY_PATH, 0o600)
        print(f"Backed up v3 policy to {bak}")
        print(f"Migrated policy to v{C.POLICY_VERSION}; added the nft "
              f"section with v0.5 defaults.")
        print("NOTE: allowed_tx_types was NOT widened — add NFTokenMint / "
              "NFTokenCreateOffer yourself to enable NFTs.")
        return
    new = dict(C.DEFAULT_POLICY)
    new["network_lock"] = old.get("network_lock", "testnet")
    new["max_fee_drops"] = old.get("max_fee_drops", 1000)
    new["spend_limits"] = {
        "XRP": {
            "per_tx": str(old.get("per_tx_max_xrp", 25)),
            "per_day": str(old.get("daily_max_xrp", 100)),
        }
    }
    new["destination_allowlist"] = [
        {"address": a, "destination_tag": None}
        for a in old.get("destination_allowlist", [])
    ]
    new["max_deviation_bps"] = old.get("max_deviation_bps", 1000)
    new["max_spread_bps"] = old.get("max_spread_bps", 1000)
    new["min_book_depth"] = old.get("min_book_depth", "5")
    new["max_offer_lifetime_seconds"] = old.get(
        "max_offer_lifetime_seconds", 86400)
    new["proposal_ttl_seconds"] = old.get("proposal_ttl_seconds", 86400)
    new["allowed_tx_types"] = old.get(
        "allowed_tx_types", ["OfferCreate", "OfferCancel", "TrustSet",
                             "Payment"])
    bak = C.POLICY_PATH.with_suffix(".json.v2.bak")
    bak.write_text(json.dumps(old, indent=2))
    C.POLICY_PATH.write_text(json.dumps(new, indent=2))
    os.chmod(C.POLICY_PATH, 0o600)
    print(f"Backed up v2 policy to {bak}")
    print(f"Wrote v{C.POLICY_VERSION} policy to {C.POLICY_PATH}. NOTE: "
          f"per-asset spend_limits currently cover XRP only — add limits "
          f"for every IOU you trade, or those assets stay blocked (fail "
          f"closed). Add NFTokenMint / NFTokenCreateOffer / "
          f"NFTokenAcceptOffer to allowed_tx_types to enable NFTs, and set "
          f"nft.allow_buy_offers=true to enable the buy side.")


def _cur_from_amount(a):
    if isinstance(a, str):
        return XRP()
    return IssuedCurrency(currency=a["currency"], issuer=a["issuer"])


def book_reference(client, pays, gets, policy):
    """Depth-weighted mid price (gets per pays) from the live book.

    Requires BOTH sides present, spread within max_spread_bps, and minimum
    funded depth per side — a book of dust offers cannot set the reference
    price. Returns (dw_mid, None) or (None, denial_reason). Fail closed.
    """
    pays_c, gets_c = _cur_from_amount(pays), _cur_from_amount(gets)
    try:
        asks_r = client.request(BookOffers(taker_gets=pays_c, taker_pays=gets_c,
                                           limit=10, ledger_index="validated"))
        bids_r = client.request(BookOffers(taker_gets=gets_c, taker_pays=pays_c,
                                           limit=10, ledger_index="validated"))
    except Exception:  # noqa: BLE001
        return None, "could not fetch book for price check (fail closed)"
    if not (asks_r.is_successful() and bids_r.is_successful()):
        return None, "could not fetch book for price check (fail closed)"
    ao, bo = asks_r.result.get("offers", []), bids_r.result.get("offers", [])
    if not ao or not bo:
        return None, "one-sided or empty book — cannot verify price (fail closed)"

    def side_dw(offers, num_f, den_f, qty_f):
        """Depth-weighted price (num/den, i.e. gets per pays), weighting
        each level by its pays-side quantity."""
        tot_q = Decimal(0)
        tot_pq = Decimal(0)
        for o in offers:
            try:
                n = C.amount_value(o[num_f])
                d = C.amount_value(o[den_f])
                q = C.amount_value(o[qty_f])
                sane = n.is_finite() and d.is_finite() and q.is_finite()
            except Exception:  # noqa: BLE001 — malformed book level
                continue
            if not sane or n <= 0 or d <= 0 or q <= 0:
                continue
            tot_q += q
            tot_pq += (n / d) * q
        return (tot_pq / tot_q if tot_q > 0 else None), tot_q

    # asks: offers selling pays for gets. price = TakerPays/TakerGets
    # (gets per pays); pays-side qty = TakerGets.
    dw_ask, ask_depth = side_dw(ao, "TakerPays", "TakerGets", "TakerGets")
    # bids: offers buying gets with pays. price = TakerGets/TakerPays;
    # pays-side qty = TakerPays.
    dw_bid, bid_depth = side_dw(bo, "TakerGets", "TakerPays", "TakerPays")
    if dw_ask is None or dw_bid is None:
        return None, "book has no usable levels (fail closed)"
    if dw_ask < dw_bid:
        return None, "crossed book (bid above ask) — cannot verify price (fail closed)"
    min_depth = Decimal(str(policy.get("min_book_depth", "5")))
    if ask_depth < min_depth or bid_depth < min_depth:
        return None, (f"book too thin — depth {min(ask_depth, bid_depth):f} < "
                       f"min {min_depth:f} pays-side units (fail closed)")
    mid = (dw_ask + dw_bid) / 2
    spread_bps = (dw_ask - dw_bid) / mid * 10000
    if spread_bps > Decimal(str(policy.get("max_spread_bps", 1000))):
        return None, (f"book spread {spread_bps:.0f} bps > max "
                       f"{policy.get('max_spread_bps', 1000)} bps (fail closed)")
    return mid, None


def check_deviation(client, tx, policy):
    """Offer limit vs live depth-weighted book mid, derived from the TX —
    never from stored metadata. Fail closed on any book anomaly."""
    pays, gets = tx["TakerPays"], tx["TakerGets"]
    pv, gv = C.amount_value(pays), C.amount_value(gets)
    if pv <= 0 or gv <= 0:
        return "offer has a zero amount"
    implied = gv / pv  # gets per pays
    mid, problem = book_reference(client, pays, gets, policy)
    if problem:
        return problem
    dev_bps = abs(implied - mid) / mid * 10000
    if dev_bps > policy["max_deviation_bps"]:
        return (f"limit {implied:.6f} (gets per pays) deviates {dev_bps:.0f} bps "
                f"from depth-weighted mid {mid:.6f} > max "
                f"{policy['max_deviation_bps']} bps")
    return None


def check_require_dest_tag(client, dest, tag):
    """Deny when the destination account requires a tag and none is given.

    Fail CLOSED: if the flag cannot be verified (node error, unexpected
    response), the payment is denied rather than risking a fee on a
    ledger-rejected transaction. Only a proven-absent account (which cannot
    carry the flag) passes silently.
    """
    try:
        r = client.request(AccountInfo(account=dest, ledger_index="validated"))
    except Exception:  # noqa: BLE001
        return ("could not verify RequireDestTag flag (node error) — "
                "fail closed")
    if not r.is_successful():
        if r.result.get("error") == "actNotFound":
            return None  # account doesn't exist yet -> flag can't be set
        return (f"could not verify RequireDestTag flag "
                f"({r.result.get('error')}) — fail closed")
    flags = int(r.result["account_data"].get("Flags", 0))
    if flags & C.REQUIRE_DEST_TAG_FLAG and tag is None:
        return (f"destination {dest[:12]}… requires a destination tag "
                f"(RequireDestTag set) — refusing untagged payment")
    return None


def check_policy(prop, tx, policy, client, tracker):
    """Return a list of denial reasons (empty = pass). Never signs.
    Every value is derived from the transaction JSON or the hash-bound
    envelope — never from stored summaries or metadata."""
    denials = []
    ttype = tx.get("TransactionType")
    allowed_types = policy.get("allowed_tx_types", C.DEFAULT_ALLOWED_TX_TYPES)

    # 0. strict shape: unknown types and smuggled fields die here
    denials.extend(C.validate_tx_shape(tx, allowed_types))
    # 0b. numeric sanity: NaN/Infinity would poison limit comparisons,
    # so amounts are validated BEFORE any spend is measured
    amount_problems = C.validate_amounts(tx)
    denials.extend(amount_problems)

    # 1. network lock (network is hash-bound in the envelope)
    if prop["network"] != policy["network_lock"]:
        denials.append(
            f"network {prop['network']!r} != policy network_lock "
            f"{policy['network_lock']!r}")

    # 2. allowlist from the TX JSON itself
    if ttype == "OfferCreate":
        pay_tok = C.norm_token(
            tx["TakerPays"]["currency"] if isinstance(tx["TakerPays"], dict) else "XRP",
            tx["TakerPays"].get("issuer") if isinstance(tx["TakerPays"], dict) else None)
        get_tok = C.norm_token(
            tx["TakerGets"]["currency"] if isinstance(tx["TakerGets"], dict) else "XRP",
            tx["TakerGets"].get("issuer") if isinstance(tx["TakerGets"], dict) else None)
        if pay_tok == get_tok:
            denials.append("offer pays and gets are the same asset")
        elif frozenset((pay_tok, get_tok)) not in C.approved_pair_set():
            denials.append(
                f"pair {{{pay_tok[0]}.{str(pay_tok[1])[:8] if pay_tok[1] else ''}, "
                f"{get_tok[0]}.{str(get_tok[1])[:8] if get_tok[1] else ''}}} "
                f"is not an exactly-approved pair")
    else:
        for ccy, iss in C.tx_tokens(tx):
            if (ccy, iss) not in C.approved_token_set():
                denials.append(f"token {ccy}.{str(iss)[:12]}… not in approved allowlist")

    # 3. fee cap
    fee_drops = int(tx.get("Fee", "0"))
    if fee_drops > policy["max_fee_drops"]:
        denials.append(f"fee {fee_drops} drops > max {policy['max_fee_drops']}")

    # 4. offers: bounded expiry + deviation (both tx-derived)
    if ttype == "OfferCreate":
        if "Expiration" not in tx:
            denials.append("OfferCreate without Expiration")
        else:
            now_r = int(time.time()) - C.RIPPLE_EPOCH
            exp = tx["Expiration"]
            max_life = int(policy.get("max_offer_lifetime_seconds", 86400))
            if isinstance(exp, int) and now_r < exp <= now_r + max_life:
                dev = check_deviation(client, tx, policy)
                if dev:
                    denials.append(dev)
            else:
                denials.append(
                    f"offer Expiration {exp} outside the allowed window "
                    f"(now, now+{max_life}s) — refusing")

    # 4b. NFT sell offers: bounded expiry like other offers, but NO
    # book-deviation check — each NFTokenID is unique, there is no
    # fungible book to check a price against.
    if ttype == "NFTokenCreateOffer":
        if "Expiration" not in tx:
            denials.append("NFTokenCreateOffer without Expiration")
        else:
            now_r = int(time.time()) - C.RIPPLE_EPOCH
            exp = tx["Expiration"]
            max_life = int(policy.get("max_offer_lifetime_seconds", 86400))
            if not (isinstance(exp, int) and now_r < exp <= now_r + max_life):
                denials.append(
                    f"listing Expiration {exp} outside the allowed window "
                    f"(now, now+{max_life}s) — refusing")

    # 4c. NFT policy: mint URI/royalty/flags + rolling mint rate limit;
    # offer shape (XRP-only, valid token id / destination); buy-side
    # (bids) additionally need the policy toggle + per-bid cap.
    if ttype == "NFTokenMint":
        denials.extend(C.check_nft_mint(tx, policy))
        # provisional; the atomic reservation happens at signing time below
        denials.extend(C.check_mint_rate(policy, tracker))
    if ttype == "NFTokenCreateOffer":
        denials.extend(C.check_nft_offer(tx, policy))

    # 5. payment destinations. Default: exact (address, tag) allowlist
    # match. Giveaway mode (`allow_any_payment_destination`): winners are
    # arbitrary addresses — the human approved this exact destination in
    # the proposal ceremony, so the signer only re-validates the shape
    # (valid classic address, never seed-like). The require-dest-tag
    # check below still applies in both modes.
    if ttype == "Payment":
        denials.extend(C.check_payment_destination(tx, policy))
        req = check_require_dest_tag(client, tx.get("Destination", ""),
                                     tx.get("DestinationTag"))
        if req:
            denials.append(req)

    # 6. per-asset spend caps (provisional here; atomic reserve at signing)
    # — skipped when amounts are insane, so NaN can never reach comparisons
    spends = {}
    if not amount_problems:
        spends = C.tx_spends(tx)
        if ttype == "NFTokenAcceptOffer":
            # the spend lives in the referenced sell offer, not in the
            # tx: fetch it from the ledger (fail closed), verify it is
            # really an XRP sell offer the seller still owns, and fold
            # the price into the reservation.
            ad, amount = C.check_nft_accept_offer(tx, client, policy)
            denials.extend(ad)
            if amount is not None:
                spends["XRP"] = spends.get("XRP", Decimal(0)) + amount
        denials.extend(tracker.check(spends, policy))

    return denials, spends


# ---------- signing ----------

def load_seed(seed_env="XRPL_SEED"):
    """Seed ONLY from the named environment variable. In production the
    Muse vault injects it after genuine human confirmation; it must never
    be a raw exported variable in a shared shell. No config-file fallback
    for the main seed (removed v0.3).

    For the giveaway seed env (XRPL_GIVEAWAY_SEED) there is one deliberate
    fallback: the owner-only giveaway.json written by `giveaway setup`.
    The vault's env injection is preferred; the seed never touches chat,
    logs, or proposals either way."""
    seed = os.environ.get(seed_env)
    if not seed and seed_env == C.GIVEAWAY_SEED_ENV:
        seed = C.read_giveaway_seed()
    if not seed:
        hint = (f"the vault did not inject {seed_env} for this signing"
                if seed_env != C.GIVEAWAY_SEED_ENV else
                f"{seed_env} is not set and no seed is stored — run "
                f"`xrpl-trade giveaway setup` or have the vault inject "
                f"{seed_env} after human approval")
        sys.exit(f"No seed. {hint} — it is never exported by hand or read "
                 "from a chat log (see SECURITY.md).")
    return seed


def _authorized_signers(client, account):
    """Addresses the validated ledger authorizes to sign for `account`.

    Returns {account} plus the account's RegularKey when one is set, or
    None when the ledger state cannot be verified. The caller fails
    closed on None: without a proven authorization set, no signature is
    produced. The set is read from the validated ledger at signing time —
    never from the proposal — so a rotated RegularKey is honored and a
    tampered proposal cannot widen the set.
    """
    try:
        r = client.request(AccountInfo(account=account,
                                       ledger_index="validated"))
    except Exception:  # noqa: BLE001
        return None
    if not r.is_successful():
        return None
    data = r.result.get("account_data", {})
    allowed = {account}
    regular = data.get("RegularKey")
    if regular:
        allowed.add(regular)
    return allowed


def _reserve_sign_bind(prop, tx, policy, tracker, spends, seed_env, client):
    """Post-approval core: reserve budget, sign, bind reservation.

    Returns (signed_tx, thash, last_ledger, auth_path). The try/finally releases the
    unbound reservation(s) on EVERY exception path from here through bind —
    including SystemExit from a missing seed and KeyboardInterrupt.

    load_seed() deliberately stays AFTER the --approve check in cmd_sign():
    the vault injects the seed only at genuine human approval time, so
    reading it earlier would be both useless and a boundary violation.
    (Do not "fix" this by moving the seed load up.)
    """
    rid = None
    mrid = None
    bound = False
    try:
        try:
            # Atomic daily-limit reservation: concurrent signers can't
            # double-spend the daily budget between the check above and
            # the signing below.
            reserve_denials, rid = tracker.try_reserve(spends, policy)
            if reserve_denials:
                msg = "; ".join(reserve_denials)
                C.audit(prop.get("action", "?"), prop["proposal_hash"], None,
                        prop["network"], tx["Account"], "policy_denied",
                        "atomic reserve: " + msg, spends)
                sys.exit(f"Daily-limit reservation failed: {msg}")

            # NFT mints also consume one unit of the rolling mint quota,
            # reserved atomically here (same lock) so parallel signers can't
            # overshoot the cap between the provisional check and signing.
            # The count entry rides the normal bind/confirm/release lifecycle
            # with the spend entries.
            if tx.get("TransactionType") == "NFTokenMint":
                cap = int(C.nft_policy(policy)["max_mints_per_day"])
                m_denials, mrid = tracker.try_reserve_count(
                    C.NFT_MINT_ASSET, 1, cap)
                if m_denials:
                    msg = "; ".join(m_denials)
                    C.audit(prop.get("action", "?"), prop["proposal_hash"],
                            None, prop["network"], tx["Account"],
                            "policy_denied",
                            "atomic mint reserve: " + msg, spends)
                    sys.exit(f"Mint-quota reservation failed: {msg}")

            seed = load_seed(seed_env)
            try:
                wallet = Wallet.from_seed(seed)
            except Exception:
                sys.exit("Seed invalid.")
            # v0.6.1: the seed may be the account's RegularKey rather than
            # its master key (e.g. the main wallet's master is disabled and
            # its regular key is the Musegives key). The authorized set is
            # the account plus its RegularKey as recorded on the VALIDATED
            # ledger, read here at signing time — never from the proposal.
            allowed = _authorized_signers(client, tx["Account"])
            if allowed is None:
                sys.exit("Could not verify the authorized signing keys for "
                         f"{tx['Account']} from the validated ledger — "
                         "refusing to sign (fail closed).")
            if wallet.classic_address not in allowed:
                sys.exit(f"Seed derives {wallet.classic_address}, but the "
                         f"validated ledger authorizes {sorted(allowed)} "
                         f"for {tx['Account']} — refusing (wallet mismatch).")
            auth_path = ("regular_key"
                         if wallet.classic_address != tx["Account"]
                         else "master")
            print(f"  signing as {auth_path}: {wallet.classic_address}")
            del seed

            from xrpl.models.transactions import Transaction
            tx_obj = Transaction.from_xrpl(tx)  # tx stored in PascalCase wire format
            signed = sign_tx(tx_obj, wallet)
            thash = signed.get_hash()
            last_ledger = tx.get("LastLedgerSequence")

            # Bind the reservation(s) to the signed tx, then persist BEFORE
            # submitting: a crash between sign and submit still leaves a
            # reconciliation trail (hash + last ledger), and the budget stays
            # reserved until the ledger outcome is known.
            tracker.bind_reservation(rid, thash, last_ledger)
            tracker.bind_reservation(mrid, thash, last_ledger)
            bound = True
            return signed, thash, last_ledger, auth_path
        finally:
            if not bound:
                # release_reservation only drops UNBOUND pending entries and
                # is a no-op for None, so this is safe on every path —
                # including a partially completed bind.
                tracker.release_reservation(rid)
                tracker.release_reservation(mrid)
    except C.StateCorruptError as e:
        sys.exit(str(e))


def cmd_sign(args):
    # The protected deployment boundary: policy, allowlist, spend state,
    # and audit log must be owner-only, or limits are fiction. Giveaway
    # mode additionally protects the giveaway policy and giveaway.json
    # (which may hold the donation-wallet seed).
    policy = C.load_policy(args.policy)
    giveaway_mode = bool(policy.get("giveaway"))
    C.check_protected_files(
        extra=(C.GIVEAWAY_POLICY_PATH, C.GIVEAWAY_PATH)
        if giveaway_mode else ())

    prop, path = C.load_proposal(args.hash)

    # envelope verification: tamper evidence for everything the human reviewed
    try:
        tx = C.verify_proposal(prop, path)
        C.verify_envelope_invariants(prop, tx)
    except C.ProposalError as e:
        C.audit("?", prop.get("proposal_hash", "?"), None,
                prop.get("network", "?"), prop.get("account", "?"),
                "proposal_rejected", str(e))
        sys.exit(f"Proposal rejected: {e}")

    # Full-hash approval (v0.6.0 item 4): a prefix is fine for the
    # read-only review, but --approve must name the EXACT 64-char hash
    # the human reviewed. Refused before any policy check or signing.
    if args.approve:
        C.require_full_hash_for_approve(args.hash, prop)

    policy = C.load_policy(args.policy)
    giveaway_mode = bool(policy.get("giveaway"))
    tracker = (C.SpentTracker(state_path=C.GIVEAWAY_STATE_PATH,
                              lock_path=C.GIVEAWAY_STATE_LOCK_PATH)
               if giveaway_mode else C.SpentTracker())

    # proposal TTL (created_at is hash-bound)
    age = int(time.time()) - prop["created_at"]
    if age > policy["proposal_ttl_seconds"]:
        sys.exit(f"Proposal is {age // 3600}h old (TTL "
                 f"{policy['proposal_ttl_seconds'] // 3600}h) — rebuild it.")

    client = C.make_client(prop["network"])
    try:
        # Resolve any ambiguous past reservations before checking limits.
        tracker.sweep_pending(client)
        denials, spends = check_policy(prop, tx, policy, client, tracker)
    except C.StateCorruptError as e:
        sys.exit(str(e))

    # ---- the ceremony: everything below is DERIVED from the tx ----
    print("=" * 60)
    print(f"PROPOSAL {prop['proposal_hash'][:16]}… "
          f"({age // 60}m old, {prop['network']})")
    print(f"  account:  {tx['Account']}")
    print("=" * 60)
    for ln in C.describe_tx(tx, prop.get("action", "?")):
        print("  " + ln)
    if tx.get("TransactionType") == "NFTokenAcceptOffer":
        # The buy ceremony: re-verify the sell offer from the ledger AT
        # SIGNING time and show the authoritative facts. If the offer
        # changed or vanished since the proposal, refuse to sign — a
        # TOCTOU on the offer index must never become a blind purchase.
        rlines, rdenials, _ = C.nft_sell_offer_report(
            client, tx.get("NFTokenSellOffer", ""))
        print("  --- sell offer re-verified from the ledger at signing ---")
        print("  VERIFY the issuer below is the artist you expect; anyone "
              "can mint the same artwork.")
        print("  The seller is the current owner, not necessarily the minter.")
        for ln in rlines:
            print("  " + ln)
        if rdenials:
            print("  ✗ the offer changed since the proposal:")
            for d in rdenials:
                print(f"    ✗ {d}")
            C.audit(prop.get("action", "?"), prop["proposal_hash"], None,
                    prop["network"], tx["Account"], "policy_denied",
                    "offer changed at signing: " + "; ".join(rdenials),
                    spends)
            sys.exit(1)
    print("  spends: " + ", ".join(f"{v} {k}" for k, v in spends.items()))
    print("=" * 60)

    if denials:
        print("POLICY DENIED:")
        for d in denials:
            print(f"  ✗ {d}")
        C.audit(prop.get("action", "?"), prop["proposal_hash"], None,
                prop["network"], tx["Account"], "policy_denied",
                "; ".join(denials), spends)
        sys.exit(1)
    print("policy: PASS")

    if not args.approve:
        print("\nNot approved. A HUMAN must review the exact hash above, then run:")
        if prop.get("action") == C.GIFT_ACTION:
            print(f"  {C.giveaway_sign_command(prop['proposal_hash'])}")
            print(f"The vault releases {C.GIVEAWAY_SEED_ENV} only on that "
                  "genuine human approval.")
        else:
            print(f"  xrpl-sign --hash {prop['proposal_hash']} --approve")
            print("The vault releases the seed only on that genuine human approval.")
        return

    # --- the point of no return: independent human approval was given ---
    # Reserve budget, sign, and bind — with guaranteed reservation cleanup
    # on every failure path (see _reserve_sign_bind).
    signed, thash, last_ledger, auth_path = _reserve_sign_bind(
        prop, tx, policy, tracker, spends, args.seed_env, client)
    C.audit(prop.get("action", "?"), prop["proposal_hash"], thash,
            prop["network"], tx["Account"], "signed",
            f"last_ledger={last_ledger} auth={auth_path}", spends)
    net = "livenet" if prop["network"] == "mainnet" else "testnet"
    print(f"\nSigned {thash[:16]}… "
          f"(https://{net}.xrpl.org/transactions/{thash}) — submitting…")

    try:
        resp = submit_and_wait(signed, client, autofill=False)
    except Exception as e:  # noqa: BLE001
        # AMBIGUOUS: the tx may have reached the ledger before the network
        # failed. The reservation is deliberately NOT released — releasing
        # it could let a second tx exceed the daily cap while this one
        # later validates. sweep_pending() resolves it on the next run.
        C.audit(prop.get("action", "?"), prop["proposal_hash"], thash,
                prop["network"], tx["Account"], "submit_error",
                f"{str(e)[:200]} — reservation HELD pending reconciliation",
                spends)
        sys.exit(f"Submission error: {e} (signed tx persisted; spending "
                 f"reservation HELD until the ledger outcome is known)")

    res = resp.result
    meta = res.get("meta", {})
    tres = meta.get("TransactionResult", "?")
    validated = res.get("validated", False)
    print(f"validated: {validated}")
    print(f"result:    {tres}")

    ok = validated and tres == "tesSUCCESS"
    C.audit(prop.get("action", "?"), prop["proposal_hash"], thash,
            prop["network"], tx["Account"],
            "applied" if ok else f"failed:{tres}", "", spends)
    try:
        if ok:
            tracker.confirm(thash)
            path.unlink()  # proposal consumed
        else:
            tracker.release_tx(thash)
            sys.exit(f"Not applied: {tres}")
    except C.StateCorruptError as e:
        sys.exit(str(e))


def cmd_list(_args):
    if not C.PROPOSALS_DIR.exists():
        print("No proposals.")
        return
    for p in sorted(C.PROPOSALS_DIR.glob("*.json")):
        try:
            d = json.loads(p.read_text())
            age_m = (int(time.time()) - d["created_at"]) // 60
            print(f"{d['proposal_hash'][:16]}…  {d.get('action', '?'):10} "
                  f"{d.get('network', '?'):8} {age_m}m old")
        except (KeyError, json.JSONDecodeError):
            print(f"{p.stem[:16]}…  (unreadable proposal file)")


def main():
    ap = argparse.ArgumentParser(prog="xrpl-sign",
                                 description="Policy-gated XRPL signer.")
    ap.add_argument("--hash", default=None,
                    help="proposal hash (prefix ok for read-only review; "
                         "full 64-char hash required with --approve)")
    ap.add_argument("--approve", action="store_true",
                    help="HUMAN approval of this exact hash: sign & submit")
    ap.add_argument("--seed-env", default="XRPL_SEED",
                    help="env var holding the seed (default XRPL_SEED; "
                         "giveaway gifts use XRPL_GIVEAWAY_SEED)")
    ap.add_argument("--policy", default=None,
                    help="policy file (default ~/.xrpl/policy.json; giveaway "
                         "gifts use ~/.xrpl/giveaway_policy.json)")
    ap.add_argument("--list", action="store_true", help="pending proposals")
    ap.add_argument("cmd", nargs="?", choices=["init-policy", "migrate-policy"],
                    help="init-policy: write the default policy file | "
                         "migrate-policy: upgrade a policy to v4")
    args = ap.parse_args()
    if args.cmd == "init-policy":
        cmd_init_policy(args)
    elif args.cmd == "migrate-policy":
        cmd_migrate_policy(args)
    elif args.list:
        cmd_list(args)
    elif args.hash:
        cmd_sign(args)
    else:
        ap.print_help()


if __name__ == "__main__":
    main()
