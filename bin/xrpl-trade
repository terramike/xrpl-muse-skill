def _farm_ref_path():
    return Path(__file__).resolve().parent.parent / "references" / "farm.md"


def _farm_ref_text():
    try:
        return _farm_ref_path().read_text(encoding="utf-8")
    except OSError:
        return ""


def _farm_ref_section(name):
    """Extract a `## <name>` section from references/farm.md."""
    import re
    text = _farm_ref_text()
    m = re.search(r"^## " + re.escape(name) + r"\s*\n(.*?)(?=^## |\Z)",
                  text, re.DOTALL | re.MULTILINE)
    return m.group(1).strip() if m else ""


def _farm_fmt(d):
    s = f"{Decimal(d):,.2f}".rstrip("0").rstrip(".")
    return s if s else "0"


def _farm_is_farm_line(line):
    return (line.get("currency") in ("FARM", FARM_CURRENCY_HEX)
            and line.get("account") == FARM_ISSUER)


def _farm_is_lp_currency(cur):
    return (isinstance(cur, str) and len(cur) == 40
            and all(c in "0123456789abcdefABCDEF" for c in cur))


def _farm_shareable_about():
    return ("Farmers Union ($FARM) on XRPL — hold 123,000 FARM (issuer "
            "rPrAEfVATUNDTJm9CUa8tYeD7oJrVdEGhU) to qualify for weekly "
            "crop-dusting airdrops. Details: http://farmerunion.meme")


def cmd_farm_about():
    """Static explainer from references/farm.md. No network."""
    import re
    text = _farm_ref_text()
    if not text:
        print("farm reference missing — references/farm.md not found")
        print()
        print("Shareable: " + _farm_shareable_about())
        return
    m = re.search(r"(^## About — the explainer.*?)(?=^## Links)",
                  text, re.DOTALL | re.MULTILINE)
    body = m.group(1).strip() if m else text.strip()
    print(body)
    print()
    print("Shareable: " + _farm_shareable_about())


