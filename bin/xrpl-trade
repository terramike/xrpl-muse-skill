def nft_safety_lines(args, nft_id, ask_xrp):
    """Advisory xrpl.to NFT safety for a buy/bid proposal.

    Default-on; --no-safety skips. Fail-open: unreachable API -> loud
    UNAVAILABLE lines, never a block. A scam hit is printed LOUD but the
    human and the signer policy stay the gate.
    """
    if getattr(args, "no_safety", False) or xrpl_to is None:
        return []
    try:
        return xrpl_to.format_nft_safety_lines(nft_id, ask_xrp)
    except Exception:
        return ["  ⚠️  xrpl.to NFT safety check errored — treat as UNKNOWN, "
                "not clean."]


def cmd_buy(args, cfg, client):
    acct = need_account(cfg)
    base, bi, quote, qi = C.resolve_pair(args)
    amt = C.dec(args.amount, "amount"); price = C.dec(args.price, "price")
    cost = (amt * price).quantize(Decimal("0.000001"), rounding=ROUND_DOWN)
    tx = build_offer_tx(acct, base, bi, quote, qi, amt, price, "buy",
                        args.expires_in)
    propose(tx, client, cfg, "buy",
            [f"side:   BUY {amt} {base}",
             f"price:  {price} {quote} per {base}",
             f"max spend: {cost} {quote}",
             *safety_lines(args, base, bi, quote, qi)])


def cmd_sell(args, cfg, client):
    acct = need_account(cfg)
    base, bi, quote, qi = C.resolve_pair(args)
    amt = C.dec(args.amount, "amount"); price = C.dec(args.price, "price")
    proceeds = (amt * price).quantize(Decimal("0.000001"), rounding=ROUND_DOWN)
    tx = build_offer_tx(acct, base, bi, quote, qi, amt, price, "sell",
                        args.expires_in)
    propose(tx, client, cfg, "sell",
            [f"side:   SELL {amt} {base}",
             f"price:  {price} {quote} per {base}",
             f"min proceeds: {proceeds} {quote}",
             *safety_lines(args, base, bi, quote, qi)])


def cmd_trustline(args, cfg, client):
    acct = need_account(cfg)
    if getattr(args, "pair", None):
        base, bi, _, _ = C.resolve_pair(args)
        if base == "XRP":
            sys.exit("XRP needs no trustline.")
        currency, issuer = base, bi
    else:
        currency, issuer = args.currency.upper(), args.issuer
    if not issuer:
        sys.exit("issuer required (pass --issuer or use --pair)")
    limit = C.dec(args.limit, "limit")
    tx = TrustSet(account=acct,
                  limit_amount=iou_amount(currency, issuer, limit))
    propose(tx, client, cfg, "trustline",
            [f"token:  {currency}.{issuer}",
             f"limit:  {limit}"])


def cmd_cancel(args, cfg, client):
    acct = need_account(cfg)
    tx = OfferCancel(account=acct, offer_sequence=int(args.seq))
    propose(tx, client, cfg, "cancel", [f"offer seq: {args.seq}"])


def resolve_destination(to: str, cli_tag):
    """Return (classic_address, tag). Rejects conflicting X-address/CLI tags."""
    from xrpl.core.addresscodec import (
        is_valid_classic_address, is_valid_xaddress,
        xaddress_to_classic_address)
    tag = None
    if is_valid_xaddress(to):
        to, xtag, _ = xaddress_to_classic_address(to)
        tag = xtag
        if cli_tag is not None and xtag is not None and int(cli_tag) != int(xtag):
            sys.exit(f"destination tag conflict: X-address embeds tag {xtag} "
                     f"but --destination-tag {cli_tag} was given — refusing")
    elif not is_valid_classic_address(to):
        sys.exit("destination is not a valid classic address or X-address")
    if cli_tag is not None:
        tag = int(cli_tag)
    return to, tag


def cmd_send(args, cfg, client):
    acct = need_account(cfg)
    dest, tag = resolve_destination(args.to, args.destination_tag)
    amt = C.dec(args.amount, "amount")
    ccy = args.ccy.upper()
    amount = make_amount(ccy, args.issuer, amt)
    tx = Payment(account=acct, destination=dest, amount=amount,
                 destination_tag=tag)
    lines = [f"send:   {amt} {ccy}",
             f"to:     {dest}"]
    if tag is not None:
        lines.append(f"dest tag: {tag}")
    else:
        lines.append("dest tag: NONE — if the recipient is an exchange, "
                     "funds may not be credited. Use --destination-tag.")
    propose(tx, client, cfg, "send", lines)


# ---------- NFT mint: two-step pin flow (v0.6.0 item 5; P1-4 digest-bound) ----------
#
# Pinning is an external write (and an exfiltration vector), so it must
# never happen pre-consent inside a single command. Step 1 (nft-stage)
# is fully local: validate + hash the artwork, compute a STAGE DIGEST
# binding the file bytes, the mint metadata, the minting account and
# network, and the permitted media directory, then write a reviewable
# stage record - ZERO network calls. Step 2 (nft-pin-and-propose) is the
# explicitly-run, approval-gated step: it recomputes the digest from
# CURRENT state and refuses ANY mismatch before contacting Pinata, then
# uploads the EXACT bytes that were hashed (no file reopen - no TOCTOU).
# The human's --approve of the proposal hash approves THAT digest.
# PINATA_JWT is read from the environment only at pin time - never
# stored, logged, or written into proposal files.

STAGE_FORMAT = "nft-stage/3"

# The exact mint flags every staged NFT is minted with. Bound into the
# stage digest so a tampered stage record cannot change mint semantics.
NFT_MINT_FLAGS = (int(NFTokenMintFlag.TF_TRANSFERABLE)
                  | int(NFTokenMintFlag.TF_BURNABLE))


def _compute_stage_digest(file_sha256, name, description, royalty_bps,
                          taxon, mint_flags, account, network, source_path,
                          media_dir, issuer=None, attribution=True,
                          fields=None):
    """The stage digest: sha256 over canonical JSON binding the artwork
    bytes, the full mint metadata, the mint flags, and the account +
    network that will mint. Any change to any bound value — edited stage
    record, swapped file, different minter or network — produces a
    different digest, and the pin step refuses the mismatch.

    issuer/attribution/fields are part of the bound metadata: the
    collection issuer (None = self-issued), whether the XRPL-Muse
    attribution block is injected, and the extra template metadata
    fields. Omitting any of them from the digest would let a tampered
    stage record redirect the mint or silently drop the attribution."""
    payload = {
        "file_sha256": file_sha256,
        "name": name,
        "description": description,
        "royalty_bps": int(royalty_bps),
        "taxon": int(taxon),
        "mint_flags": int(mint_flags),
        "account": account,
        "network": network,
        "source_path": source_path,
        "media_dir": media_dir,
        "issuer": issuer or "",
        "attribution": bool(attribution),
        "fields": fields or {},
    }
    canonical = json.dumps(payload, sort_keys=True,
                           separators=(",", ":")).encode()
    return hashlib.sha256(canonical).hexdigest()


def _validate_stage_fields(fields):
    """Defensive validation of extra template metadata fields. Returns a
    problem string, or None when the dict is usable."""
    if fields is None:
        return None
    if not isinstance(fields, dict):
        return "metadata fields must be a dict"
    for label, value in fields.items():
        problem = C.validate_template_label(label)
        if problem:
            return problem
        if not isinstance(value, str) or not value.strip():
            return (f"metadata field {label!r} must be a non-empty string — "
                    "omit it to skip an optional field")
        if len(value) > 2000:
            return f"metadata field {label!r} exceeds 2000 characters"
    return None


def stage_artwork(file, name, description="", royalty_bps=1000, taxon=0,
                  account=None, network="testnet", *, issuer=None,
                  attribution=True, fields=None, collection=None,
                  media_dir=None):
    """Validate artwork and write a stage record. Zero network calls.

    Returns the stage record dict. The record carries a stage digest
    binding the file's bytes, the mint metadata, the minting account and
    network, and the permitted media directory — nft-pin-and-propose
    recomputes it from current state and refuses ANY mismatch before a
    byte leaves the machine. Raises SystemExit on any refusal.

    Artwork must live inside the protected NFT media directory
    (xrpl_pin.protected_media_dir()); anything outside is refused.
    media_dir overrides that default (tests); production callers leave
    it None.

    issuer: the collection issuer for the authorized-minter flow (None =
    self-issued; the NFTokenMint's Account is the minter). attribution:
    inject the "Minted with XRPL-Muse" block into the pinned metadata
    JSON (default True; --no-attribution opts out). fields: extra
    template metadata fields {label: value} merged into the pinned JSON.
    collection: the registry collection name, informational only (the
    issuer/taxon it resolved to are what the mint uses).
    """
    if xrpl_pin is None:
        sys.exit("xrpl_pin module missing - cannot stage.")
    if not account:
        sys.exit("an account is required to stage (the future minter)")
    if issuer is not None and not C.is_valid_classic_address(issuer):
        sys.exit("issuer is not a valid classic address "
                 "(base58 checksum failed)")
    royalty_bps = int(royalty_bps)
    if not 0 <= royalty_bps <= 5000:
        sys.exit("royalty must be 0..5000 bps (protocol max is 50%)")
    taxon = int(taxon)
    if not 0 <= taxon <= 0xFFFFFFFF:
        sys.exit("taxon must fit in a uint32")
    if not name or not str(name).strip():
        sys.exit("NFT name is required")
    problem = _validate_stage_fields(fields)
    if problem:
        sys.exit(problem)
    fields = dict(fields or {})
    mdir = media_dir or xrpl_pin.protected_media_dir()
    data, info = xrpl_pin.read_validated_source(file, media_dir=mdir)
    file_sha256 = hashlib.sha256(data).hexdigest()
    if file_sha256 != info["sha256"]:
        sys.exit("internal error: hash mismatch on validated bytes")
    digest = _compute_stage_digest(
        file_sha256, name, description, royalty_bps, taxon,
        NFT_MINT_FLAGS, account, network, info["path"], info["media_dir"],
        issuer=issuer, attribution=attribution, fields=fields)
    created = int(time.time())
    sid = hashlib.sha256(
        f"{info['sha256']}:{created}:{name}".encode()).hexdigest()[:16]
    metadata = {"name": name, "description": description, "image": None}
    metadata.update(fields)
    if attribution:
        metadata.update(C.NFT_METADATA_ATTRIBUTION)
    record = {
        "format": STAGE_FORMAT,
        "stage_id": sid,
        "created_at": created,
        "source_path": info["path"],
        "sha256": info["sha256"],
        "bytes": info["bytes"],
        "mime": info["mime"],
        "name": name,
        "description": description,
        # The exact metadata that will be pinned; the image CID is filled
        # in at pin time. The human reviews this record before approving.
        "metadata": metadata,
        "royalty_bps": royalty_bps,
        "taxon": taxon,
        # Collection issuer for the authorized-minter flow (None =
        # self-issued). Bound into the stage digest; the pin step passes
        # it as the NFTokenMint's Issuer field.
        "issuer": issuer,
        # Whether the XRPL-Muse attribution block is in the metadata.
        "attribution": bool(attribution),
        # Extra template metadata fields {label: value}, also in metadata.
        "fields": fields,
        # Informational only: the collection name these values resolved
        # from. The pin step uses issuer/taxon, never this field.
        "collection": collection,
        # The full stage digest. The pin step recomputes it from CURRENT
        # bytes + CURRENT record values + CURRENT account/network and
        # refuses any mismatch — the stage record is NOT trusted.
        "stage_digest": digest,
        "account": account,
        "network": network,
        # Informational only: the pin step re-resolves the protected
        # media dir itself and ignores this field.
        "media_dir": info["media_dir"],
    }
    C.STAGE_DIR.mkdir(parents=True, exist_ok=True)
    (C.STAGE_DIR / f"{sid}.json").write_text(json.dumps(record, indent=2))
    return record


def load_stage_record(stage_id):
    """Load and sanity-check a stage record. Refuses missing/ambiguous/
    corrupt records - a bad stage never reaches the pin step."""
    matches = (list(C.STAGE_DIR.glob(f"{stage_id}*.json"))
               if C.STAGE_DIR.exists() else [])
    if not matches:
        sys.exit(f"No staged artwork matching {stage_id!r} - run "
                 f"`xrpl-trade nft-stage` first.")
    if len(matches) > 1:
        sys.exit(f"Ambiguous stage id {stage_id!r}: "
                 f"{[m.stem[:12] for m in matches]}")
    try:
        rec = json.loads(matches[0].read_text())
    except (ValueError, OSError) as e:
        sys.exit(f"Stage record unreadable: {e}")
    if not isinstance(rec, dict) or rec.get("format") != STAGE_FORMAT:
        sys.exit("Stage record has an unsupported format - re-run nft-stage "
                 "(records staged before nft-stage/3 predate the "
                 "issuer/attribution digest binding and are not accepted).")
    for key in ("stage_id", "source_path", "sha256", "bytes", "mime",
                "name", "description", "metadata", "royalty_bps", "taxon",
                "issuer", "attribution", "fields", "collection",
                "stage_digest", "account", "network"):
        if key not in rec:
            sys.exit(f"Stage record is missing {key!r} - re-run nft-stage.")
    if (not isinstance(rec["stage_digest"], str)
            or len(rec["stage_digest"]) != 64
            or any(c not in "0123456789abcdef"
                   for c in rec["stage_digest"])):
        sys.exit("Stage record has a malformed stage digest - re-run "
                 "nft-stage.")
    if rec["issuer"] is not None and not isinstance(rec["issuer"], str):
        sys.exit("Stage record has a malformed issuer - re-run nft-stage.")
    if not isinstance(rec["attribution"], bool):
        sys.exit("Stage record has a malformed attribution flag - re-run "
                 "nft-stage.")
    if not isinstance(rec["fields"], dict):
        sys.exit("Stage record has malformed metadata fields - re-run "
                 "nft-stage.")
    # The pinned metadata must be EXACTLY the base keys plus the staged
    # template fields plus (iff attribution is on) the attribution block.
    # Anything else — a dropped attribution key, an injected field — is a
    # tampered record.
    meta = rec["metadata"]
    if not isinstance(meta, dict):
        sys.exit("Stage record metadata is inconsistent - re-run nft-stage.")
    base_ok = (meta.get("name") == rec["name"]
               and meta.get("description") == rec["description"]
               and meta.get("image") is None)
    extra = set(meta) - {"name", "description", "image"}
    expected_extra = set(rec["fields"])
    if rec["attribution"]:
        for k, v in C.NFT_METADATA_ATTRIBUTION.items():
            if meta.get(k) != v:
                sys.exit("Stage record attribution block is inconsistent - "
                         "re-run nft-stage.")
        expected_extra |= set(C.NFT_METADATA_ATTRIBUTION)
    elif any(k in meta for k in C.NFT_METADATA_ATTRIBUTION):
        sys.exit("Stage record attribution block is inconsistent - re-run "
                 "nft-stage.")
    fields_ok = (extra == expected_extra
                 and all(meta[k] == rec["fields"][k] for k in rec["fields"]))
    if not (base_ok and fields_ok):
        sys.exit("Stage record metadata is inconsistent - re-run nft-stage.")
    return rec


def pin_and_propose_stage(stage_id, cfg, client, pinner=None):
    """Pin the staged artwork + metadata, then propose the NFTokenMint.

    The approval-gated step: the human reviewed the stage record and ran
    this command deliberately. Before ANY byte leaves the machine, the
    stage digest is recomputed from the CURRENT file bytes, the CURRENT
    stage-record values, and the CURRENT account/network, and compared
    against the digest recorded at staging time. ANY mismatch — edited
    metadata, swapped file, changed path, different minter or network —
    refuses without contacting Pinata. The upload then sends the EXACT
    bytes that were hashed (no file reopen between hash and upload).

    Prints the full stage digest as part of the approval ceremony: the
    human's --approve of the proposal hash approves THAT digest.
    Returns the proposal hash.
    """
    if xrpl_pin is None:
        sys.exit("xrpl_pin module missing - cannot pin.")
    pinner = pinner or xrpl_pin
    rec = load_stage_record(stage_id)
    # The permitted media directory comes from protected configuration —
    # the stage record's media_dir field is informational only and is
    # NOT trusted here.
    mdir = xrpl_pin.protected_media_dir()
    # Read the artwork ONCE: these are the bytes we hash AND upload.
    data, info = pinner.read_validated_source(
        rec["source_path"], media_dir=mdir)
    file_sha256 = hashlib.sha256(data).hexdigest()
    if file_sha256 != rec["sha256"]:
        sys.exit("refusing: the artwork file changed since staging "
                 "(hash mismatch) - re-run `xrpl-trade nft-stage`.")
    acct = need_account(cfg)
    network = cfg.get("network", "testnet")
    # Recompute the digest from CURRENT state. The stage record is not
    # trusted: any edit to its metadata (or a swapped file, path, minter,
    # or network) fails this check before Pinata is contacted.
    recomputed = _compute_stage_digest(
        file_sha256, rec["name"], rec["description"],
        rec["royalty_bps"], rec["taxon"], NFT_MINT_FLAGS,
        acct, network, info["path"], info["media_dir"],
        issuer=rec["issuer"], attribution=rec["attribution"],
        fields=rec["fields"])
    if not hmac.compare_digest(recomputed, rec["stage_digest"]):
        sys.exit(
            "refusing: the stage digest does not match what was recorded "
            "at staging time.\n"
            "Something changed after staging: the stage record's metadata "
            "(name, description, royalty, taxon), the artwork file, its "
            "path, the minting account, or the network.\n"
            f"  staged digest:    {rec['stage_digest']}\n"
            f"  recomputed now:   {recomputed}\n"
            "Re-run `xrpl-trade nft-stage` and review the new record "
            "before approving. Pinata was NOT contacted.")
    name = rec["name"]
    issuer = rec.get("issuer")
    if issuer and issuer != acct:
        # Authorization could have been revoked between staging and
        # pinning — re-verify FAIL-CLOSED against the validated ledger
        # BEFORE any byte leaves the machine. A missing client means we
        # cannot verify: refuse rather than mint blind.
        if client is None:
            sys.exit("refusing: cannot re-verify authorized-minter status "
                     "without a network client — re-run `xrpl-trade "
                     "nft-pin-and-propose` normally.")
        problem = C.check_nft_mint_authorization(client, issuer, acct)
        if problem:
            sys.exit(problem + "\nThe collection issuer may have revoked "
                     "your NFTokenMinter authorization after staging.")
    print("pinning to IPFS via Pinata (external write):")
    print(f"  stage digest: {rec['stage_digest']}")
    print(f"    ^ the human approval below covers THIS digest. If it does")
    print(f"      not match the digest shown at staging time, STOP.")
    print(f"  file:      {C.safe_terminal_text(info['path'])}")
    print(f"  sha256:    {file_sha256}")
    print(f"  size/mime: {info['bytes']} bytes, {info['mime']}")
    print(f"  name:      {C.safe_terminal_text(name, 120)}")
    print(f"  account:   {acct}")
    if issuer and issuer != acct:
        print(f"  issuer:    {issuer} (you mint as authorized minter)")
    if rec.get("collection"):
        print(f"  collection:{rec['collection']}")
    if rec["attribution"]:
        print(f"  attribution: Minted with {C.MINTED_WITH_LABEL} "
              f"({C.MINTED_WITH_URL})")
    else:
        print("  attribution: omitted (--no-attribution)")
    print(f"  network:   {network}")
    # TOCTOU-safe: upload the exact bytes that were hashed above. The
    # file is never reopened between the hash check and the upload.
    image_cid = pinner.pin_data(data, os.path.basename(info["path"]))
    meta = dict(rec["metadata"])
    meta["image"] = f"ipfs://{image_cid}"
    metadata_cid = pinner.pin_json(meta, name=f"{name}-metadata.json")
    uri = f"ipfs://{metadata_cid}"
    uri_hex = uri.encode("utf-8").hex().upper()
    if len(uri.encode("utf-8")) > 256:
        sys.exit("metadata URI exceeds the 256-byte ledger limit")
    # XRPL TransferFee is in 1/100000 units: 10000 = 10% = 1000 bps.
    transfer_fee = int(rec["royalty_bps"]) * 10
    mint_kw = dict(account=acct,
                   nftoken_taxon=int(rec["taxon"]),
                   uri=uri_hex,
                   transfer_fee=transfer_fee,
                   flags=NFT_MINT_FLAGS)
    if issuer and issuer != acct:
        # Authorized-minter flow: Account signs, Issuer names the
        # collection issuer. The ledger enforces the authorization; the
        # CLI pre-checked it fail-closed before staging and re-checked
        # it above before pinning.
        mint_kw["issuer"] = issuer
    tx = NFTokenMint(**mint_kw)
    summary = [f"stage digest: {rec['stage_digest']}",
               "  ^ approving the proposal hash below approves the "
               "mint of EXACTLY this staged artwork + metadata",
               f"nft:      {C.safe_terminal_text(name, 120)}",
               f"image:    ipfs://{image_cid}",
               f"metadata: {uri}",
               f"royalty:  {int(rec['royalty_bps']) / 100:.2f}% "
               f"(immutable after mint - verify it)",
               f"flags:    transferable + burnable",
               f"taxon:    {rec['taxon']}"]
    if rec.get("collection"):
        summary.append(f"collection: {rec['collection']} "
                       f"(issuer {rec['issuer'] or acct}, "
                       f"taxon {rec['taxon']})")
    if issuer and issuer != acct:
        summary.append(f"issuer:   {issuer} "
                       "(you mint as its authorized minter)")
    if rec["fields"]:
        shown = ", ".join(f"{k}={C.safe_terminal_text(v, 40)}"
                          for k, v in rec["fields"].items())
        summary.append(f"fields:   {shown}")
    if rec["attribution"]:
        summary.append(f"attribution: Minted with {C.MINTED_WITH_LABEL} "
                       f"({C.MINTED_WITH_URL})")
    else:
        summary.append("attribution: omitted (--no-attribution)")
    summary.append("note:     the ledger stores the URI, not the art - "
                   "keep the IPFS pin alive")
    return propose(tx, client, cfg, "nft-mint", summary)


def _parse_meta_args(meta_args):
    """--meta KEY=VALUE (repeatable) -> {KEY: VALUE}. Refuses malformed
    entries, empty keys, and empty values (omit the flag to skip an
    optional field)."""
    fields = {}
    for item in meta_args or []:
        if "=" not in item:
            sys.exit(f"--meta {item!r} must be KEY=VALUE")
        key, value = item.split("=", 1)
        key, value = key.strip(), value.strip()
        if not key:
            sys.exit(f"--meta {item!r} has an empty key")
        if not value:
            sys.exit(f"--meta {key!r} has an empty value — omit the flag "
                     "to skip an optional field")
        if key in fields:
            sys.exit(f"--meta {key!r} given twice")
        fields[key] = value
    return fields


def cmd_nft_stage(args, cfg, client):
    """Step 1: validate + hash artwork locally, write a stage record."""
    acct = need_account(cfg)
    network = cfg.get("network", "testnet")
    # 1. Collection resolution: --collection <name> pulls issuer, taxon,
    #    and the default royalty from the local registry.
    coll_name, coll = None, None
    if args.collection:
        try:
            colls = C.load_collections()
        except C.RegistryError as e:
            sys.exit(str(e))
        coll = colls.get(args.collection)
        if coll is None:
            sys.exit(f"unknown collection {args.collection!r} — see "
                     "`xrpl-trade collection list`")
        coll_name = args.collection
    # 2. Taxon: explicit --taxon wins, else the collection's, else 0.
    #    Both at once is ambiguous — refuse rather than guess.
    if args.taxon is not None and coll_name:
        sys.exit("use one of --collection or --taxon, not both")
    taxon = args.taxon if args.taxon is not None else (
        coll["taxon"] if coll else 0)
    # 3. Issuer: explicit --issuer, else the collection's. When set and
    #    different from the minter, this is the authorized-minter flow —
    #    verify it FAIL-CLOSED against the validated ledger BEFORE
    #    staging (a tampered registry can never pass this check).
    issuer = args.issuer or (coll["issuer"] if coll else None) or None
    if issuer:
        if not C.is_valid_classic_address(issuer):
            sys.exit("issuer is not a valid classic address "
                     "(base58 checksum failed)")
        if coll and args.issuer and args.issuer != coll["issuer"]:
            sys.exit("--issuer does not match the collection's registered "
                     "issuer — refusing")
        if issuer == acct:
            # Self-issued: mint normally with no Issuer field on the
            # transaction (the minter IS the issuer).
            issuer = None
        else:
            problem = C.check_nft_mint_authorization(client, issuer, acct)
            if problem:
                sys.exit(problem)
    # 4. Royalty: explicit --royalty-bps wins, else the collection's
    #    default, else 1000 (10%).
    royalty = args.royalty_bps
    if royalty is None:
        royalty = (coll.get("royalty_bps")
                   if coll and coll.get("royalty_bps") is not None else 1000)
    # 5. Template fields: --template <name> validates --meta against the
    #    template (unknown keys and missing required fields are refused);
    #    without a template, --meta is ad-hoc (labels still validated).
    meta_fields = _parse_meta_args(args.meta)
    if args.template:
        try:
            tmpls = C.load_templates()
        except C.RegistryError as e:
            sys.exit(str(e))
        tmpl = tmpls.get(args.template)
        if tmpl is None:
            sys.exit(f"unknown template {args.template!r} — see "
                     "`xrpl-trade template list`")
        known = {f["label"] for f in tmpl["fields"]}
        for key in meta_fields:
            if key not in known:
                sys.exit(f"--meta {key!r} is not a field of template "
                         f"{args.template!r}")
        missing = [f["label"] for f in tmpl["fields"]
                   if f["required"] and f["label"] not in meta_fields]
        if missing:
            sys.exit(f"template {args.template!r} requires: "
                     f"{', '.join(missing)}")
    else:
        for key in meta_fields:
            problem = C.validate_template_label(key)
            if problem:
                sys.exit(problem)
    rec = stage_artwork(args.file, args.name, args.description or "",
                        royalty, taxon,
                        account=acct, network=network,
                        issuer=issuer,
                        attribution=not args.no_attribution,
                        fields=meta_fields or None,
                        collection=coll_name)
    print("STAGED - nothing has left this machine (zero network calls).")
    print(f"  stage id: {rec['stage_id']}")
    print(f"  stage digest: {rec['stage_digest'][:16]}... "
          f"(full digest is bound into the pin approval)")
    print(f"  file:     {C.safe_terminal_text(rec['source_path'])}")
    print(f"  sha256:   {rec['sha256']}")
    print(f"  size:     {rec['bytes']} bytes ({rec['mime']})")
    print(f"  name:     {C.safe_terminal_text(rec['name'], 120)}")
    print(f"  account:  {rec['account']} (the minter)")
    if issuer:
        print(f"  issuer:   {issuer} (collection issuer — you mint as "
              f"its authorized minter)")
    if coll_name:
        print(f"  collection: {coll_name} (taxon {rec['taxon']})")
    if args.template:
        print(f"  template: {args.template}")
    if meta_fields:
        for k, v in meta_fields.items():
            print(f"    field:  {k} = {C.safe_terminal_text(v, 80)}")
    if rec["attribution"]:
        print(f"  attribution: Minted with {C.MINTED_WITH_LABEL} "
              f"({C.MINTED_WITH_URL})")
    else:
        print("  attribution: omitted (--no-attribution)")
    print(f"  network:  {rec['network']}")
    print(f"  royalty:  {rec['royalty_bps'] / 100:.2f}% "
          f"(immutable after mint - verify it)")
    print(f"  taxon:    {rec['taxon']}")
    print(f"\nReview the above, then run:")
    print(f"  xrpl-trade nft-pin-and-propose --stage {rec['stage_id']}")
    print("That step re-verifies the digest, pins to IPFS (external "
          "write), and proposes the mint.")


def cmd_nft_pin_and_propose(args, cfg, client):
    """Step 2: pin the staged artwork + metadata, propose the mint."""
    pin_and_propose_stage(args.stage, cfg, client)


def cmd_nft_list(args, cfg, client):
    """PROPOSE an NFTokenCreateOffer SELL offer for an owned NFT.
    v1: XRP-denominated only, Expiration always required."""
    acct = need_account(cfg)
    nid = args.token_id.strip()
    if len(nid) != 64 or any(c not in "0123456789abcdefABCDEF" for c in nid):
        sys.exit("token id must be 64 hex characters")
    price = C.dec(args.price_xrp, "price")
    dest = args.destination
    if dest is not None and not C.is_valid_classic_address(dest):
        sys.exit("destination is not a valid classic address "
                 "(base58 checksum failed)")
    tx = NFTokenCreateOffer(
        account=acct,
        nftoken_id=nid.upper(),
        amount=xrp_to_drops(price),
        expiration=C.ripple_time_from_now(args.expires_in),
        destination=dest,
        flags=int(NFTokenCreateOfferFlag.TF_SELL_NFTOKEN),
    )
    lines = [f"token:    {nid.upper()}",
             f"price:    {price} XRP (SELL offer)"]
    if dest:
        lines.append(f"buyer:    {dest} (PRIVATE — only they can accept)")
    else:
        lines.append("buyer:    anyone (public listing)")
    propose(tx, client, cfg, "nft-list", lines)


def provisional_spend_check(spends):
    """Best-effort proposal-time spend-limit check. The signer always
    re-enforces these — this just refuses doomed proposals early, and
    makes the reservation math visible before approval."""
    pol_path = C.POLICY_PATH
    if not pol_path.exists():
        print("  note: no policy file — spend limits enforced by xrpl-sign")
        return
    try:
        raw = json.loads(pol_path.read_text())
    except json.JSONDecodeError:
        print("  note: unreadable policy file — spend limits enforced by "
              "xrpl-sign")
        return
    if raw.get("policy_version") != C.POLICY_VERSION:
        print("  note: policy version mismatch — spend limits enforced by "
              "xrpl-sign")
        return
    # Best-effort: never do limit math on a schema-violating policy.
    # The signer hard-refuses via load_policy — say so now, cleanly.
    try:
        C.validate_policy(raw)
    except C.PolicyError as e:
        print("  note: policy file fails schema validation — spend limits "
              "enforced by xrpl-sign")
        return
    pol = {**C.DEFAULT_POLICY, **raw}
    try:
        denials = C.SpentTracker().check(spends, pol)
    except C.SpentTracker.StateError as e:
        # Fail closed at proposal time too: never propose against unknown
        # limits. The signer would refuse anyway; say so now, cleanly.
        sys.exit(str(e))
    if denials:
        print("  pre-check: this purchase would breach spend limits:")
        for d in denials:
            print(f"    ✗ {d}")
        sys.exit("nft-buy refused by spend limits (xrpl-sign would deny it)")


def cmd_nft_inventory(args, cfg, client):
    """Read-only: list every NFToken owned by an account (marker-paged,
    so large collections are fully enumerated). The address argument
    also accepts a favorite name — writes never do."""
    arg = args.address
    if arg:
        try:
            favs = C.load_favorites()
        except C.FavoritesError as e:
            sys.exit(str(e))
        addr, problem = C.resolve_fav_or_addr(arg, favs)
        if problem:
            sys.exit(problem)
    else:
        addr = cfg.get("address")
    if not addr:
        sys.exit("No address. Pass one, a favorite name, "
                 "or run `xrpl-trade setup`.")
    nfts = []
    marker = None
    while True:
        r = client.request(AccountNFTs(account=addr, limit=400,
                                       marker=marker))
        if not r.is_successful():
            sys.exit(f"account_nfts failed: {r.result}")
        nfts.extend((r.result or {}).get("account_nfts", []))
        marker = (r.result or {}).get("marker")
        if not marker:
            break
    if not nfts:
        print(f"No NFTs owned by {addr} [{cfg['network']}]")
        return
    print(f"{len(nfts)} NFT(s) owned by {addr} [{cfg['network']}]")
    for n in nfts:
        uri_txt = C.decode_nft_uri(n.get("URI", ""), 90)
        flags = int(n.get("Flags", 0) or 0)
        names = [C.NFT_MINT_FLAG_NAMES[b]
                 for b in sorted(C.NFT_MINT_FLAG_NAMES) if flags & b]
        print(f"  {n.get('NFTokenID')}")
        print(f"    uri:   {uri_txt}")
        print(f"    taxon: {n.get('NFTokenTaxon')}  "
              f"flags: {', '.join(names) or 'none'}")
        issuer = n.get("Issuer")
        if issuer:
            print(f"    issuer: {issuer}")


def cmd_nft_buy(args, cfg, client):
    """Verify an NFT sell offer from the ledger, then PROPOSE accepting
    it. The on-ledger verification (seller, issuer, token URI, taxon,
    price) is printed BEFORE the proposal so the human reviews facts —
    never trust the picture. The signer re-verifies before signing."""
    acct = need_account(cfg)
    idx = args.offer_index.strip()
    lines, denials, amount = C.nft_sell_offer_report(client, idx)
    print("=" * 60)
    print("SELL-OFFER VERIFICATION — read from the ledger just now.")
    print("Verify the ISSUER is the artist you expect: anyone can mint")
    print("the same artwork. The seller is only the current owner; the")
    print("issuer is the minter. This skill reports on-ledger facts; it")
    print("does NOT authenticate art.")
    print("=" * 60)
    for ln in lines:
        print("  " + ln)
    print("=" * 60)
    if denials:
        for d in denials:
            print(f"  ✗ {d}")
        sys.exit("nft-buy refused: " + "; ".join(denials))
    provisional_spend_check({"XRP": amount})
    # Safety needs the NFTokenID: one extra ledger read, fail-open — the
    # offer report above already verified the trade facts.
    nft_id = None
    try:
        _entry, _problem = C.fetch_nft_offer_entry(client, idx)
        if _entry:
            nft_id = _entry.get("NFTokenID")
    except Exception:
        nft_id = None
    tx = NFTokenAcceptOffer(account=acct, nftoken_sell_offer=idx.upper())
    propose(tx, client, cfg, "nft-buy",
            ["buy:      accept the sell offer above",
             f"max spend: {amount} XRP (+ fee)",
             "note:     the signer re-verifies the offer from the ledger",
             "          before signing — a cancelled/changed offer is denied",
             *nft_safety_lines(args, nft_id, amount)])


def cmd_nft_bid(args, cfg, client):
    """PROPOSE a buy-side NFTokenCreateOffer (a bid) on someone else's
    NFT. v1: XRP-denominated only, Expiration always required. The bid
    XRP is locked in the offer until it is accepted, cancelled, or
    expires — the signer counts it toward spend limits."""
    acct = need_account(cfg)
    nid = args.token_id.strip()
    if len(nid) != 64 or any(c not in "0123456789abcdefABCDEF" for c in nid):
        sys.exit("token id must be 64 hex characters")
    seller = args.seller
    if not C.is_valid_classic_address(seller):
        sys.exit("seller is not a valid classic address "
                 "(base58 checksum failed)")
    if seller == acct:
        sys.exit("seller is your own account — use nft-list to sell your own "
                 "NFT")
    price = C.dec(args.price_xrp, "price")
    tx = NFTokenCreateOffer(
        account=acct,
        nftoken_id=nid.upper(),
        amount=xrp_to_drops(price),
        owner=seller,
        expiration=C.ripple_time_from_now(args.expires_in),
    )
    propose(tx, client, cfg, "nft-bid",
            [f"token:    {nid.upper()}",
             f"bid:      {price} XRP (BUY offer — locked until accepted, "
             "cancelled, or expired)",
             f"seller:   {seller} (only they can accept)",
             "note:     policy must enable nft.allow_buy_offers for this to "
             "sign",
             *nft_safety_lines(args, nid.upper(), price)])


def cmd_nft_send(args, cfg, client):
    """PROPOSE a 0-XRP NFTokenCreateOffer transfer (a gift) of an owned
    NFT to a favorite name or classic address. --to resolves against the
    local favorites file first (case-insensitive), then as a classic
    address — anything else is refused. The offer carries a 0-drops
    Amount and a Destination: it is a TRANSFER, never a sale. The
    recipient must accept it before it expires; nothing moves until
    they do. Expiration always required."""
    acct = need_account(cfg)
    nid = args.token_id.strip()
    if len(nid) != 64 or any(c not in "0123456789abcdefABCDEF" for c in nid):
        sys.exit("token id must be 64 hex characters")
    try:
        favs = C.load_favorites()
    except C.FavoritesError as e:
        sys.exit(str(e))
    token = args.to
    key = token.lower() if isinstance(token, str) else token
    fav_name = None
    if isinstance(key, str) and key in favs and isinstance(favs[key], dict):
        dest = favs[key].get("address")
        if not C.is_valid_classic_address(dest):
            sys.exit(f"favorite {key!r} has an invalid address — fix it "
                     "with `favorites remove` / `favorites add`")
        fav_name = key
    elif C.is_valid_classic_address(token):
        dest = token
    else:
        sys.exit(f"{token!r} is neither a favorite name nor a valid classic "
                 "address (base58 checksum failed)")
    if dest == acct:
        sys.exit("destination is your own account — a transfer offer to "
                 "yourself is pointless")
    tx = NFTokenCreateOffer(
        account=acct,
        nftoken_id=nid.upper(),
        amount="0",  # 0 drops: gift transfer, NOT a sale
        destination=dest,
        expiration=C.ripple_time_from_now(args.expires_in),
        flags=int(NFTokenCreateOfferFlag.TF_SELL_NFTOKEN),
    )
    lines = [f"token:    {nid.upper()}",
             "action:   TRANSFER (gift — 0 XRP, NOT a sale)",
             f"to:       {dest}"]
    if fav_name:
        lines.append(f"favorite: {fav_name}")
    lines.append("note:     the recipient must accept the offer before it "
                 "expires — nothing moves until they do")
    propose(tx, client, cfg, "nft-send", lines)


def _add_favorite_entry(name, address, kind, note, label, verb="favorite"):
    """Shared add path for `favorites add` and `watch add`.

    kind is artist/friend/watch. Addresses only: the classic-address
    base58 checksum rejects seeds (different version byte), so a seed
    can never be stored here.
    """
    if kind not in ("artist", "friend", "watch"):
        sys.exit("--kind must be artist, friend, or watch")
    problem = C.validate_favorite_name(name)
    if problem:
        sys.exit(problem)
    try:
        favs = C.load_favorites()
    except C.FavoritesError as e:
        sys.exit(str(e))
    if name in favs:
        sys.exit(f"{verb} {name!r} already exists "
                 f"({favs[name].get('address')}) — "
                 "remove it first to re-add")
    if not C.is_valid_classic_address(address):
        sys.exit("address is not a valid classic address (base58 checksum "
                 "failed) — only r-addresses are stored here, never seeds")
    entry = {"address": address,
             "added_at": int(time.time()),
             "last_checked_ledger": None,
             "kind": kind}
    if note:
        entry["note"] = note
    if label:
        lproblem = C.validate_favorite_label(label)
        if lproblem:
            sys.exit(lproblem)
        entry["label"] = label
    favs[name] = entry
    C.save_favorites(favs)
    shown = f" ({label})" if label else ""
    print(f"{verb} {name!r}{shown} → {address} [{kind}]")


def cmd_favorites(args):
    """Local named watchlist: artist wallets AND people you know.

    Entirely local: no network, no proposals, no signing. Names are
    lowercase [a-z0-9_-], 1-32 chars; addresses get the real
    base58-checksum validation. kind=artist wallets are scanned by
    nft-new; kind=friend entries are just labels (never scanned);
    kind=watch wallets are swept by `watch check` and
    `incoming --all-watched`. Labels are plain characters only — no emoji
    or stylized unicode — and are your own local notes, never identity
    proof.
    """
    try:
        favs = C.load_favorites()
    except C.FavoritesError as e:
        sys.exit(str(e))
    cmd = args.fav_cmd
    if cmd == "add":
        _add_favorite_entry(args.name, args.address,
                            getattr(args, "kind", None) or "artist",
                            getattr(args, "note", None),
                            getattr(args, "label", None))
    elif cmd == "remove":
        if args.name not in favs:
            sys.exit(f"no favorite named {args.name!r}")
        del favs[args.name]
        C.save_favorites(favs)
        print(f"removed favorite {args.name!r}")
    elif cmd == "rename":
        if args.old not in favs:
            sys.exit(f"no favorite named {args.old!r}")
        problem = C.validate_favorite_name(args.new)
        if problem:
            sys.exit(problem)
        if args.new in favs:
            sys.exit(f"favorite {args.new!r} already exists")
        favs[args.new] = favs.pop(args.old)
        C.save_favorites(favs)
        print(f"renamed {args.old!r} → {args.new!r}")
    elif cmd == "list":
        if not favs:
            print("no favorites yet — add one with: "
                  "xrpl-trade favorites add <name> <r-address>")
            return
        for name in sorted(favs):
            f = favs[name]
            added = time.strftime("%Y-%m-%d",
                                  time.gmtime(f.get("added_at", 0)))
            kind = f.get("kind", "artist")
            label = f"  [{f['label']}]" if f.get("label") else ""
            note = f"  ({C.safe_terminal_text(f['note'], 120)})" \
                if f.get("note") else ""
            print(f"  {name}{label} → {f.get('address')}  [{kind}]  "
                  f"added {added}{note}")
    else:  # pragma: no cover — argparse restricts choices
        sys.exit(f"unknown favorites command {cmd!r}")


# ---------- read-only wallet watchlist (incoming-NFT-offer reminders) ----------

def _watched_wallets():
    """{name: entry} for favorites with kind='watch'. Exits on corrupt store."""
    try:
        favs = C.load_favorites()
    except C.FavoritesError as e:
        sys.exit(str(e))
    return {n: f for n, f in favs.items() if f.get("kind") == "watch"}


def _load_watch_seen():
    """Watermark: {address: [offer indices]}. Missing/corrupt → {}."""
    try:
        data = json.loads(C.WATCH_SEEN_PATH.read_text())
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def _save_watch_seen(seen):
    p = C.WATCH_SEEN_PATH
    p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_name(p.name + ".tmp")
    tmp.write_text(json.dumps(seen, indent=2, sort_keys=True) + "\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, p)


def cmd_watch(args):
    """Read-only wallet watchlist for incoming-NFT-offer reminders.

    Wallets are stored as kind='watch' favorites — addresses only (the
    classic-address checksum rejects seeds, so a seed can never land
    here). `watch check` sweeps every watched wallet's OPEN NFT offers via
    xrpl.to, diffs offer indices against a local watermark, and prints only
    NEW offers. The first run per wallet seeds the baseline silently. The
    7-day ledger receipt scan is deliberately NOT part of the sweep — open
    offers are the live signal; history is one `incoming` away. Nothing
    here proposes, signs, or submits.
    """
    cmd = args.watch_cmd
    if cmd == "add":
        _add_favorite_entry(args.name, args.address, "watch",
                            getattr(args, "note", None),
                            getattr(args, "label", None),
                            verb="watched wallet")
    elif cmd == "list":
        watched = _watched_wallets()
        if not watched:
            print("no watched wallets — add one with: "
                  "xrpl-trade watch add <name> <r-address>")
            return
        for name in sorted(watched):
            f = watched[name]
            added = time.strftime("%Y-%m-%d",
                                  time.gmtime(f.get("added_at", 0)))
            label = f"  [{f['label']}]" if f.get("label") else ""
            note = f"  ({C.safe_terminal_text(f['note'], 120)})" \
                if f.get("note") else ""
            print(f"  {name}{label} → {f.get('address')}  "
                  f"added {added}{note}")
    elif cmd == "remove":
        try:
            favs = C.load_favorites()
        except C.FavoritesError as e:
            sys.exit(str(e))
        if args.name not in favs or favs[args.name].get("kind") != "watch":
            sys.exit(f"no watched wallet named {args.name!r} "
                     "(use `favorites remove` for other kinds)")
        del favs[args.name]
        C.save_favorites(favs)
        print(f"stopped watching {args.name!r}")
    elif cmd == "check":
        _cmd_watch_check()
    else:  # pragma: no cover — argparse restricts choices
        sys.exit(f"unknown watch command {cmd!r}")


def _cmd_watch_check():
    watched = _watched_wallets()
    if not watched:
        print("no watched wallets — add one with: "
              "xrpl-trade watch add <name> <r-address>")
        return
    if xrpl_to is None:
        print("watch check unavailable: xrpl_to module not loaded")
        return
    seen = _load_watch_seen()
    lines = []
    for name in sorted(watched):
        addr = watched[name]["address"]
        label = watched[name].get("label")
        who = f"{label} ({name})" if label else name
        rows, ok = xrpl_to.incoming_offers_report(addr, limit=50)
        if not ok:
            lines.append(f"  {who}: offers API unavailable — skipped, "
                         "watermark untouched")
            continue
        current = {r["index"] for r in rows if r.get("index")}
        if addr not in seen:
            lines.append(f"  {who}: baseline set "
                         f"({len(current)} existing offer(s) recorded — "
                         "future runs alert on new ones)")
        else:
            prev = set(seen.get(addr) or ())
            fresh = [r for r in rows if r.get("index") not in prev]
            if fresh:
                lines.append(f"  NEW offers for {who} [{addr}]:")
                for r in fresh:
                    flag = ""
                    if r.get("fraud") or r.get("owner_is_scam"):
                        flag = ("  [FLAGGED: "
                                f"{r.get('fraud_type') or 'scam screen'}]")
                    cp = r.get("counterparty") or "?"
                    nid = str(r.get("nft_id") or "?")
                    nid_s = f"{nid[:8]}…{nid[-4:]}" if len(nid) > 14 else nid
                    lines.append(
                        f"    {r['side']:3}  {r['amount_s']:>14}  "
                        f"from {cp[:10]}…  nft {nid_s}{flag}")
                lines.append("    full safety view: "
                             f"xrpl-trade incoming --watch {name}")
        seen[addr] = sorted(current)
    _save_watch_seen(seen)
    print("\n".join(lines))


def cmd_collection(args, cfg, client):
    """Local NFT collection registry: name -> {issuer, taxon, ...}.

    A collection is the pair issuer + NFTokenTaxon — XRPL has no
    on-ledger collection object, and taxon alone is not unique across
    issuers. create/remove are LOCAL ONLY (no ledger transaction): the
    collection exists on-ledger only once you mint into it with
    `nft-stage --collection <name>`. inspect is read-only.

    Registry writes follow the policy.json rule: the assistant shows the
    exact diff and gets an explicit human yes before invoking
    create/remove — a tampered entry could otherwise point a collection
    name at someone else's issuer. The mint-time issuer /
    authorized-minter check is the backstop regardless.
    """
    try:
        colls = C.load_collections()
    except C.RegistryError as e:
        sys.exit(str(e))
    cmd = args.coll_cmd
    if cmd == "create":
        problem = C.validate_registry_name(args.name, "collection")
        if problem:
            sys.exit(problem)
        if args.name in colls:
            sys.exit(f"collection {args.name!r} already exists — remove "
                     "it first to re-register")
        taxon, problem = C.validate_taxon(args.taxon)
        if problem:
            sys.exit(problem)
        issuer = args.issuer or (cfg.get("address") if cfg else None)
        if not issuer:
            sys.exit("no issuer: pass --issuer or run `xrpl-trade setup` "
                     "first")
        if not C.is_valid_classic_address(issuer):
            sys.exit("issuer is not a valid classic address "
                     "(base58 checksum failed)")
        royalty_bps = None
        if args.royalty_bps is not None:
            try:
                royalty_bps = int(args.royalty_bps)
            except (TypeError, ValueError):
                sys.exit("--royalty-bps must be an integer 0..5000")
            if not 0 <= royalty_bps <= 5000:
                sys.exit("--royalty-bps must be 0..5000 bps "
                         "(protocol max is 50%)")
        description = (args.description or "").strip()
        if len(description) > 500:
            sys.exit("--description exceeds 500 characters")
        colls[args.name] = {"issuer": issuer,
                            "taxon": taxon,
                            "description": description,
                            "royalty_bps": royalty_bps,
                            "created_at": int(time.time())}
        C.save_collections(colls)
        network = cfg.get("network", "?") if cfg else "?"
        C.audit("collection_create", None, None, network, issuer,
                "registered",
                note=f"name={args.name} taxon={taxon}")
        print(f"collection {args.name!r} registered LOCALLY — no ledger "
              "transaction was made.")
        print(f"  issuer:  {issuer}")
        print(f"  taxon:   {taxon}")
        if royalty_bps is not None:
            print(f"  royalty: {royalty_bps / 100:.2f}% default for mints "
                  "in this collection")
        if description:
            print(f"  note:    {C.safe_terminal_text(description, 120)}")
        print("It exists on-ledger only once you mint into it:")
        print(f"  xrpl-trade nft-stage --collection {args.name} --file "
              "<art> --name <name>")
    elif cmd == "list":
        if not colls:
            print("no collections yet — register one with: "
                  "xrpl-trade collection create --name <name> --taxon <n>")
            return
        for name in sorted(colls):
            c = colls[name]
            roy = (f", royalty {c['royalty_bps'] / 100:.2f}%"
                   if c.get("royalty_bps") is not None else "")
            desc = (f" — {C.safe_terminal_text(c['description'], 60)}"
                    if c.get("description") else "")
            print(f"  {name}: issuer {C.short_addr(c['issuer'])}, "
                  f"taxon {c['taxon']}{roy}{desc}")
    elif cmd == "inspect":
        c = colls.get(args.name)
        if c is None:
            sys.exit(f"unknown collection {args.name!r} — see "
                     "`xrpl-trade collection list`")
        issuer, taxon = c["issuer"], c["taxon"]
        print(f"collection {args.name!r} (read-only):")
        print(f"  issuer: {issuer}")
        print(f"  taxon:  {taxon}")
        if c.get("description"):
            print(f"  note:   {C.safe_terminal_text(c['description'], 120)}")
        count, recent, problem = C.count_collection_tokens(
            client, issuer, taxon)
        if problem:
            sys.exit(problem)
        print(f"  on-ledger tokens in this collection: {count}")
        for nid in recent:
            print(f"    • {nid}")
            print(f"      {C.XRP_CAFE_NFT_URL.format(nid)}")
    elif cmd == "remove":
        if args.name not in colls:
            sys.exit(f"no collection named {args.name!r}")
        del colls[args.name]
        C.save_collections(colls)
        network = cfg.get("network", "?") if cfg else "?"
        C.audit("collection_remove", None, None, network, "?", "removed",
                note=f"name={args.name}")
        print(f"removed collection {args.name!r} (local registry only — "
              "nothing on-ledger was touched)")
    else:  # pragma: no cover — argparse restricts choices
        sys.exit(f"unknown collection command {cmd!r}")


def _template_fields_interactive():
    """Prompt for template fields until a blank label. Returns
    ([(label, required)], cancelled)."""
    fields = []
    seen = set()
    while True:
        try:
            label = input("  field label (blank to finish): ").strip()
        except EOFError:
            return None, True
        if not label:
            break
        if label.lower() == "quit":
            return None, True
        problem = C.validate_template_label(label)
        if problem:
            print(f"  ✗ {problem}")
            continue
        if label in seen or label.lower() in {s.lower() for s in seen}:
            print(f"  ✗ duplicate field label {label!r}")
            continue
        try:
            req = input("  required? [y/N]: ").strip().lower()
        except EOFError:
            return None, True
        fields.append((label, req in ("y", "yes")))
        seen.add(label)
    return fields, False


def cmd_template(args, cfg, client):
    """Local NFT metadata templates: name -> {fields: [{label,
    required}]}. String fields only (v1). Templates are NOT bound to a
    collection — one template is reused across collections; the
    collection is picked fresh at each mint.

    Template writes follow the policy.json rule: the assistant shows the
    exact diff and gets an explicit human yes before invoking create/
    remove. A template can never change where funds or NFTs go — only
    metadata labels.
    """
    try:
        tmpls = C.load_templates()
    except C.RegistryError as e:
        sys.exit(str(e))
    cmd = args.tmpl_cmd
    if cmd == "create":
        name = args.name
        fields = []
        if name is None or not args.field:
            # Interactive: missing name and/or fields.
            if name is None:
                try:
                    name = input("template name: ").strip()
                except EOFError:
                    sys.exit("\ncancelled — nothing was saved.")
            problem = C.validate_registry_name(name, "template")
            if problem:
                sys.exit(problem)
            if name in tmpls:
                sys.exit(f"template {name!r} already exists — remove it "
                         "first to re-create")
            if not args.field:
                print("define the metadata fields (labels only, v1 "
                      "strings):")
                got, cancelled = _template_fields_interactive()
                if cancelled:
                    sys.exit("\ncancelled — nothing was saved.")
                fields = got
        else:
            problem = C.validate_registry_name(name, "template")
            if problem:
                sys.exit(problem)
            if name in tmpls:
                sys.exit(f"template {name!r} already exists — remove it "
                         "first to re-create")
        for spec in args.field or []:
            label, required, problem = C.parse_template_field(spec)
            if problem:
                sys.exit(f"--field {spec!r}: {problem}")
            if label in [f[0] for f in fields] or label.lower() in \
                    [f[0].lower() for f in fields]:
                sys.exit(f"--field {spec!r}: duplicate label {label!r}")
            fields.append((label, required))
        if not fields:
            sys.exit("a template needs at least one field — nothing was "
                     "saved")
        tmpls[name] = {"fields": [{"label": l, "required": r}
                                  for l, r in fields],
                       "created_at": int(time.time())}
        C.save_templates(tmpls)
        network = cfg.get("network", "?") if cfg else "?"
        C.audit("template_create", None, None, network,
                cfg.get("address", "?") if cfg else "?", "saved",
                note=f"name={name} fields={len(fields)}")
        req = sum(1 for _, r in fields if r)
        print(f"template {name!r} saved ({len(fields)} fields, "
              f"{req} required):")
        for label, required in fields:
            print(f"  • {label}" + ("  (required)" if required else ""))
        print("Use it at mint time:")
        print(f"  xrpl-trade nft-stage --template {name} --meta "
              "<label>=<value> … --file <art> --name <nft-name>")
    elif cmd == "list":
        if not tmpls:
            print("no templates yet — create one with: "
                  "xrpl-trade template create")
            return
        for name in sorted(tmpls):
            t = tmpls[name]
            req = sum(1 for f in t["fields"] if f["required"])
            print(f"  {name}: {len(t['fields'])} fields ({req} required)")
    elif cmd == "show":
        t = tmpls.get(args.name)
        if t is None:
            sys.exit(f"unknown template {args.name!r} — see "
                     "`xrpl-trade template list`")
        print(f"template {args.name!r}:")
        for f in t["fields"]:
            print(f"  • {f['label']}" +
                  ("  (required)" if f["required"] else ""))
    elif cmd == "remove":
        if args.name not in tmpls:
            sys.exit(f"no template named {args.name!r}")
        del tmpls[args.name]
        C.save_templates(tmpls)
        network = cfg.get("network", "?") if cfg else "?"
        C.audit("template_remove", None, None, network,
                cfg.get("address", "?") if cfg else "?", "removed",
                note=f"name={args.name}")
        print(f"removed template {args.name!r}")
    else:  # pragma: no cover — argparse restricts choices
        sys.exit(f"unknown template command {cmd!r}")


def _profile_input(prompt, default="", _input=input):
    try:
        ans = _input(prompt).strip()
    except EOFError:
        return None  # signal: stop the questionnaire
    if ans.lower() == "quit":
        return None
    return ans if ans else default


def run_profile_init(prof, _input=input, cfg=None, client=None):
    """Interactive onboarding questionnaire. Everything stays local.
    Seed-like input at the address prompt is refused with the loud
    warning and re-prompted — never stored.
    The last question offers the Friday community giveaway opt-in: answering
    yes creates a normal 1-drop Payment proposal to the donation wallet
    (still needs human approval); the profile is marked opted-in only after
    that payment is validated on-ledger."""
    print("XRPL skill onboarding — everything stays on this machine "
          "(~/.xrpl/profile.json, owner-only).")
    print("Skip any question with Enter. Type 'quit' to stop.\n")

    ans = _profile_input(
        f"What should I call you? [{prof.get('display_name') or 'skip'}]: ",
        default=prof.get("display_name") or "", _input=_input)
    if ans is None:
        print("onboarding stopped — nothing was saved")
        return
    if ans:
        problem = C.set_profile_field(prof, "display_name", ans)
        if problem:
            print(f"  ({problem} — keeping previous)")

    print("\nAdd WATCH-ONLY XRPL addresses (they start with 'r').")
    print("NEVER enter a seed or secret key — those start with 's'.")
    while True:
        ans = _profile_input("  address [done]: ", default="", _input=_input)
        if ans is None:
            print("onboarding stopped — nothing was saved")
            return
        if not ans:
            break
        problem = C.add_profile_list_item(prof, "xrpl_addresses", ans)
        if problem:
            print(f"  {problem}")
            continue
        print(f"  added {ans.strip()}")

    ans = _profile_input(
        "\nAny DAO memberships? (comma-separated, e.g. xaodao) [skip]: ",
        default="", _input=_input)
    if ans is None:
        print("onboarding stopped — nothing was saved")
        return
    for raw in ans.split(","):
        raw = raw.strip()
        if not raw:
            continue
        problem = C.add_profile_list_item(prof, "memberships", raw)
        if problem:
            print(f"  ({problem} — skipped)")

    ans = _profile_input(
        "\nWhat do you use the skill for? (comma-separated, e.g. "
        + ", ".join(C.SUGGESTED_INTERESTS) + ") [skip]: ",
        default="", _input=_input)
    if ans is None:
        print("onboarding stopped — nothing was saved")
        return
    for raw in ans.split(","):
        raw = raw.strip()
        if not raw:
            continue
        problem = C.add_profile_list_item(prof, "interests", raw)
        if problem:
            print(f"  ({problem} — skipped)")

    # Farmers Union opt-in. Entirely local, default no: answering yes just
    # tags the interest and points at the read-only explainer.
    ans = _profile_input(
        "\nResearch Farmers Union ($FARM)? Weekly crop dustings reward "
        "holders — the skill can explain the system and check your "
        "qualification. (y/N): ",
        default="", _input=_input)
    if ans is None:
        print("onboarding stopped — nothing was saved")
        return
    if ans.strip().lower() in C.PROFILE_BOOL_TRUE:
        problem = C.add_profile_list_item(prof, "interests", "farmers-union")
        if problem:
            print(f"  ({problem} — skipped)")
        else:
            print("  Start here: xrpl-trade farm about")

    ans = _profile_input(
        "\nPrice-move alerts when XRP swings? (y/N): ",
        default="", _input=_input)
    if ans is None:
        print("onboarding stopped — nothing was saved")
        return
    if ans.strip().lower() in C.PROFILE_BOOL_TRUE:
        C.set_profile_field(prof, "alerts.price_moves", "true")
        ans = _profile_input("  alert threshold in percent [3]: ",
                            default="3", _input=_input)
        if ans is None:
            print("onboarding stopped — nothing was saved")
            return
        problem = C.set_profile_field(prof, "alerts.threshold_pct", ans)
        if problem:
            print(f"  ({problem} — keeping 3)")

    # Friday community giveaway opt-in. Default is skip (Enter) — opting in
    # sends real value off your wallet, so silence must never mean yes.
    ans = _profile_input(
        "\nJoin the Friday community giveaway? (sends a 1-drop opt-in from "
        "your wallet — proves the address is yours, costs ~nothing) (y/N): ",
        default="", _input=_input)
    if ans is None:
        print("onboarding stopped — nothing was saved")
        return
    if ans.strip().lower() in C.PROFILE_BOOL_TRUE:
        print()
        print(giveaway_opt_in_flow(cfg, client, prof, C.load_giveaway_config()))

    C.save_profile(prof)
    print("\nProfile saved to ~/.xrpl/profile.json — "
          "review it anytime with: xrpl-trade profile show")


def cmd_profile(args, cfg=None, client=None):
    """Local assistant profile (onboarding). Entirely local: no network,
    no proposals, no signing — except `init`, which MAY propose the
    giveaway opt-in payment when the user answers yes (cfg/client are
    passed through only for that). Watch-only addresses only — seed-like
    input is refused, never stored."""
    try:
        raw = C.load_profile()
    except C.ProfileError as e:
        sys.exit(str(e))
    exists = bool(raw)
    prof = C.normalize_profile(raw) if exists else C.default_profile()
    cmd = args.prof_cmd
    if cmd == "init":
        if exists:
            print("you already have a profile — `profile show` to review, "
                  "`profile clear` to start over")
            return
        run_profile_init(prof, cfg=cfg, client=client)
    elif cmd == "show":
        if not exists:
            print("no profile yet — run: xrpl-trade profile init")
            return
        print(f"  name:        {prof.get('display_name') or '—'}")
        addrs = prof.get("xrpl_addresses") or []
        print(f"  addresses:   {', '.join(addrs) if addrs else '—'}")
        mems = prof.get("memberships") or []
        print(f"  memberships: {', '.join(mems) if mems else '—'}")
        ints = prof.get("interests") or []
        print(f"  interests:   {', '.join(ints) if ints else '—'}")
        al = prof.get("alerts") or {}
        print(f"  alerts:      price_moves={al.get('price_moves')} "
              f"threshold={al.get('threshold_pct')}%")
        gw = prof.get("giveaway") or {}
        print(f"  giveaway:    opt_in={gw.get('opt_in')} "
              f"tx={gw.get('opt_in_tx') or '—'}")
    elif cmd == "set":
        problem = C.set_profile_field(prof, args.field, args.value)
        if problem:
            sys.exit(problem)
        C.save_profile(prof)
        print(f"profile: {args.field} = {args.value}")
    elif cmd in ("add-address", "remove-address"):
        fn = (C.add_profile_list_item if cmd == "add-address"
              else C.remove_profile_list_item)
        problem = fn(prof, "xrpl_addresses", args.address)
        if problem:
            sys.exit(problem)
        C.save_profile(prof)
        verb = "added to" if cmd == "add-address" else "removed from"
        print(f"address {args.address.strip()} {verb} your profile")
    elif cmd in ("add-membership", "remove-membership"):
        fn = (C.add_profile_list_item if cmd == "add-membership"
              else C.remove_profile_list_item)
        problem = fn(prof, "memberships", args.name)
        if problem:
            sys.exit(problem)
        C.save_profile(prof)
        verb = "added to" if cmd == "add-membership" else "removed from"
        print(f"membership {args.name.strip().lower()} {verb} your profile")
    elif cmd in ("add-interest", "remove-interest"):
        fn = (C.add_profile_list_item if cmd == "add-interest"
              else C.remove_profile_list_item)
        problem = fn(prof, "interests", args.name)
        if problem:
            sys.exit(problem)
        C.save_profile(prof)
        verb = "added to" if cmd == "add-interest" else "removed from"
        print(f"interest {args.name.strip().lower()} {verb} your profile")
    elif cmd == "clear":
        if C.PROFILE_PATH.exists():
            C.PROFILE_PATH.unlink()
        print("profile cleared — run `xrpl-trade profile init` to start over")
    else:  # pragma: no cover — argparse restricts choices
        sys.exit(f"unknown profile command {cmd!r}")


def cmd_xrpresso(args):
    """Read-only XRPresso marketplace discovery.

    Anonymous, no API key, no wallet, no signing. Every result that
    carries a deep link shows it so the human can tap through and buy
    in XRPresso's own UI — the agent never buys, mints, or escrows.
    Deep links are validated: only https URLs on xrpresso.io are
    displayed; anything else is withheld, never printed."""
    cmd = args.xp_cmd
    print("XRPresso discovery (read-only) — open a link below to "
          "buy/bid in their UI.\n")
    try:
        if cmd == "listings":
            items = XP.get_listings(category=args.category, q=args.q,
                                    limit=args.limit, sort=args.sort,
                                    currency=args.currency)
            if not items:
                print("no listings found")
                return
            for it in items:
                print(XP.fmt_listing(it))
                print()
        elif cmd == "nfts":
            items = XP.get_nft_listings(q=args.q, limit=args.limit,
                                        sort=args.sort)
            if not items:
                print("no NFT listings found")
                return
            for it in items:
                print(XP.fmt_nft(it))
                print()
        elif cmd == "auctions":
            items = XP.get_nft_auctions(limit=args.limit)
            if not items:
                print("no live auctions")
                return
            for it in items:
                print(XP.fmt_auction(it))
                print()
        elif cmd == "listing":
            print(XP.fmt_listing(XP.get_listing(args.id), detail=True))
        elif cmd == "stats":
            print(XP.fmt_stats(XP.get_stats()))
        elif cmd == "categories":
            print(XP.fmt_categories(XP.get_categories()))
        else:  # pragma: no cover — argparse restricts choices
            sys.exit(f"unknown xrpresso command {cmd!r}")
    except XP.XRPressoError as e:
        sys.exit(f"XRPresso error: {e}")


def nft_safety_oneliner(nid):
    """Compact xrpl.to safety line for nft-new rows. Never raises."""
    if xrpl_to is None:
        return "unavailable (xrpl.to not loaded)"
    try:
        rep = xrpl_to.nft_safety_report(nid)
    except Exception:  # noqa: BLE001
        return "unavailable"
    if not rep or rep.get("unavailable"):
        return "unavailable"
    scam = rep.get("scam") or {}
    if isinstance(scam, dict) and scam.get("is_scam"):
        return "issuer on scam blocklist — treat as hostile (advisory)"
    if rep.get("collection_name"):
        fl = rep.get("floor_xrp")
        fl_s = f"{fl:.4g} XRP" if fl is not None else "floor n/a"
        return f"{rep['collection_name']} · floor {fl_s} (advisory)"
    return "untracked collection · issuer not flagged (advisory)"


def cmd_nft_new(args, cfg, client):
    """Read-only: what's new from favorite artists.

    For each kind=artist favorite, finds NFTokenMint transactions since
    its per-favorite watermark (first run: last 3 days) and reports the
    token, mint time, current listing price if any, and an xrp.cafe
    link. kind=friend entries are never scanned — they're just labels.
    Each mint also gets a one-line xrpl.to safety note (scam screen +
    collection/floor, advisory, fail-open; --no-safety skips, max 20
    enriched per run). --limit N caps the mints shown per artist
    (newest first, default 25, 0 = no cap); older mints beyond the cap
    are counted, not listed. The watermark then advances to the validated
    ledger. --days N is a pure window scan and does NOT move the
    watermark."""
    days = args.days
    if days is not None and not 1 <= days <= 90:
        sys.exit("--days must be between 1 and 90")
    limit = getattr(args, "limit", 25)
    if limit is not None and limit < 0:
        sys.exit("--limit must be 0 (no cap) or a positive number")
    try:
        favs = C.load_favorites()
    except C.FavoritesError as e:
        sys.exit(str(e))
    if not favs:
        print("no favorites yet — add one with: "
              "xrpl-trade favorites add <name> <r-address>")
        return
    now = int(time.time())
    validated, problem = C.get_validated_ledger(client)
    if problem:
        sys.exit(problem)
    enrich_used = 0
    scanned = 0
    for name in sorted(favs):
        fav = favs[name]
        if fav.get("kind", "artist") != "artist":
            continue  # friends are labels, never scanned
        scanned += 1
        addr = fav.get("address") or "?"
        if days is not None:
            cutoff, stop_ledger = now - days * 86400, None
            window = f"last {days}d"
        else:
            wm = fav.get("last_checked_ledger")
            if wm is None:
                cutoff, stop_ledger = now - 3 * 86400, None
                window = "last 3d (first check)"
            else:
                cutoff, stop_ledger = None, wm
                window = f"since ledger {wm}"
        mints, _pages, problem = C.scan_artist_mints(
            client, addr, stop_ledger=stop_ledger, cutoff_unix=cutoff)
        tag = f"{name} ({C.short_addr(addr)})"
        if problem:
            print(f"{tag} — note: {problem}")
            continue
        if not mints:
            print(f"{tag} — nothing new ({window})")
        else:
            ordered = sorted(mints, key=lambda m: m.get("date_unix") or 0,
                             reverse=True)
            total = len(ordered)
            shown = ordered if not limit else ordered[:limit]
            hidden = total - len(shown)
            print(f"{tag} — {total} new ({window}):")
            if hidden:
                print(f"    (showing newest {len(shown)}; {hidden} older "
                      f"not shown — raise with --limit N)")
            for m in shown:
                tids = m["token_ids"]
                nid = tids[0] if tids else None
                when = (time.strftime("%Y-%m-%d %H:%M UTC",
                                      time.gmtime(m["date_unix"]))
                        if m["date_unix"] else "unknown time")
                print(f"  • {nid or '<token id not found in metadata>'}")
                print(f"    minted:  {when}   taxon: {m['taxon']}")
                print(f"    uri:     {C.decode_nft_uri(m['uri_hex'], 80)}")
                if nid:
                    price, perr = C.nft_sell_price(client, nid)
                    link = C.XRP_CAFE_NFT_URL.format(nid)
                    if perr:
                        print(f"    listing: unknown ({perr})")
                    elif price:
                        print(f"    listing: {price}")
                    else:
                        print("    listing: not listed")
                    print(f"             {link}")
                    if nid and not getattr(args, "no_safety", False):
                        if enrich_used >= 20:
                            print("    safety:  skipped (over 20-item "
                                  "enrich cap this run)")
                        else:
                            enrich_used += 1
                            print(f"    safety:  "
                                  f"{nft_safety_oneliner(nid)}")
        if days is None:
            fav["last_checked_ledger"] = validated
    if scanned == 0:
        print("no artist favorites to scan — friends are labels only, "
              "not artists")
    if days is None:
        C.save_favorites(favs)


# ---------- FUZZY deal scanner (read-only) ----------
# FUZZY community NFT collections on xrpl.to (verified 2026-10-03).
# fuzzybears = "Original Fuzzybears", issuer rw1R8cfHGMySmbj7gJ1HkiCqTY1xhLGYAs
#   (the official FUZZY project issuer Mike confirmed).
# fuzzy-bars = "Fuzzy Bars", a second FUZZY community collection.
FUZZY_COLLECTIONS = ("fuzzybears", "fuzzy-bars")
FUZZY_DEALS_MAX_TOKENS = 60  # listed tokens scanned per collection
FUZZY_DEALS_WORKERS = 15     # parallel offer lookups


def fuzzy_find_deals(asks, threshold_pct, trim_fraction=0.25):
    """Pure deal math: asks is [(nft_id, Decimal xrp, offer_index)].

    The median is a *trimmed* median: the top and bottom quartiles of asks are chopped before taking the median, so a few whale listings
    (or one dust listing) can't drag the reference price around. Floor
    is still the true minimum ask. Returns (floor, median, deals) where
    deals is [(nft_id, price, pct_below_median, offer_index, rank)] sorted
    best-first; rank is the share of asks this price beats (0-100). A deal is priced at least threshold_pct below the trimmed
    median. Empty asks -> (None, None, [])."""
    from decimal import Decimal
    prices = sorted(p for _, p, _ in asks)
    if not prices:
        return None, None, []
    floor = prices[0]
    # trimmed median: chop the extremes so outliers can't move the
    # reference price; need at least 3 values left to bother
    n = len(prices)
    cut = int(n * trim_fraction)
    core = prices[cut:n - cut] if n - 2 * cut >= 3 else prices
    m = len(core)
    median = (core[m // 2] if m % 2
              else (core[m // 2 - 1] + core[m // 2]) / 2)
    deals = []
    cutoff_factor = Decimal(1) - Decimal(threshold_pct) / Decimal(100)
    for nid, price, oidx in asks:
        if median > 0 and price <= median * cutoff_factor:
            pct = (median - price) / median * 100
            # percentile rank: share of asks this price beats (0-100)
            rank = sum(1 for p in prices if p >= price) / len(prices) * 100
            deals.append((nid, price, pct, oidx, rank))
    deals.sort(key=lambda d: d[2], reverse=True)
    return floor, median, deals


def cmd_fuzzy_deals(args, cfg, client):
    """Read-only: FUZZY NFTs listed below market.

    For each FUZZY community collection, pulls listed tokens from xrpl.to,
    fetches each token's live sell offers, and flags asks at least
    --threshold percent below the collection's median ask. Stats are
    per-collection (collections trade at very different tiers). Nothing
    here proposes, signs, or submits — acting on a deal is the separate
    nft-buy ceremony, and the ledger is authoritative before acting
    (offers can be cancelled). Market data by xrpl.to.
    """
    from decimal import Decimal
    threshold = args.threshold
    if not 1 <= threshold <= 90:
        sys.exit("--threshold must be between 1 and 90")
    limit = args.limit
    if limit is not None and limit < 0:
        sys.exit("--limit must be 0 (no cap) or a positive number")
    if xrpl_to is None:
        print("FUZZY market data unavailable (xrpl.to module not loaded)")
        return
    # XRP/USD once per run for USD equivalents (best-effort; XRP-denominated
    # asks mean different USD values as XRP moves — show both, never USD-only)
    xrp_usd = C.fetch_xrp_usd()

    def _usd(xrp):
        if xrp_usd is None:
            return ""
        return f" (~${float(xrp) * xrp_usd:,.0f})"

    def _cheapest(tid):
        """(tid, Decimal|None, offer_index|None) — never raises."""
        try:
            r = xrpl_to.api_get(f"/nft/offers/sell/{tid}")
        except Exception:  # noqa: BLE001 — fail open per token
            return tid, None, None
        offers = (r or {}).get("offers") if isinstance(r, dict) else None
        if not isinstance(offers, list):
            return tid, None, None
        best, best_idx = None, None
        for o in offers:
            if not isinstance(o, dict):
                continue
            try:
                v = Decimal(o.get("amount", "0")) / Decimal(1_000_000)
            except Exception:  # noqa: BLE001
                continue
            if v <= 0:
                continue
            if best is None or v < best:
                best, best_idx = v, o.get("nft_offer_index")
        return tid, best, best_idx

    from concurrent.futures import ThreadPoolExecutor
    all_deals = []
    markets = []
    quiet = getattr(args, "json", False)
    api_failed = []
    for slug in FUZZY_COLLECTIONS:
        try:
            r = xrpl_to.api_get(f"/nft/collections/{slug}/nfts",
                                {"listed": "true",
                                 "limit": FUZZY_DEALS_MAX_TOKENS})
        except Exception:  # noqa: BLE001
            r = None
        nfts = (r or {}).get("nfts") if isinstance(r, dict) else None
        if r is None:
            api_failed.append(slug)
            markets.append((slug, 0, None, None))
            continue
        if not isinstance(nfts, list) or not nfts:
            markets.append((slug, 0, None, None))
            continue
        tids = [n.get("NFTokenID") for n in nfts
                if isinstance(n, dict) and n.get("NFTokenID")]
        if not quiet:
            print(f"checking {len(tids)} listed {slug} tokens…")
        asks = []
        with ThreadPoolExecutor(max_workers=FUZZY_DEALS_WORKERS) as pool:
            for tid, best, best_idx in pool.map(_cheapest, tids):
                if best is not None:
                    asks.append((tid, best, best_idx))
        if not asks:
            markets.append((slug, len(tids), None, None))
            continue
        floor, median, deals = fuzzy_find_deals(asks, threshold)
        markets.append((slug, len(tids), floor, median))
        for d in deals:
            all_deals.append((slug,) + d)
    if getattr(args, "json", False):
        import json as _json
        import time as _jtime
        jdeals = []
        for slug, nid, p, pct, oidx, rank in \
                (all_deals if not limit else all_deals[:limit]):
            jd = {"collection": slug, "token_id": nid,
                  "ask_xrp": str(p),
                  "ask_usd": round(float(p) * xrp_usd, 2)
                             if xrp_usd else None,
                  "pct_below_median": round(float(pct), 1),
                  "cheaper_than_pct": round(float(rank), 1),
                  "offer_index": oidx}
            try:
                det = xrpl_to.nft_last_sale_detail(nid)
            except Exception:  # noqa: BLE001
                det = None
            if det and det[0] and det[1]:
                rate_then = C.fetch_xrp_usd_at(det[1])
                jd["last_sale_xrp"] = round(det[0], 2)
                jd["last_sale_date"] = _jtime.strftime(
                    "%Y-%m-%d", _jtime.gmtime(det[1]))
                jd["last_sale_usd_then"] = round(det[0] * rate_then, 2) \
                    if rate_then else None
            jdeals.append(jd)
        print(_json.dumps({
            "threshold_pct": threshold,
            "xrp_usd": xrp_usd,
            "collections": [
                {"slug": slug, "listed_scanned": n,
                 "floor_xrp": str(fl) if fl else None,
                 "trimmed_median_xrp": str(md) if md else None}
                for slug, n, fl, md in markets],
            "note": "asks are open ledger offers via xrpl.to, not sales; "
                    "last-sale figures are approximate (derived); "
                    "verify on-ledger before acting",
            "attribution": "Data by xrpl.to (https://xrpl.to)",
            "deals": jdeals,
        }, indent=2))
        return
    print("FUZZY market (Data by xrpl.to"
          + (f"; XRP ${xrp_usd:,.2f}" if xrp_usd else "") + "):")
    for slug, n, fl, md in markets:
        if slug in api_failed:
            print(f"  {slug}: data unavailable (aggregator unreachable)")
        elif fl is None:
            print(f"  {slug}: no open asks in sample ({n} listed checked)")
        else:
            print(f"  {slug}: floor {fl} XRP{_usd(fl)} · "
                  f"trimmed median {md} XRP{_usd(md)} "
                  f"({n} listed checked)")
    if not all_deals:
        if api_failed and len(api_failed) == len(markets):
            print("  FUZZY market data unavailable (aggregator unreachable)")
        else:
            print(f"  no asks ≥{threshold}% below trimmed median right now")
        return
    shown = all_deals if not limit else all_deals[:limit]
    print(f"  DEALS (≥{threshold}% below trimmed median):")
    # last-sale context per deal (parallel; best-effort, never blocks)
    def _last_sale(nid):
        try:
            return nid, xrpl_to.nft_last_sale_detail(nid)
        except Exception:  # noqa: BLE001
            return nid, None
    sale_map = {}
    with ThreadPoolExecutor(max_workers=10) as pool:
        for nid, det in pool.map(_last_sale, [d[1] for d in shown]):
            sale_map[nid] = det
    import time as _time
    for i, (slug, nid, price, pct, oidx, rank) in enumerate(shown, 1):
        print(f"  {i}. [{slug}] {C.short_addr(nid)} — {price} XRP{_usd(price)} "
              f"(-{pct:.1f}% vs median, cheaper than {rank:.0f}% of asks)")
        det = sale_map.get(nid)
        if det and det[0] and det[1]:
            sale_xrp, sale_unix = det
            rate_then = C.fetch_xrp_usd_at(sale_unix)
            sale_date = _time.strftime("%Y-%m-%d", _time.gmtime(sale_unix))
            if rate_then:
                sale_usd = sale_xrp * rate_then
                print(f"     last sold {sale_xrp:.1f} XRP (~${sale_usd:,.0f} "
                      f"@ ${rate_then:.2f} then, {sale_date})")
            else:
                print(f"     last sold {sale_xrp:.1f} XRP ({sale_date}; "
                      f"historical rate unavailable)")
        if oidx:
            print(f"     buy: xrpl-trade nft-buy --offer-index {oidx}")
        else:
            print("     buy: offer index unavailable — recheck before acting")
    if limit and len(all_deals) > limit:
        print(f"  (+{len(all_deals) - limit} more — raise with --limit N)")
    print("  verify on-ledger before acting — offers can be cancelled")


def cmd_incoming(args, cfg, client):
    """Read-only: what's coming IN to an account.

    Two parts: (1) open NFT offers from xrpl.to — bids on the account's
    NFTs plus sell offers directed at it, with per-row issuer blocklist
    screens and filters; (2) recent ledger receipts from account_tx
    (NFTokenAcceptOffer / NFTokenMint, last 7d) with direction derived
    from the consumed offer. Counterparties render through favorite
    labels ('Jenna X (rABC…WXYZ)'). Nothing here proposes, signs, or
    submits — acting on an offer is the nft-buy ceremony, and offers can
    be cancelled, so the ledger is authoritative before acting.

    --watch NAME reads the address from a watched wallet
    (`xrpl-trade watch add`); --all-watched sweeps every watched wallet.
    """
    watch_name = getattr(args, "watch", None)
    all_watched = getattr(args, "all_watched", False)
    if watch_name and all_watched:
        sys.exit("use only one of --watch / --all-watched")
    if all_watched:
        watched = _watched_wallets()
        if not watched:
            sys.exit("no watched wallets — add one with: "
                     "xrpl-trade watch add <name> <r-address>")
        for name in sorted(watched):
            _incoming_one(watched[name]["address"], args, cfg, client)
        return
    if watch_name:
        watched = _watched_wallets()
        if watch_name not in watched:
            sys.exit(f"no watched wallet named {watch_name!r} — "
                     "`xrpl-trade watch list` to see them")
        account = watched[watch_name]["address"]
    else:
        account = args.account or cfg.get("address")
        if not account:
            sys.exit("no account: pass --account or set address in "
                     "~/.xrpl/config.json")
    if not C.is_valid_classic_address(account):
        sys.exit("account is not a valid classic address "
                 "(base58 checksum failed)")
    _incoming_one(account, args, cfg, client)


def _incoming_one(account, args, cfg, client):
    """Per-account body of `incoming`: offers + 7d ledger receipts."""
    try:
        favs = C.load_favorites()
    except C.FavoritesError:
        favs = {}
    labeler = lambda a: C.display_address(a, favs)  # noqa: E731
    print(f"Incoming for {labeler(account)} (read-only):")
    if xrpl_to is None:
        print("  (xrpl.to offers unavailable — xrpl_to not loaded)")
    else:
        for ln in xrpl_to.format_incoming_offers(
                account, limit=args.limit, hide_flagged=args.hide_flagged,
                collection=args.collection, min_xrp=args.min_xrp,
                max_xrp=args.max_xrp, from_addr=args.from_addr,
                no_safety=args.no_safety, labeler=labeler):
            print(ln)
    print("")
    print("Recent ledger receipts (last 7d, authoritative):")
    receipts, problem = C.scan_nft_receipts(client, account)
    if problem:
        print(f"  note: {problem}")
    if not receipts and not problem:
        print("  nothing in the last 7 days")
    for r in receipts:
        when = (time.strftime("%Y-%m-%d", time.gmtime(r["date_unix"]))
                if r["date_unix"] else "unknown time")
        nid = r["nft_id"] or "?"
        nid_s = f"{nid[:8]}…{nid[-4:]}" if len(nid) > 14 else nid
        h = (r["tx_hash"] or "?")
        h_s = f"{h[:8]}…" if len(h) > 10 else h
        cpty = labeler(r["counterparty"]) if r["counterparty"] else "—"
        if r["direction"] == "received":
            verb = f"RECEIVED from {cpty}"
        elif r["direction"] == "sent":
            verb = f"SENT to {cpty}"
        elif r["direction"] == "minted":
            verb = f"minted by you" + (f" → {cpty}" if r["counterparty"]
                                       else "")
        else:
            verb = f"involved {cpty} (direction unclear — check {h_s})"
        print(f"  • {verb} · {nid_s} · {when} · {h_s}")


# ---------- local wallet creation (v0.6.1) ----------
#
# New-user onboarding path: generate a fresh wallet LOCALLY and store the
# seed straight into ~/.xrpl/config.json (0600, atomic). The seed NEVER
# appears in stdout, stderr, logs, proposals, or chat — only the classic
# address is ever printed. This is the "local signer" deployment profile:
# convenient, but the seed lives on this machine. The vault-signer profile
# (seed injected as XRPL_SEED at approval time, never stored here) remains
# the safer option, and Xaman generation (seed never touches this machine
# at all) the safest. See "Wallets" in SKILL.md.

def generate_wallet_into_config(network, force=False):
    """Generate a fresh ed25519 wallet; store seed 0600, return address.

    Prints nothing. Refuses to overwrite an already-stored seed unless
    force is set.
    """
    from xrpl.wallet import Wallet
    cfg = {}
    if C.CONFIG_PATH.exists():
        cfg = json.loads(C.CONFIG_PATH.read_text())
    if cfg.get("seed") and not force:
        sys.exit("a wallet seed is already stored in ~/.xrpl/config.json — "
                 "refusing to overwrite. Use `xrpl-trade wallet create --force` "
                 "to replace it (treat the old wallet as burned if its seed "
                 "was ever exposed).")
    wallet = Wallet.create()  # ed25519 in this xrpl-py
    # Belt and braces: the seed must derive the address we report.
    if Wallet.from_seed(wallet.seed).classic_address != wallet.classic_address:
        sys.exit("internal error: generated seed does not derive its address")
    address = wallet.classic_address
    seed = wallet.seed
    del wallet
    cfg.update({"seed": seed, "address": address, "network": network})
    C.default_read_only_for_new_config(cfg)  # fresh installs: read-only
    del seed
    C.XRPL_DIR.mkdir(parents=True, exist_ok=True)
    tmp = C.CONFIG_PATH.with_name(C.CONFIG_PATH.name + ".tmp")
    tmp.write_text(json.dumps(cfg, indent=2) + "\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, C.CONFIG_PATH)
    C.audit("wallet_create", None, None, network, address, "stored",
            note="seed stored 0600, never displayed")
    return address


def backup_ceremony(seed, address):
    """One-time seed display for write-down backup.

    Prints the seed exactly once with hard warnings, then requires the
    operator to type I HAVE WRITTEN IT DOWN. Returns True on confirmation.
    The seed itself is never logged, never returned, never stored here —
    the caller records the confirmation flag wherever fits.
    """
    print("=" * 64)
    print("ONE-TIME BACKUP — write this down NOW: on paper, or in your")
    print("password manager, offline. This is the ONLY time this seed will")
    print("be displayed. Anyone holding it controls the wallet. Never paste")
    print("it into chat, email, screenshots, or any app. If it ever touches")
    print("chat or a log, treat the wallet as BURNED and generate a new one.")
    print("=" * 64)
    print(f"  address: {address}")
    print(f"  seed:    {seed}")
    print("=" * 64)
    ans = input("Type I HAVE WRITTEN IT DOWN to confirm your backup: ").strip()
    return ans == "I HAVE WRITTEN IT DOWN"


def _fuzzy_lore_path():
    return Path(__file__).resolve().parent.parent / "references" / "fuzzy-lore.md"


def cmd_fuzzy(args):
    """Hidden Easter egg: the Fuzzy Dossier + JoelKatz mode.

    Not in any menu, not in SKILL.md, hidden from --help. Lore lives in
    references/fuzzy-lore.md (single source of truth); this command only
    presents it and picks the random opening wisdom quote.
    """
    import random
    import re

    lore_path = _fuzzy_lore_path()
    try:
        text = lore_path.read_text(encoding="utf-8")
    except OSError:
        print("the fuzzy lore file is missing — the bear has left the building")
        return

    # Fuzzy wisdom: one random genuine quote from the lore file.
    m = re.search(r"## Fuzzy wisdom.*?(?=^## )", text,
                  re.DOTALL | re.MULTILINE)
    quotes = re.findall(r'"([^"]+)"', m.group(0), re.DOTALL) if m else []
    wisdom = random.choice(quotes) if quotes else \
        "I know much less about this than you think."
    wisdom = " ".join(wisdom.split())

    # The canon: lore file section between "## The canon" and "## Fuzzy wisdom".
    c = re.search(r"## The canon(.*?)^## Fuzzy wisdom", text,
                  re.DOTALL | re.MULTILINE)
    canon = c.group(1).strip() if c else text.strip()

    print("=" * 64)
    print("  FUZZY WISDOM OF THE MOMENT")
    print("=" * 64)
    print(f'  "{wisdom}"')
    print("   — David \"JoelKatz\" Schwartz (genuine quote)")
    print()
    print("=" * 64)
    print("  THE FUZZY DOSSIER — on-chain canon")
    print("=" * 64)
    print(canon)
    print()
    print("-" * 64)
    print("  JoelKatz mode engaged — and this command exits here.")
    print("  Ask follow-ups in chat about FUZZY, AMMs, trustlines; answers")
    print("  come back dry, precise, and definitely not financial advice.")
    print("  This command is not in the menus. You found it. Good.")
    print("  Data: the validated ledger. Vibes: the bear.")
    print("-" * 64)


