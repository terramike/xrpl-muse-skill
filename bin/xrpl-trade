#!/usr/bin/env python3
"""xrpl-trade v0.5: the PROPOSER half of the hardened XRPL skill.

This program NEVER sees the wallet seed and NEVER submits a transaction.
Write commands (buy/sell/trustline/cancel/send/nft-mint/nft-list/nft-buy/nft-bid)
build the
transaction, autofill it against the live network, print the full ceremony
summary (account, network, assets+issuers, amounts, limit price, max spend,
fee, expiry), hash the exact bytes-to-be-approved, and save a proposal.

The separate `xrpl-sign` program enforces policy and signs — only after
independent human approval of that exact hash.

Read-only: balance, quote, offers, pairs, inspect-token, plan-trade, reconcile,
nft-inventory, favorites, nft-new.
NFT: nft-mint pins artwork + metadata to IPFS with the operator's own
Pinata key (bring-your-own-key — the skill never hosts anyone's media),
then proposes the mint; nft-list proposes an XRP-denominated sell offer.
"""
import argparse
import asyncio
import json
import os
import sys
import time
from decimal import Decimal, ROUND_DOWN
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import xrpl_common as C

try:
    from xrpl.clients import JsonRpcClient
    from xrpl.models.amounts import IssuedCurrencyAmount
    from xrpl.models.currencies import IssuedCurrency, XRP
    from xrpl.models.requests import (
        AccountInfo, AccountLines, AccountOffers, BookOffers, ServerInfo, Tx,
        AccountNFTs,
    )
    from xrpl.models.transactions import OfferCancel, OfferCreate, Payment, TrustSet
    from xrpl.models.transactions import (NFTokenAcceptOffer,
                                          NFTokenCreateOffer,
                                          NFTokenCreateOfferFlag,
                                          NFTokenMint, NFTokenMintFlag)
    from xrpl.transaction import autofill
    from xrpl.utils import drops_to_xrp, xrp_to_drops
except ImportError:
    sys.exit("xrpl-py not installed. Run: pip install -r requirements.txt")

try:
    import xrpl_pin
except ImportError:
    xrpl_pin = None  # NFT minting unavailable; other commands unaffected


# ---------- config / client ----------

def load_config():
    cfg = {}
    if C.CONFIG_PATH.exists():
        cfg = json.loads(C.CONFIG_PATH.read_text())
    cfg["address"] = os.environ.get("XRPL_ADDRESS") or cfg.get("address")
    cfg["network"] = os.environ.get("XRPL_NETWORK") or cfg.get("network", "testnet")
    return cfg


def get_client(network):
    def _request(self, request):
        return asyncio.run(self._request_impl(request, timeout=30.0))

    last_err = None
    for url in C.NETWORKS[network]:
        c = JsonRpcClient(url)
        c.request = _request.__get__(c, JsonRpcClient)
        for attempt in range(3):
            try:
                if c.request(ServerInfo()).is_successful():
                    return c
                break
            except Exception as e:  # noqa: BLE001
                last_err = e
                time.sleep(1 + attempt)
    sys.exit(f"No healthy {network} node ({last_err}).")


# ---------- builders (pure: no network, no signing) ----------

def iou_amount(currency, issuer, value: Decimal):
    return IssuedCurrencyAmount(
        currency=C.currency_code(currency), issuer=issuer, value=format(value, "f"))


def make_amount(ccy, issuer, value: Decimal):
    if ccy == "XRP":
        return xrp_to_drops(value)
    if not issuer:
        sys.exit(f"issuer required for {ccy} "
                 f"(pass --base-issuer/--quote-issuer or use --pair)")
    return iou_amount(ccy, issuer, value)


def make_currency(ccy, issuer):
    if ccy == "XRP":
        return XRP()
    if not issuer:
        sys.exit(f"issuer required for {ccy}")
    return IssuedCurrency(currency=C.currency_code(ccy), issuer=issuer)


def build_offer_tx(account, base, base_issuer, quote, quote_issuer,
                  amount: Decimal, price: Decimal, side: str, expires_in: int):
    """side=buy: TakerPays=BASE received, TakerGets=QUOTE paid.
    side=sell: TakerPays=QUOTE received, TakerGets=BASE sold."""
    if side == "buy":
        taker_pays = make_amount(base, base_issuer, amount)
        cost = (amount * price).quantize(Decimal("0.000001"), rounding=ROUND_DOWN)
        taker_gets = make_amount(quote, quote_issuer, cost)
    elif side == "sell":
        proceeds = (amount * price).quantize(Decimal("0.000001"), rounding=ROUND_DOWN)
        taker_pays = make_amount(quote, quote_issuer, proceeds)
        taker_gets = make_amount(base, base_issuer, amount)
    else:
        sys.exit("side must be buy or sell")
    return OfferCreate(
        account=account, taker_pays=taker_pays, taker_gets=taker_gets,
        expiration=C.ripple_time_from_now(expires_in))


def fmt_amt(a):
    if isinstance(a, dict):
        return f"{a['value']} {C.display_currency(a['currency'])}.{a['issuer'][:8]}…"
    return f"{drops_to_xrp(a)} XRP"


# ---------- ceremony ----------

def propose(tx, client, cfg, action, summary_lines):
    """Autofill, hash into a bound envelope, save. Never submits."""
    filled = autofill(tx, client)
    txd = filled.to_xrpl()  # PascalCase wire format (to_dict() is snake_case)
    # Unsigned proposals must not carry signature material — autofill adds
    # an empty SigningPubKey, which the signer's envelope invariants reject.
    txd.pop("SigningPubKey", None)
    txd.pop("TxnSignature", None)
    lines = [
        f"network:  {cfg['network']}",
        f"account:  {txd['Account']}",
        f"action:   {action}",
        *summary_lines,
        f"fee:      {drops_to_xrp(txd['Fee'])} XRP",
        f"sequence: {txd['Sequence']}",
        f"last_ledger: {txd.get('LastLedgerSequence', 'n/a')}",
    ]
    if "Expiration" in txd:
        exp = time.strftime("%Y-%m-%dT%H:%M:%SZ",
                            time.gmtime(txd["Expiration"] + C.RIPPLE_EPOCH))
        lines.append(f"expires:  {exp}")
    h, _ = C.save_proposal(txd, cfg["network"], txd["Account"], action)
    print("=" * 60)
    print("PROPOSAL — review carefully. Nothing has been submitted.")
    print("=" * 60)
    for ln in lines:
        print("  " + ln)
    print("=" * 60)
    print(f"proposal hash: {h}")
    print(f"\nA HUMAN must review the hash above, then run:")
    print(f"  xrpl-sign --hash {h[:16]} --approve")
    print(f"\nFull autofilled transaction saved to:\n"
          f"  {C.PROPOSALS_DIR / (h + '.json')}")
    return h


# ---------- read commands ----------

def cmd_balance(args, cfg, client):
    addr = args.address or cfg.get("address")
    if not addr:
        sys.exit("No address. Pass one or run `xrpl-trade setup`.")
    info = client.request(AccountInfo(account=addr, ledger_index="validated"))
    if not info.is_successful():
        sys.exit(f"AccountInfo failed: {info.result}")
    print(f"XRP: {drops_to_xrp(info.result['account_data']['Balance'])}")
    lines = client.request(AccountLines(account=addr, ledger_index="validated"))
    if lines.is_successful():
        for l in lines.result.get("lines", []):
            if Decimal(l["balance"]) != 0:
                print(f"{l['currency']}.{l['account'][:8]}…: {l['balance']} "
                      f"(limit {l['limit']})")


def book_side(client, gets, pays, limit):
    r = client.request(BookOffers(taker_gets=gets, taker_pays=pays,
                                  limit=limit, ledger_index="validated"))
    if not r.is_successful():
        sys.exit(f"BookOffers failed: {r.result}")
    return r.result.get("offers", [])


def amt_value(a):
    if isinstance(a, dict):
        return Decimal(a["value"]), C.display_currency(a["currency"])
    return Decimal(drops_to_xrp(a)), "XRP"


def cmd_quote(args, cfg, client):
    base, base_issuer, quote, quote_issuer = C.resolve_pair(args)
    base_amt = make_currency(base, base_issuer)
    quote_amt = make_currency(quote, quote_issuer)
    asks = book_side(client, base_amt, quote_amt, args.limit)
    bids = book_side(client, quote_amt, base_amt, args.limit)
    print(f"--- {base}/{quote} asks (sell {base}) ---")
    for o in asks:
        qv, _ = amt_value(o["TakerPays"]); bv, _ = amt_value(o["TakerGets"])
        print(f"  {fmt_amt(o['TakerGets'])} @ {qv / bv:.6f} {quote}")
    print(f"--- {base}/{quote} bids (buy {base}) ---")
    for o in bids:
        qv, _ = amt_value(o["TakerGets"]); bv, _ = amt_value(o["TakerPays"])
        print(f"  {fmt_amt(o['TakerPays'])} @ {qv / bv:.6f} {quote}")


def cmd_pairs(args, cfg, client):
    pairs = C.load_approved()
    if not pairs:
        print(f"No approved pairs. Copy approved.example.json to {C.APPROVED_PATH}.")
        return
    for name in sorted(pairs):
        p = pairs[name]
        print(f"{name}: {p['base']} ({(p.get('base_issuer') or 'native')[:12]}) / "
              f"{p['quote']} ({(p.get('quote_issuer') or 'native')[:12]})")


def cmd_offers(args, cfg, client):
    addr = args.address or cfg.get("address")
    if not addr:
        sys.exit("No address. Pass one or run `xrpl-trade setup`.")
    r = client.request(AccountOffers(account=addr, ledger_index="validated"))
    if not r.is_successful():
        sys.exit(f"AccountOffers failed: {r.result}")
    offers = r.result.get("offers", [])
    if not offers:
        print("No open offers.")
        return
    for o in offers:
        print(f"seq={o['seq']} {fmt_amt(o['taker_gets'])} <- {fmt_amt(o['taker_pays'])}")


def cmd_inspect_token(args, cfg, client):
    ccy, issuer = args.currency.upper(), args.issuer
    r = client.request(AccountInfo(account=issuer, ledger_index="validated"))
    if not r.is_successful():
        sys.exit(f"Issuer account not found: {r.result}")
    ad = r.result["account_data"]
    flags = int(ad.get("Flags", 0))
    rate = int(ad.get("TransferRate", 1000000000))
    fee_pct = (rate - 1000000000) / 10000000
    domain = ad.get("Domain")
    if domain:
        try:
            domain = bytes.fromhex(domain).decode()
        except ValueError:
            pass
    print(f"token:  {ccy}.{issuer}")
    print(f"domain: {domain or 'NOT SET (no toml verification possible)'}")
    print(f"transfer fee: {fee_pct:.3f}%")
    print(f"global freeze: {'YES — issuer can freeze all holders' if flags & 0x00400000 else 'no'}")
    print(f"no-freeze enabled: {'yes (issuer gave up freeze power)' if flags & 0x00200000 else 'no'}")


def cmd_plan_trade(args, cfg, client):
    base, base_issuer, quote, quote_issuer = C.resolve_pair(args)
    amount = C.dec(args.amount, "amount")
    price = C.dec(args.price, "price")
    side = args.side
    base_amt = make_currency(base, base_issuer)
    quote_amt = make_currency(quote, quote_issuer)
    # walk the side we'd take from: buys take asks, sells take bids
    if side == "buy":
        book = book_side(client, base_amt, quote_amt, 50)  # asks
        get_f, pay_f = "TakerGets", "TakerPays"
    else:
        book = book_side(client, quote_amt, base_amt, 50)  # bids
        get_f, pay_f = "TakerPays", "TakerGets"
    if not book:
        sys.exit("Empty book — no liquidity.")
    best_q, best_b = amt_value(book[0][pay_f]), amt_value(book[0][get_f])
    mid = best_q[0] / best_b[0]
    dev = (price - mid) / mid * 100
    # walk depth at-or-better than our limit
    filled_base = Decimal(0); spent_quote = Decimal(0)
    for o in book:
        qv, _ = amt_value(o[pay_f]); bv, _ = amt_value(o[get_f])
        px = qv / bv
        if (side == "buy" and px > price) or (side == "sell" and px < price):
            break
        take = min(bv, amount - filled_base)
        filled_base += take; spent_quote += take * px
        if filled_base >= amount:
            break
    pct = filled_base / amount * 100
    avg = spent_quote / filled_base if filled_base else Decimal(0)
    max_spend = (amount * price).quantize(Decimal("0.000001"), rounding=ROUND_DOWN)
    print(f"plan: {side} {amount} {base} @ limit {price} {quote} [{cfg['network']}]")
    print(f"book mid: {mid:.6f} {quote}  (limit is {dev:+.2f}% vs mid)")
    print(f"est. fill at limit: {filled_base} {base} ({pct:.1f}%)")
    if filled_base:
        print(f"avg fill price: {avg:.6f} {quote}")
    print(f"max spend: {max_spend} {quote}")
    if pct < 100:
        print("NOTE: book is thin at this limit — expect a partial fill, "
              "rest becomes a resting offer.")


def cmd_reconcile(args, cfg, client):
    r = client.request(Tx(transaction=args.hash))
    if not r.is_successful():
        sys.exit(f"tx lookup failed: {r.result}")
    res = r.result
    meta = res.get("meta", {})
    validated = res.get("validated", False)
    print(f"hash:      {args.hash}")
    print(f"validated: {validated}")
    print(f"result:    {meta.get('TransactionResult', '?')}")
    print(f"ledger:    {res.get('ledger_index', '?')}")


# ---------- write commands (propose only) ----------

def need_account(cfg):
    if not cfg.get("address"):
        sys.exit("No address configured. Run `xrpl-trade setup` first.")
    return cfg["address"]


def cmd_buy(args, cfg, client):
    acct = need_account(cfg)
    base, bi, quote, qi = C.resolve_pair(args)
    amt = C.dec(args.amount, "amount"); price = C.dec(args.price, "price")
    cost = (amt * price).quantize(Decimal("0.000001"), rounding=ROUND_DOWN)
    tx = build_offer_tx(acct, base, bi, quote, qi, amt, price, "buy",
                        args.expires_in)
    propose(tx, client, cfg, "buy",
            [f"side:   BUY {amt} {base}",
             f"price:  {price} {quote} per {base}",
             f"max spend: {cost} {quote}"])


def cmd_sell(args, cfg, client):
    acct = need_account(cfg)
    base, bi, quote, qi = C.resolve_pair(args)
    amt = C.dec(args.amount, "amount"); price = C.dec(args.price, "price")
    proceeds = (amt * price).quantize(Decimal("0.000001"), rounding=ROUND_DOWN)
    tx = build_offer_tx(acct, base, bi, quote, qi, amt, price, "sell",
                        args.expires_in)
    propose(tx, client, cfg, "sell",
            [f"side:   SELL {amt} {base}",
             f"price:  {price} {quote} per {base}",
             f"min proceeds: {proceeds} {quote}"])


def cmd_trustline(args, cfg, client):
    acct = need_account(cfg)
    if getattr(args, "pair", None):
        base, bi, _, _ = C.resolve_pair(args)
        if base == "XRP":
            sys.exit("XRP needs no trustline.")
        currency, issuer = base, bi
    else:
        currency, issuer = args.currency.upper(), args.issuer
    if not issuer:
        sys.exit("issuer required (pass --issuer or use --pair)")
    limit = C.dec(args.limit, "limit")
    tx = TrustSet(account=acct,
                  limit_amount=iou_amount(currency, issuer, limit))
    propose(tx, client, cfg, "trustline",
            [f"token:  {currency}.{issuer}",
             f"limit:  {limit}"])


def cmd_cancel(args, cfg, client):
    acct = need_account(cfg)
    tx = OfferCancel(account=acct, offer_sequence=int(args.seq))
    propose(tx, client, cfg, "cancel", [f"offer seq: {args.seq}"])


def resolve_destination(to: str, cli_tag):
    """Return (classic_address, tag). Rejects conflicting X-address/CLI tags."""
    from xrpl.core.addresscodec import (
        is_valid_classic_address, is_valid_xaddress,
        xaddress_to_classic_address)
    tag = None
    if is_valid_xaddress(to):
        to, xtag, _ = xaddress_to_classic_address(to)
        tag = xtag
        if cli_tag is not None and xtag is not None and int(cli_tag) != int(xtag):
            sys.exit(f"destination tag conflict: X-address embeds tag {xtag} "
                     f"but --destination-tag {cli_tag} was given — refusing")
    elif not is_valid_classic_address(to):
        sys.exit("destination is not a valid classic address or X-address")
    if cli_tag is not None:
        tag = int(cli_tag)
    return to, tag


def cmd_send(args, cfg, client):
    acct = need_account(cfg)
    dest, tag = resolve_destination(args.to, args.destination_tag)
    amt = C.dec(args.amount, "amount")
    ccy = args.ccy.upper()
    amount = make_amount(ccy, args.issuer, amt)
    tx = Payment(account=acct, destination=dest, amount=amount,
                 destination_tag=tag)
    lines = [f"send:   {amt} {ccy}",
             f"to:     {dest}"]
    if tag is not None:
        lines.append(f"dest tag: {tag}")
    else:
        lines.append("dest tag: NONE — if the recipient is an exchange, "
                     "funds may not be credited. Use --destination-tag.")
    propose(tx, client, cfg, "send", lines)


# ---------- NFT commands (v0.5) ----------

def cmd_nft_mint(args, cfg, client):
    """Pin art + metadata to IPFS (operator's own Pinata key), then PROPOSE
    an NFTokenMint whose URI points at the metadata CID."""
    if xrpl_pin is None:
        sys.exit("xrpl_pin module missing — cannot pin.")
    acct = need_account(cfg)
    royalty_bps = int(args.royalty_bps)
    if not 0 <= royalty_bps <= 5000:
        sys.exit("royalty must be 0..5000 bps (protocol max is 50%)")
    taxon = int(args.taxon)
    if not 0 <= taxon <= 0xFFFFFFFF:
        sys.exit("taxon must fit in a uint32")
    print("pinning artwork to IPFS (your Pinata key)…")
    image_cid, metadata_cid = xrpl_pin.pin_artwork(
        args.file, args.name, args.description or "")
    uri = f"ipfs://{metadata_cid}"
    uri_hex = uri.encode("utf-8").hex().upper()
    if len(uri.encode("utf-8")) > 256:
        sys.exit("metadata URI exceeds the 256-byte ledger limit")
    # XRPL TransferFee is in 1/100000 units: 10000 = 10% = 1000 bps.
    # So TransferFee = royalty_bps * 10 (e.g. 1000 bps -> 10000).
    transfer_fee = royalty_bps * 10
    tx = NFTokenMint(
        account=acct,
        nftoken_taxon=taxon,
        uri=uri_hex,
        transfer_fee=transfer_fee,
        flags=int(NFTokenMintFlag.TF_TRANSFERABLE)
        | int(NFTokenMintFlag.TF_BURNABLE),
    )
    propose(tx, client, cfg, "nft-mint",
            [f"nft:      {args.name}",
             f"image:    ipfs://{image_cid}",
             f"metadata: {uri}",
             f"royalty:  {royalty_bps / 100:.2f}% "
             f"(immutable after mint — verify it)",
             f"flags:    transferable + burnable",
             f"taxon:    {taxon}",
             "note:     the ledger stores the URI, not the art — "
             "keep the IPFS pin alive"])


def cmd_nft_list(args, cfg, client):
    """PROPOSE an NFTokenCreateOffer SELL offer for an owned NFT.
    v1: XRP-denominated only, Expiration always required."""
    acct = need_account(cfg)
    nid = args.token_id.strip()
    if len(nid) != 64 or any(c not in "0123456789abcdefABCDEF" for c in nid):
        sys.exit("token id must be 64 hex characters")
    price = C.dec(args.price_xrp, "price")
    dest = args.destination
    if dest is not None and not C.is_valid_classic_address(dest):
        sys.exit("destination is not a valid classic address "
                 "(base58 checksum failed)")
    tx = NFTokenCreateOffer(
        account=acct,
        nftoken_id=nid.upper(),
        amount=xrp_to_drops(price),
        expiration=C.ripple_time_from_now(args.expires_in),
        destination=dest,
        flags=int(NFTokenCreateOfferFlag.TF_SELL_NFTOKEN),
    )
    lines = [f"token:    {nid.upper()}",
             f"price:    {price} XRP (SELL offer)"]
    if dest:
        lines.append(f"buyer:    {dest} (PRIVATE — only they can accept)")
    else:
        lines.append("buyer:    anyone (public listing)")
    propose(tx, client, cfg, "nft-list", lines)


def provisional_spend_check(spends):
    """Best-effort proposal-time spend-limit check. The signer always
    re-enforces these — this just refuses doomed proposals early, and
    makes the reservation math visible before approval."""
    pol_path = C.POLICY_PATH
    if not pol_path.exists():
        print("  note: no policy file — spend limits enforced by xrpl-sign")
        return
    try:
        pol = json.loads(pol_path.read_text())
    except json.JSONDecodeError:
        print("  note: unreadable policy file — spend limits enforced by "
              "xrpl-sign")
        return
    if pol.get("policy_version") != C.POLICY_VERSION:
        print("  note: policy version mismatch — spend limits enforced by "
              "xrpl-sign")
        return
    denials = C.SpentTracker().check(spends, pol)
    if denials:
        print("  pre-check: this purchase would breach spend limits:")
        for d in denials:
            print(f"    ✗ {d}")
        sys.exit("nft-buy refused by spend limits (xrpl-sign would deny it)")


def cmd_nft_inventory(args, cfg, client):
    """Read-only: list every NFToken owned by an account (marker-paged,
    so large collections are fully enumerated). The address argument
    also accepts a favorite name — writes never do."""
    arg = args.address
    if arg:
        try:
            favs = C.load_favorites()
        except C.FavoritesError as e:
            sys.exit(str(e))
        addr, problem = C.resolve_fav_or_addr(arg, favs)
        if problem:
            sys.exit(problem)
    else:
        addr = cfg.get("address")
    if not addr:
        sys.exit("No address. Pass one, a favorite name, "
                 "or run `xrpl-trade setup`.")
    nfts = []
    marker = None
    while True:
        r = client.request(AccountNFTs(account=addr, limit=400,
                                       marker=marker))
        if not r.is_successful():
            sys.exit(f"account_nfts failed: {r.result}")
        nfts.extend((r.result or {}).get("account_nfts", []))
        marker = (r.result or {}).get("marker")
        if not marker:
            break
    if not nfts:
        print(f"No NFTs owned by {addr} [{cfg['network']}]")
        return
    print(f"{len(nfts)} NFT(s) owned by {addr} [{cfg['network']}]")
    for n in nfts:
        uri_txt = C.decode_nft_uri(n.get("URI", ""), 90)
        flags = int(n.get("Flags", 0) or 0)
        names = [C.NFT_MINT_FLAG_NAMES[b]
                 for b in sorted(C.NFT_MINT_FLAG_NAMES) if flags & b]
        print(f"  {n.get('NFTokenID')}")
        print(f"    uri:   {uri_txt}")
        print(f"    taxon: {n.get('NFTokenTaxon')}  "
              f"flags: {', '.join(names) or 'none'}")
        issuer = n.get("Issuer")
        if issuer:
            print(f"    issuer: {issuer}")


def cmd_nft_buy(args, cfg, client):
    """Verify an NFT sell offer from the ledger, then PROPOSE accepting
    it. The on-ledger verification (seller, token URI, taxon, price) is
    printed BEFORE the proposal so the human reviews facts — never
    trust the picture. The signer re-verifies before signing."""
    acct = need_account(cfg)
    idx = args.offer_index.strip()
    lines, denials, amount = C.nft_sell_offer_report(client, idx)
    print("=" * 60)
    print("SELL-OFFER VERIFICATION — read from the ledger just now.")
    print("Verify the SELLER is the minter you expect: anyone can mint")
    print("the same artwork. This skill reports on-ledger facts; it does")
    print("NOT authenticate art.")
    print("=" * 60)
    for ln in lines:
        print("  " + ln)
    print("=" * 60)
    if denials:
        for d in denials:
            print(f"  ✗ {d}")
        sys.exit("nft-buy refused: " + "; ".join(denials))
    provisional_spend_check({"XRP": amount})
    tx = NFTokenAcceptOffer(account=acct, nftoken_sell_offer=idx.upper())
    propose(tx, client, cfg, "nft-buy",
            ["buy:      accept the sell offer above",
             f"max spend: {amount} XRP (+ fee)",
             "note:     the signer re-verifies the offer from the ledger",
             "          before signing — a cancelled/changed offer is denied"])


def cmd_nft_bid(args, cfg, client):
    """PROPOSE a buy-side NFTokenCreateOffer (a bid) on someone else's
    NFT. v1: XRP-denominated only, Expiration always required. The bid
    XRP is locked in the offer until it is accepted, cancelled, or
    expires — the signer counts it toward spend limits."""
    acct = need_account(cfg)
    nid = args.token_id.strip()
    if len(nid) != 64 or any(c not in "0123456789abcdefABCDEF" for c in nid):
        sys.exit("token id must be 64 hex characters")
    seller = args.seller
    if not C.is_valid_classic_address(seller):
        sys.exit("seller is not a valid classic address "
                 "(base58 checksum failed)")
    if seller == acct:
        sys.exit("seller is your own account — use nft-list to sell your own "
                 "NFT")
    price = C.dec(args.price_xrp, "price")
    tx = NFTokenCreateOffer(
        account=acct,
        nftoken_id=nid.upper(),
        amount=xrp_to_drops(price),
        owner=seller,
        expiration=C.ripple_time_from_now(args.expires_in),
    )
    propose(tx, client, cfg, "nft-bid",
            [f"token:    {nid.upper()}",
             f"bid:      {price} XRP (BUY offer — locked until accepted, "
             "cancelled, or expired)",
             f"seller:   {seller} (only they can accept)",
             "note:     policy must enable nft.allow_buy_offers for this to "
             "sign"])


def cmd_favorites(args):
    """Local named watchlist of artist wallets. Entirely local: no
    network, no proposals, no signing. Names are lowercase
    [a-z0-9_-], 1-32 chars; addresses get the real base58-checksum
    validation."""
    try:
        favs = C.load_favorites()
    except C.FavoritesError as e:
        sys.exit(str(e))
    cmd = args.fav_cmd
    if cmd == "add":
        problem = C.validate_favorite_name(args.name)
        if problem:
            sys.exit(problem)
        if args.name in favs:
            sys.exit(f"favorite {args.name!r} already exists "
                     f"({favs[args.name].get('address')}) — "
                     "remove it first to re-add")
        if not C.is_valid_classic_address(args.address):
            sys.exit("address is not a valid classic address "
                     "(base58 checksum failed)")
        favs[args.name] = {"address": args.address,
                           "added_at": int(time.time()),
                           "last_checked_ledger": None}
        if args.note:
            favs[args.name]["note"] = args.note
        C.save_favorites(favs)
        print(f"favorite {args.name!r} → {args.address}")
    elif cmd == "remove":
        if args.name not in favs:
            sys.exit(f"no favorite named {args.name!r}")
        del favs[args.name]
        C.save_favorites(favs)
        print(f"removed favorite {args.name!r}")
    elif cmd == "rename":
        if args.old not in favs:
            sys.exit(f"no favorite named {args.old!r}")
        problem = C.validate_favorite_name(args.new)
        if problem:
            sys.exit(problem)
        if args.new in favs:
            sys.exit(f"favorite {args.new!r} already exists")
        favs[args.new] = favs.pop(args.old)
        C.save_favorites(favs)
        print(f"renamed {args.old!r} → {args.new!r}")
    elif cmd == "list":
        if not favs:
            print("no favorites yet — add one with: "
                  "xrpl-trade favorites add <name> <r-address>")
            return
        for name in sorted(favs):
            f = favs[name]
            added = time.strftime("%Y-%m-%d",
                                  time.gmtime(f.get("added_at", 0)))
            note = f"  ({f['note']})" if f.get("note") else ""
            print(f"  {name} → {f.get('address')}  added {added}{note}")
    else:  # pragma: no cover — argparse restricts choices
        sys.exit(f"unknown favorites command {cmd!r}")


def cmd_nft_new(args, cfg, client):
    """Read-only: what's new from favorite artists.

    For each favorite, finds NFTokenMint transactions since its
    per-favorite watermark (first run: last 7 days) and reports the
    token, mint time, current listing price if any, and an xrp.cafe
    link. The watermark then advances to the validated ledger.
    --days N is a pure window scan and does NOT move the watermark."""
    days = args.days
    if days is not None and not 1 <= days <= 90:
        sys.exit("--days must be between 1 and 90")
    try:
        favs = C.load_favorites()
    except C.FavoritesError as e:
        sys.exit(str(e))
    if not favs:
        print("no favorites yet — add one with: "
              "xrpl-trade favorites add <name> <r-address>")
        return
    now = int(time.time())
    validated, problem = C.get_validated_ledger(client)
    if problem:
        sys.exit(problem)
    for name in sorted(favs):
        fav = favs[name]
        addr = fav.get("address") or "?"
        if days is not None:
            cutoff, stop_ledger = now - days * 86400, None
            window = f"last {days}d"
        else:
            wm = fav.get("last_checked_ledger")
            if wm is None:
                cutoff, stop_ledger = now - 7 * 86400, None
                window = "last 7d (first check)"
            else:
                cutoff, stop_ledger = None, wm
                window = f"since ledger {wm}"
        mints, _pages, problem = C.scan_artist_mints(
            client, addr, stop_ledger=stop_ledger, cutoff_unix=cutoff)
        tag = f"{name} ({C.short_addr(addr)})"
        if problem:
            print(f"{tag} — note: {problem}")
            continue
        if not mints:
            print(f"{tag} — nothing new ({window})")
        else:
            print(f"{tag} — {len(mints)} new ({window}):")
            for m in mints:
                tids = m["token_ids"]
                nid = tids[0] if tids else None
                when = (time.strftime("%Y-%m-%d %H:%M UTC",
                                      time.gmtime(m["date_unix"]))
                        if m["date_unix"] else "unknown time")
                print(f"  • {nid or '<token id not found in metadata>'}")
                print(f"    minted:  {when}   taxon: {m['taxon']}")
                print(f"    uri:     {C.decode_nft_uri(m['uri_hex'], 80)}")
                if nid:
                    price, perr = C.nft_sell_price(client, nid)
                    link = C.XRP_CAFE_NFT_URL.format(nid)
                    if perr:
                        print(f"    listing: unknown ({perr})")
                    elif price:
                        print(f"    listing: {price}")
                    else:
                        print("    listing: not listed")
                    print(f"             {link}")
        if days is None:
            fav["last_checked_ledger"] = validated
    if days is None:
        C.save_favorites(favs)


def cmd_setup(_args):
    print("XRPL setup (v0.5). This stores ONLY your address and network.")
    print("The seed is never stored by xrpl-trade. In production the Muse")
    print("vault provides XRPL_SEED to the signer after human approval.\n")
    net = input("network [mainnet/testnet/devnet] (testnet): ").strip() or "testnet"
    if net not in C.NETWORKS:
        sys.exit("unknown network")
    address = input("classic address (r...): ").strip()
    if not C.is_valid_classic_address(address):
        sys.exit("not a valid XRPL classic address (base58 checksum failed)")
    C.XRPL_DIR.mkdir(parents=True, exist_ok=True)
    cfg = {}
    if C.CONFIG_PATH.exists():
        cfg = json.loads(C.CONFIG_PATH.read_text())
    cfg.update({"network": net, "address": address})
    cfg.pop("seed", None)  # v0.2: the proposer never keeps the seed
    C.CONFIG_PATH.write_text(json.dumps(cfg, indent=2))
    os.chmod(C.CONFIG_PATH, 0o600)
    print(f"\nSaved address {address} on {net}.")
    print("Next: xrpl-sign init-policy   (creates the signer policy)")


def cmd_faucet(args, cfg, _client):
    net = args.network or cfg.get("network", "testnet")
    if net == "mainnet":
        sys.exit("No faucet on mainnet.")
    import httpx
    r = httpx.post(f"https://faucet.altnet.rippletest.net/accounts"
                   if net == "testnet" else
                   "https://faucet.devnet.rippletest.net/accounts",
                   json={}, timeout=30.0)
    r.raise_for_status()
    acct = r.json()["account"]
    address = acct.get("classicAddress") or acct["address"]
    print(f"address: {address}\nseed: {r.json()['seed']}")
    print("Save the seed in your vault/secret manager — never in chat,")
    print("never in a file the agent reads. Then:")
    print("  xrpl-trade setup            # register the address")


# ---------- main ----------

def main():
    ap = argparse.ArgumentParser(prog="xrpl-trade",
                                 description="XRPL proposer: builds tx, never signs.")
    ap.add_argument("--network", choices=list(C.NETWORKS),
                    help="override configured network")
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("setup", help="store address+network (no seed in v0.2)")
    p = sub.add_parser("balance", help="XRP + trustline balances")
    p.add_argument("address", nargs="?", help="classic address (default: configured)")
    p = sub.add_parser("quote", help="order book for any pair")
    p.add_argument("--pair", default=None)
    p.add_argument("--base", default="XRP"); p.add_argument("--quote", default="RLUSD")
    p.add_argument("--base-issuer", default=None); p.add_argument("--quote-issuer", default=None)
    p.add_argument("--limit", type=int, default=5)
    sub.add_parser("pairs", help="list approved trading pairs")
    p = sub.add_parser("inspect-token", help="issuer risk: domain, transfer fee, freeze flags")
    p.add_argument("--currency", required=True); p.add_argument("--issuer", required=True)
    p = sub.add_parser("plan-trade", help="estimate fill, impact, max spend (read-only)")
    p.add_argument("--pair", default=None)
    p.add_argument("--base", default="XRP"); p.add_argument("--quote", default="RLUSD")
    p.add_argument("--base-issuer", default=None); p.add_argument("--quote-issuer", default=None)
    p.add_argument("--side", required=True, choices=["buy", "sell"])
    p.add_argument("--amount", required=True); p.add_argument("--price", required=True)
    p = sub.add_parser("reconcile", help="validated outcome of a submitted tx hash")
    p.add_argument("--hash", required=True)

    def add_offer(p_):
        p_.add_argument("--pair", default=None)
        p_.add_argument("--base", default="XRP"); p_.add_argument("--quote", default="RLUSD")
        p_.add_argument("--base-issuer", default=None); p_.add_argument("--quote-issuer", default=None)
        p_.add_argument("--amount", required=True, help="amount of BASE")
        p_.add_argument("--price", required=True, help="QUOTE per BASE")
        p_.add_argument("--expires-in", type=int, default=3600,
                       help="offer expiry seconds (default 3600)")

    p = sub.add_parser("buy", help="PROPOSE buy BASE with QUOTE at limit price")
    add_offer(p)
    p = sub.add_parser("sell", help="PROPOSE sell BASE for QUOTE at limit price")
    add_offer(p)
    p = sub.add_parser("trustline", help="PROPOSE a trustline")
    p.add_argument("--pair", default=None)
    p.add_argument("--currency", default="RLUSD"); p.add_argument("--issuer", default=None)
    p.add_argument("--limit", default="1000000")
    p = sub.add_parser("cancel", help="PROPOSE cancelling an open offer")
    p.add_argument("--seq", required=True, type=int)
    p = sub.add_parser("send", help="PROPOSE sending XRP or an IOU")
    p.add_argument("--to", required=True); p.add_argument("--amount", required=True)
    p.add_argument("--ccy", default="XRP"); p.add_argument("--issuer", default=None)
    p.add_argument("--destination-tag", default=None, type=int)
    p = sub.add_parser("faucet", help="fund a fresh testnet/devnet wallet")
    p.add_argument("--network", choices=["testnet", "devnet"], default=None)
    p = sub.add_parser("nft-mint", help="PROPOSE minting an NFT (pins art to "
                                       "IPFS via your Pinata key)")
    p.add_argument("--file", required=True, help="artwork file to pin")
    p.add_argument("--name", required=True, help="NFT name")
    p.add_argument("--description", default="",
                   help="NFT description (goes in the metadata JSON)")
    p.add_argument("--royalty-bps", default=1000, type=int,
                   help="creator royalty in basis points, 0..5000 "
                        "(default 1000 = 10%%; IMMUTABLE after mint)")
    p.add_argument("--taxon", default=0, type=int,
                   help="NFTokenTaxon grouping id (default 0)")
    p = sub.add_parser("nft-list", help="PROPOSE listing an owned NFT for "
                                       "sale (XRP only, sell offer)")
    p.add_argument("--token-id", required=True,
                   help="NFTokenID (64 hex chars)")
    p.add_argument("--price-xrp", required=True, help="asking price in XRP")
    p.add_argument("--destination", default=None,
                   help="optional buyer address for a private sale")
    p.add_argument("--expires-in", type=int, default=86400,
                   help="listing expiry seconds (default 86400)")
    p = sub.add_parser("nft-inventory", help="list NFTs owned by an account "
                                            "(read-only)")
    p.add_argument("address", nargs="?",
                   help="classic address (default: configured)")
    p = sub.add_parser("nft-buy", help="verify an NFT sell offer, then PROPOSE "
                                      "accepting it (XRP only)")
    p.add_argument("--offer-index", required=True,
                   help="sell offer index (64 hex chars)")
    p = sub.add_parser("nft-bid", help="PROPOSE a buy offer (bid) on someone "
                                      "else's NFT (XRP only)")
    p.add_argument("--token-id", required=True,
                   help="NFTokenID (64 hex chars)")
    p.add_argument("--seller", required=True,
                   help="owner's classic address (only they can accept)")
    p.add_argument("--price-xrp", required=True, help="bid in XRP")
    p.add_argument("--expires-in", type=int, default=86400,
                   help="bid expiry seconds (default 86400)")
    p = sub.add_parser("favorites", help="named watchlist of artist wallets "
                                         "(local, read-only)")
    fav = p.add_subparsers(dest="fav_cmd", required=True)
    a = fav.add_parser("add", help="watch an artist wallet")
    a.add_argument("name", help="short name, e.g. lara")
    a.add_argument("address", help="artist's classic r-address")
    a.add_argument("--note", default=None, help="optional note")
    r = fav.add_parser("remove", help="stop watching a wallet")
    r.add_argument("name")
    fav.add_parser("list", help="show the watchlist")
    rn = fav.add_parser("rename", help="rename a favorite")
    rn.add_argument("old")
    rn.add_argument("new")
    p = sub.add_parser("nft-new", help="new mints from favorite artists "
                                       "(read-only)")
    p.add_argument("--days", type=int, default=None,
                   help="window in days, 1-90 (default: since last check; "
                        "--days never moves the watermark)")

    args = ap.parse_args()
    if args.cmd == "favorites":
        # Local-only: no config, no network client needed.
        cmd_favorites(args)
        return
    cfg = load_config()
    network = args.network or cfg.get("network", "testnet")
    if network not in C.NETWORKS:
        sys.exit(f"unknown network {network!r}")
    cfg["network"] = network
    client = get_client(network)

    {
        "setup": lambda: cmd_setup(args),
        "balance": lambda: cmd_balance(args, cfg, client),
        "quote": lambda: cmd_quote(args, cfg, client),
        "pairs": lambda: cmd_pairs(args, cfg, client),
        "inspect-token": lambda: cmd_inspect_token(args, cfg, client),
        "plan-trade": lambda: cmd_plan_trade(args, cfg, client),
        "reconcile": lambda: cmd_reconcile(args, cfg, client),
        "buy": lambda: cmd_buy(args, cfg, client),
        "sell": lambda: cmd_sell(args, cfg, client),
        "trustline": lambda: cmd_trustline(args, cfg, client),
        "cancel": lambda: cmd_cancel(args, cfg, client),
        "send": lambda: cmd_send(args, cfg, client),
        "faucet": lambda: cmd_faucet(args, cfg, client),
        "nft-mint": lambda: cmd_nft_mint(args, cfg, client),
        "nft-list": lambda: cmd_nft_list(args, cfg, client),
        "nft-inventory": lambda: cmd_nft_inventory(args, cfg, client),
        "nft-buy": lambda: cmd_nft_buy(args, cfg, client),
        "nft-bid": lambda: cmd_nft_bid(args, cfg, client),
        "nft-new": lambda: cmd_nft_new(args, cfg, client),
    }[args.cmd]()


if __name__ == "__main__":
    main()
