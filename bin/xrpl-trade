#!/usr/bin/env python3
"""xrpl-trade v0.6: the PROPOSER half of the hardened XRPL skill.

This program NEVER submits a transaction. Write commands (buy/sell/trustline/cancel/send/nft-pin-and-propose/nft-list/nft-send/nft-buy/nft-bid)
Write commands (buy/sell/trustline/cancel/send/nft-pin-and-propose/nft-list/nft-send/nft-buy/nft-bid)
build the
transaction, autofill it against the live network, print the full ceremony
summary (account, network, assets+issuers, amounts, limit price, max spend,
fee, expiry), hash the exact bytes-to-be-approved, and save a proposal.

One deliberate exception: `wallet create` generates a fresh wallet locally
and stores the seed in ~/.xrpl/config.json (0600, atomic) WITHOUT ever
displaying it — the "local signer" deployment profile. The seed is shown
exactly once, and only, by `wallet backup`, for write-down. See "Wallets"
in SKILL.md and the platform boundary in SECURITY.md.

The separate `xrpl-sign` program enforces policy and signs — only after
independent human approval of that exact hash.

Read-only: balance, quote, offers, pairs, inspect-token, plan-trade, reconcile,
nft-inventory, favorites, nft-new, xrpresso (XRPresso marketplace discovery),
giveaway entrants/draw/status/announce (Friday community giveaway).
Local-only: profile (onboarding questionnaire — name, watch-only addresses,
memberships, interests; never leaves this machine), giveaway setup,
nft-stage (artwork validation + hashing before any pin).
Writing always proposes: buy/sell/trustline/cancel/send/nft-pin-and-propose/nft-list/
nft-send/nft-buy/nft-bid, plus giveaway opt-in (proposes the 1-drop entry
payment — approval is still required, and opt-in is only recorded after
the payment is validated on-ledger), plus giveaway gift (proposes a prize
payment from the donation wallet — signed only after the human approves
that exact hash, under the giveaway policy with the donation wallet's key).
The draw only SELECTS a winner — it never builds or sends a gift.
NFT: nft-stage validates + hashes artwork LOCALLY (zero network) and
writes a reviewable stage record; nft-pin-and-propose pins the staged
artwork + metadata to IPFS with the operator's own Pinata key
(bring-your-own-key — the skill never hosts anyone's media), then
proposes the mint. Pinning is an external write, so it lives in the
second, explicitly-run step — never hidden inside a single command.
nft-list proposes an XRP-denominated sell offer.
"""
import argparse
import asyncio
import hashlib
import hmac
import json
import os
import sys
import time
from decimal import Decimal, ROUND_DOWN
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import xrpl_common as C
import xrpl_xrpresso as XP

try:
    from xrpl.clients import JsonRpcClient
    from xrpl.models.amounts import IssuedCurrencyAmount
    from xrpl.models.currencies import IssuedCurrency, XRP
    from xrpl.models.requests import (
        AccountInfo, AccountLines, AccountOffers, BookOffers, ServerInfo, Tx,
        AccountNFTs,
    )
    from xrpl.models.transactions import OfferCancel, OfferCreate, Payment, TrustSet
    from xrpl.models.transactions import (NFTokenAcceptOffer,
                                          NFTokenCreateOffer,
                                          NFTokenCreateOfferFlag,
                                          NFTokenMint, NFTokenMintFlag)
    from xrpl.transaction import autofill
    from xrpl.utils import drops_to_xrp, xrp_to_drops
except ImportError:
    sys.exit("xrpl-py not installed. Run: pip install -r requirements.txt")

try:
    import xrpl_pin
except ImportError:
    xrpl_pin = None  # NFT minting unavailable; other commands unaffected


# ---------- config / client ----------

def load_config():
    cfg = {}
    if C.CONFIG_PATH.exists():
        cfg = json.loads(C.CONFIG_PATH.read_text())
    cfg["address"] = os.environ.get("XRPL_ADDRESS") or cfg.get("address")
    cfg["network"] = os.environ.get("XRPL_NETWORK") or cfg.get("network", "testnet")
    return cfg


def get_client(network):
    def _request(self, request):
        return asyncio.run(self._request_impl(request, timeout=30.0))

    last_err = None
    for url in C.NETWORKS[network]:
        c = JsonRpcClient(url)
        c.request = _request.__get__(c, JsonRpcClient)
        for attempt in range(3):
            try:
                if c.request(ServerInfo()).is_successful():
                    return c
                break
            except Exception as e:  # noqa: BLE001
                last_err = e
                time.sleep(1 + attempt)
    sys.exit(f"No healthy {network} node ({last_err}).")


# ---------- builders (pure: no network, no signing) ----------

def iou_amount(currency, issuer, value: Decimal):
    return IssuedCurrencyAmount(
        currency=C.currency_code(currency), issuer=issuer, value=format(value, "f"))


def make_amount(ccy, issuer, value: Decimal):
    if ccy == "XRP":
        return xrp_to_drops(value)
    if not issuer:
        sys.exit(f"issuer required for {ccy} "
                 f"(pass --base-issuer/--quote-issuer or use --pair)")
    return iou_amount(ccy, issuer, value)


def make_currency(ccy, issuer):
    if ccy == "XRP":
        return XRP()
    if not issuer:
        sys.exit(f"issuer required for {ccy}")
    return IssuedCurrency(currency=C.currency_code(ccy), issuer=issuer)


def build_gift_payment(donation_wallet, dest, amount: Decimal, ccy, issuer):
    """Pure builder: a gift Payment FROM the donation wallet. Never signs."""
    return Payment(account=donation_wallet, destination=dest,
                   amount=make_amount(ccy, issuer, amount))


def build_gift_nft_offer(donation_wallet, dest, token_id, expires_in=86400):
    """Pure builder: a 0-XRP destination-restricted NFTokenCreateOffer gift
    (transfer, never a sale) FROM the donation wallet. Never signs."""
    return NFTokenCreateOffer(
        account=donation_wallet,
        nftoken_id=token_id.strip().upper(),
        amount="0",  # 0 drops: gift transfer, NOT a sale
        destination=dest,
        expiration=C.ripple_time_from_now(expires_in),
        flags=int(NFTokenCreateOfferFlag.TF_SELL_NFTOKEN),
    )


def donation_wallet_owns_nft(client, wallet, token_id):
    """Fail-closed check that the donation wallet owns the NFT (marker-paged)."""
    marker = None
    while True:
        kw = {"account": wallet, "limit": 400, "ledger_index": "validated"}
        if marker:
            kw["marker"] = marker
        try:
            resp = client.request(AccountNFTs(**kw))
        except Exception as e:  # noqa: BLE001
            sys.exit(f"gift: NFT ownership lookup failed: {e}")
        if not resp.is_successful():
            sys.exit("gift: NFT ownership lookup failed — refusing")
        res = resp.result or {}
        # Item 2 standard: ledger_index="validated" is a request, not a
        # guarantee — refuse the data unless the node confirms it.
        if res.get("validated") is not True:
            sys.exit("gift: NFT ownership lookup returned unvalidated "
                     "ledger data — refusing")
        for n in res.get("account_nfts", []):
            if n.get("NFTokenID") == token_id:
                return True
        marker = res.get("marker")
        if not marker:
            return False


def build_offer_tx(account, base, base_issuer, quote, quote_issuer,
                  amount: Decimal, price: Decimal, side: str, expires_in: int):
    """side=buy: BUY base, SELL quote (TakerPays=base amount, TakerGets=quote cost).
    side=sell: SELL base, BUY quote (TakerPays=quote proceeds, TakerGets=base amount).
    (XRPL: TakerPays is the currency the offer creator BUYS; TakerGets is what they SELL.)"""
    if side == "buy":
        cost = (amount * price).quantize(Decimal("0.000001"), rounding=ROUND_DOWN)
        taker_pays = make_amount(base, base_issuer, amount)
        taker_gets = make_amount(quote, quote_issuer, cost)
    elif side == "sell":
        proceeds = (amount * price).quantize(Decimal("0.000001"), rounding=ROUND_DOWN)
        taker_pays = make_amount(quote, quote_issuer, proceeds)
        taker_gets = make_amount(base, base_issuer, amount)
    else:
        sys.exit("side must be buy or sell")
    return OfferCreate(
        account=account, taker_pays=taker_pays, taker_gets=taker_gets,
        expiration=C.ripple_time_from_now(expires_in))


def fmt_amt(a):
    if isinstance(a, dict):
        return f"{a['value']} {C.display_currency(a['currency'])}.{a['issuer'][:8]}…"
    return f"{drops_to_xrp(a)} XRP"


# ---------- ceremony ----------

def propose(tx, client, cfg, action, summary_lines):
    """Autofill, hash into a bound envelope, save. Never submits."""
    filled = autofill(tx, client)
    txd = filled.to_xrpl()  # PascalCase wire format (to_dict() is snake_case)
    # Unsigned proposals must not carry signature material — autofill adds
    # an empty SigningPubKey, which the signer's envelope invariants reject.
    txd.pop("SigningPubKey", None)
    txd.pop("TxnSignature", None)
    lines = [
        f"network:  {cfg['network']}",
        f"account:  {txd['Account']}",
        f"action:   {action}",
        *summary_lines,
        f"fee:      {drops_to_xrp(txd['Fee'])} XRP",
        f"sequence: {txd['Sequence']}",
        f"last_ledger: {txd.get('LastLedgerSequence', 'n/a')}",
    ]
    if "Expiration" in txd:
        exp = time.strftime("%Y-%m-%dT%H:%M:%SZ",
                            time.gmtime(txd["Expiration"] + C.RIPPLE_EPOCH))
        lines.append(f"expires:  {exp}")
    # P1-1 approval binding: the proposal is bound to the signing profile
    # (account+network+credential+policy+state) and the exact policy digest
    # the human reviews against. The signer rejects cross-profile use.
    prof_name, _prof, _ppath, pdigest = C.resolve_proposal_profile(
        cfg["network"], txd["Account"], action)
    h, _ = C.save_proposal(txd, cfg["network"], txd["Account"], action,
                           profile=prof_name, policy_sha256=pdigest)
    print("=" * 60)
    print("PROPOSAL — review carefully. Nothing has been submitted.")
    print("=" * 60)
    for ln in lines:
        print("  " + ln)
    print("=" * 60)
    print(f"proposal hash: {h}")
    print(f"\nA HUMAN must review the hash above, then run:")
    print(f"  bound profile: {prof_name} (policy sha256 {pdigest[:16]}…)")
    if action == C.GIFT_ACTION:
        # Donation-wallet gifts sign under the giveaway policy with the
        # giveaway seed — never the main wallet's key or policy.
        print(f"  {C.giveaway_sign_command(h, prof_name)}")
        if C.GIVEAWAY_POLICY_PATH.exists():
            print(f"\nGiveaway policy: {C.GIVEAWAY_POLICY_PATH}")
        else:
            print(f"\nGiveaway policy: {C.GIVEAWAY_POLICY_PATH} "
                  "(missing — run `giveaway setup` first)")
        print(f"Seed: {C.GIVEAWAY_SEED_ENV} (vault-injected) or `giveaway setup`")
    else:
        if prof_name == "adhoc-testnet":
            print(f"  xrpl-sign --hash {h} --approve")
        else:
            print(f"  xrpl-sign --profile {prof_name} --hash {h} --approve")
    print(f"\nFull autofilled transaction saved to:\n"
          f"  {C.PROPOSALS_DIR / (h + '.json')}")
    return h


# ---------- read commands ----------

def cmd_balance(args, cfg, client):
    addr = args.address or cfg.get("address")
    if not addr:
        sys.exit("No address. Pass one or run `xrpl-trade setup`.")
    info = client.request(AccountInfo(account=addr, ledger_index="validated"))
    if not info.is_successful():
        sys.exit(f"AccountInfo failed: {info.result}")
    print(f"XRP: {drops_to_xrp(info.result['account_data']['Balance'])}")
    lines = client.request(AccountLines(account=addr, ledger_index="validated"))
    if lines.is_successful():
        for l in lines.result.get("lines", []):
            if Decimal(l["balance"]) != 0:
                print(f"{l['currency']}.{l['account'][:8]}…: {l['balance']} "
                      f"(limit {l['limit']})")


def book_side(client, gets, pays, limit):
    r = client.request(BookOffers(taker_gets=gets, taker_pays=pays,
                                  limit=limit, ledger_index="validated"))
    if not r.is_successful():
        sys.exit(f"BookOffers failed: {r.result}")
    return r.result.get("offers", [])


def amt_value(a):
    if isinstance(a, dict):
        return Decimal(a["value"]), C.display_currency(a["currency"])
    return Decimal(drops_to_xrp(a)), "XRP"


def funded_amt(offer, field):
    """P1-5: the funded quantity of a book level. Prefers the funded field
    (taker_gets_funded/taker_pays_funded) when present; a present-but-zero
    funded value means no real liquidity (never falls back to nominal).
    Returns (Decimal, currency-display)."""
    funded_key = {"TakerGets": "taker_gets_funded",
                  "TakerPays": "taker_pays_funded"}[field]
    if funded_key in offer:
        f = offer[funded_key]
        if isinstance(f, dict):
            return Decimal(f["value"]), C.display_currency(f["currency"])
        return Decimal(drops_to_xrp(f)), "XRP"
    return amt_value(offer[field])


def cmd_quote(args, cfg, client):
    base, base_issuer, quote, quote_issuer = C.resolve_pair(args)
    base_amt = make_currency(base, base_issuer)
    quote_amt = make_currency(quote, quote_issuer)
    asks = book_side(client, base_amt, quote_amt, args.limit)
    bids = book_side(client, quote_amt, base_amt, args.limit)
    print(f"--- {base}/{quote} asks (sell {base}) ---")
    for o in asks:
        qv, _ = amt_value(o["TakerPays"]); bv, _ = amt_value(o["TakerGets"])
        print(f"  {fmt_amt(o['TakerGets'])} @ {qv / bv:.6f} {quote}")
    print(f"--- {base}/{quote} bids (buy {base}) ---")
    for o in bids:
        qv, _ = amt_value(o["TakerGets"]); bv, _ = amt_value(o["TakerPays"])
        print(f"  {fmt_amt(o['TakerPays'])} @ {qv / bv:.6f} {quote}")


def cmd_pairs(args, cfg, client):
    pairs = C.load_approved()
    if not pairs:
        print(f"No approved pairs. Copy approved.example.json to {C.APPROVED_PATH}.")
        return
    for name in sorted(pairs):
        p = pairs[name]
        print(f"{name}: {p['base']} ({(p.get('base_issuer') or 'native')[:12]}) / "
              f"{p['quote']} ({(p.get('quote_issuer') or 'native')[:12]})")


def cmd_offers(args, cfg, client):
    addr = args.address or cfg.get("address")
    if not addr:
        sys.exit("No address. Pass one or run `xrpl-trade setup`.")
    r = client.request(AccountOffers(account=addr, ledger_index="validated"))
    if not r.is_successful():
        sys.exit(f"AccountOffers failed: {r.result}")
    offers = r.result.get("offers", [])
    if not offers:
        print("No open offers.")
        return
    for o in offers:
        print(f"seq={o['seq']} {fmt_amt(o['taker_gets'])} <- {fmt_amt(o['taker_pays'])}")


def cmd_inspect_token(args, cfg, client):
    ccy, issuer = args.currency.upper(), args.issuer
    r = client.request(AccountInfo(account=issuer, ledger_index="validated"))
    if not r.is_successful():
        sys.exit(f"Issuer account not found: {r.result}")
    ad = r.result["account_data"]
    flags = int(ad.get("Flags", 0))
    rate = int(ad.get("TransferRate", 1000000000))
    fee_pct = (rate - 1000000000) / 10000000
    domain = ad.get("Domain")
    if domain:
        try:
            domain = bytes.fromhex(domain).decode()
        except ValueError:
            pass
    print(f"token:  {ccy}.{issuer}")
    print(f"domain: {domain or 'NOT SET (no toml verification possible)'}")
    print(f"transfer fee: {fee_pct:.3f}%")
    print(f"global freeze: {'YES — issuer can freeze all holders' if flags & 0x00400000 else 'no'}")
    print(f"no-freeze enabled: {'yes (issuer gave up freeze power)' if flags & 0x00200000 else 'no'}")


def cmd_plan_trade(args, cfg, client):
    base, base_issuer, quote, quote_issuer = C.resolve_pair(args)
    amount = C.dec(args.amount, "amount")
    price = C.dec(args.price, "price")
    side = args.side
    base_amt = make_currency(base, base_issuer)
    quote_amt = make_currency(quote, quote_issuer)
    # walk the side we'd take from: buys take asks, sells take bids
    if side == "buy":
        book = book_side(client, base_amt, quote_amt, 50)  # asks
        get_f, pay_f = "TakerGets", "TakerPays"
    else:
        book = book_side(client, quote_amt, base_amt, 50)  # bids
        get_f, pay_f = "TakerPays", "TakerGets"
    if not book:
        sys.exit("Empty book — no liquidity.")
    # P1-5: preview on FUNDED amounts, like the signer's guard.
    best_q, best_b = funded_amt(book[0], pay_f), funded_amt(book[0], get_f)
    mid = best_q[0] / best_b[0]
    dev = (price - mid) / mid * 100
    # walk depth at-or-better than our limit
    filled_base = Decimal(0); spent_quote = Decimal(0)
    for o in book:
        qv, _ = funded_amt(o, pay_f); bv, _ = funded_amt(o, get_f)
        if bv == 0:
            continue  # unfunded level: no real liquidity
        px = qv / bv
        if (side == "buy" and px > price) or (side == "sell" and px < price):
            break
        take = min(bv, amount - filled_base)
        filled_base += take; spent_quote += take * px
        if filled_base >= amount:
            break
    pct = filled_base / amount * 100
    avg = spent_quote / filled_base if filled_base else Decimal(0)
    max_spend = (amount * price).quantize(Decimal("0.000001"), rounding=ROUND_DOWN)
    print(f"plan: {side} {amount} {base} @ limit {price} {quote} [{cfg['network']}]")
    print(f"book mid: {mid:.6f} {quote}  (limit is {dev:+.2f}% vs mid)")
    print(f"est. fill at limit: {filled_base} {base} ({pct:.1f}%)")
    if filled_base:
        print(f"avg fill price: {avg:.6f} {quote}")
    print(f"max spend: {max_spend} {quote}")
    if pct < 100:
        print("NOTE: book is thin at this limit — expect a partial fill, "
              "rest becomes a resting offer.")


def cmd_reconcile(args, cfg, client):
    r = client.request(Tx(transaction=args.hash))
    if not r.is_successful():
        sys.exit(f"tx lookup failed: {r.result}")
    res = r.result
    meta = res.get("meta", {})
    validated = res.get("validated", False)
    print(f"hash:      {args.hash}")
    print(f"validated: {validated}")
    print(f"result:    {meta.get('TransactionResult', '?')}")
    print(f"ledger:    {res.get('ledger_index', '?')}")


# ---------- write commands (propose only) ----------

def need_account(cfg):
    if not cfg.get("address"):
        sys.exit("No address configured. Run `xrpl-trade setup` first.")
    return cfg["address"]


def cmd_buy(args, cfg, client):
    acct = need_account(cfg)
    base, bi, quote, qi = C.resolve_pair(args)
    amt = C.dec(args.amount, "amount"); price = C.dec(args.price, "price")
    cost = (amt * price).quantize(Decimal("0.000001"), rounding=ROUND_DOWN)
    tx = build_offer_tx(acct, base, bi, quote, qi, amt, price, "buy",
                        args.expires_in)
    propose(tx, client, cfg, "buy",
            [f"side:   BUY {amt} {base}",
             f"price:  {price} {quote} per {base}",
             f"max spend: {cost} {quote}"])


def cmd_sell(args, cfg, client):
    acct = need_account(cfg)
    base, bi, quote, qi = C.resolve_pair(args)
    amt = C.dec(args.amount, "amount"); price = C.dec(args.price, "price")
    proceeds = (amt * price).quantize(Decimal("0.000001"), rounding=ROUND_DOWN)
    tx = build_offer_tx(acct, base, bi, quote, qi, amt, price, "sell",
                        args.expires_in)
    propose(tx, client, cfg, "sell",
            [f"side:   SELL {amt} {base}",
             f"price:  {price} {quote} per {base}",
             f"min proceeds: {proceeds} {quote}"])


def cmd_trustline(args, cfg, client):
    acct = need_account(cfg)
    if getattr(args, "pair", None):
        base, bi, _, _ = C.resolve_pair(args)
        if base == "XRP":
            sys.exit("XRP needs no trustline.")
        currency, issuer = base, bi
    else:
        currency, issuer = args.currency.upper(), args.issuer
    if not issuer:
        sys.exit("issuer required (pass --issuer or use --pair)")
    limit = C.dec(args.limit, "limit")
    tx = TrustSet(account=acct,
                  limit_amount=iou_amount(currency, issuer, limit))
    propose(tx, client, cfg, "trustline",
            [f"token:  {currency}.{issuer}",
             f"limit:  {limit}"])


def cmd_cancel(args, cfg, client):
    acct = need_account(cfg)
    tx = OfferCancel(account=acct, offer_sequence=int(args.seq))
    propose(tx, client, cfg, "cancel", [f"offer seq: {args.seq}"])


def resolve_destination(to: str, cli_tag):
    """Return (classic_address, tag). Rejects conflicting X-address/CLI tags."""
    from xrpl.core.addresscodec import (
        is_valid_classic_address, is_valid_xaddress,
        xaddress_to_classic_address)
    tag = None
    if is_valid_xaddress(to):
        to, xtag, _ = xaddress_to_classic_address(to)
        tag = xtag
        if cli_tag is not None and xtag is not None and int(cli_tag) != int(xtag):
            sys.exit(f"destination tag conflict: X-address embeds tag {xtag} "
                     f"but --destination-tag {cli_tag} was given — refusing")
    elif not is_valid_classic_address(to):
        sys.exit("destination is not a valid classic address or X-address")
    if cli_tag is not None:
        tag = int(cli_tag)
    return to, tag


def cmd_send(args, cfg, client):
    acct = need_account(cfg)
    dest, tag = resolve_destination(args.to, args.destination_tag)
    amt = C.dec(args.amount, "amount")
    ccy = args.ccy.upper()
    amount = make_amount(ccy, args.issuer, amt)
    tx = Payment(account=acct, destination=dest, amount=amount,
                 destination_tag=tag)
    lines = [f"send:   {amt} {ccy}",
             f"to:     {dest}"]
    if tag is not None:
        lines.append(f"dest tag: {tag}")
    else:
        lines.append("dest tag: NONE — if the recipient is an exchange, "
                     "funds may not be credited. Use --destination-tag.")
    propose(tx, client, cfg, "send", lines)


# ---------- NFT mint: two-step pin flow (v0.6.0 item 5; P1-4 digest-bound) ----------
#
# Pinning is an external write (and an exfiltration vector), so it must
# never happen pre-consent inside a single command. Step 1 (nft-stage)
# is fully local: validate + hash the artwork, compute a STAGE DIGEST
# binding the file bytes, the mint metadata, the minting account and
# network, and the permitted media directory, then write a reviewable
# stage record - ZERO network calls. Step 2 (nft-pin-and-propose) is the
# explicitly-run, approval-gated step: it recomputes the digest from
# CURRENT state and refuses ANY mismatch before contacting Pinata, then
# uploads the EXACT bytes that were hashed (no file reopen - no TOCTOU).
# The human's --approve of the proposal hash approves THAT digest.
# PINATA_JWT is read from the environment only at pin time - never
# stored, logged, or written into proposal files.

STAGE_FORMAT = "nft-stage/2"

# The exact mint flags every staged NFT is minted with. Bound into the
# stage digest so a tampered stage record cannot change mint semantics.
NFT_MINT_FLAGS = (int(NFTokenMintFlag.TF_TRANSFERABLE)
                  | int(NFTokenMintFlag.TF_BURNABLE))


def _compute_stage_digest(file_sha256, name, description, royalty_bps,
                          taxon, mint_flags, account, network, source_path,
                          media_dir):
    """The stage digest: sha256 over canonical JSON binding the artwork
    bytes, the full mint metadata, the mint flags, and the account +
    network that will mint. Any change to any bound value — edited stage
    record, swapped file, different minter or network — produces a
    different digest, and the pin step refuses the mismatch."""
    payload = {
        "file_sha256": file_sha256,
        "name": name,
        "description": description,
        "royalty_bps": int(royalty_bps),
        "taxon": int(taxon),
        "mint_flags": int(mint_flags),
        "account": account,
        "network": network,
        "source_path": source_path,
        "media_dir": media_dir,
    }
    canonical = json.dumps(payload, sort_keys=True,
                           separators=(",", ":")).encode()
    return hashlib.sha256(canonical).hexdigest()


def stage_artwork(file, name, description="", royalty_bps=1000, taxon=0,
                  account=None, network="testnet"):
    """Validate artwork and write a stage record. Zero network calls.

    Returns the stage record dict. The record carries a stage digest
    binding the file's bytes, the mint metadata, the minting account and
    network, and the permitted media directory — nft-pin-and-propose
    recomputes it from current state and refuses ANY mismatch before a
    byte leaves the machine. Raises SystemExit on any refusal.

    Artwork must live inside the protected NFT media directory
    (xrpl_pin.protected_media_dir()); anything outside is refused.
    """
    if xrpl_pin is None:
        sys.exit("xrpl_pin module missing - cannot stage.")
    if not account:
        sys.exit("an account is required to stage (the future minter)")
    royalty_bps = int(royalty_bps)
    if not 0 <= royalty_bps <= 5000:
        sys.exit("royalty must be 0..5000 bps (protocol max is 50%)")
    taxon = int(taxon)
    if not 0 <= taxon <= 0xFFFFFFFF:
        sys.exit("taxon must fit in a uint32")
    if not name or not str(name).strip():
        sys.exit("NFT name is required")
    mdir = xrpl_pin.protected_media_dir()
    data, info = xrpl_pin.read_validated_source(file, media_dir=mdir)
    file_sha256 = hashlib.sha256(data).hexdigest()
    if file_sha256 != info["sha256"]:
        sys.exit("internal error: hash mismatch on validated bytes")
    digest = _compute_stage_digest(
        file_sha256, name, description, royalty_bps, taxon,
        NFT_MINT_FLAGS, account, network, info["path"], info["media_dir"])
    created = int(time.time())
    sid = hashlib.sha256(
        f"{info['sha256']}:{created}:{name}".encode()).hexdigest()[:16]
    record = {
        "format": STAGE_FORMAT,
        "stage_id": sid,
        "created_at": created,
        "source_path": info["path"],
        "sha256": info["sha256"],
        "bytes": info["bytes"],
        "mime": info["mime"],
        "name": name,
        "description": description,
        # The exact metadata that will be pinned; the image CID is filled
        # in at pin time. The human reviews this record before approving.
        "metadata": {"name": name, "description": description,
                     "image": None},
        "royalty_bps": royalty_bps,
        "taxon": taxon,
        # The full stage digest. The pin step recomputes it from CURRENT
        # bytes + CURRENT record values + CURRENT account/network and
        # refuses any mismatch — the stage record is NOT trusted.
        "stage_digest": digest,
        "account": account,
        "network": network,
        # Informational only: the pin step re-resolves the protected
        # media dir itself and ignores this field.
        "media_dir": info["media_dir"],
    }
    C.STAGE_DIR.mkdir(parents=True, exist_ok=True)
    (C.STAGE_DIR / f"{sid}.json").write_text(json.dumps(record, indent=2))
    return record


def load_stage_record(stage_id):
    """Load and sanity-check a stage record. Refuses missing/ambiguous/
    corrupt records - a bad stage never reaches the pin step."""
    matches = (list(C.STAGE_DIR.glob(f"{stage_id}*.json"))
               if C.STAGE_DIR.exists() else [])
    if not matches:
        sys.exit(f"No staged artwork matching {stage_id!r} - run "
                 f"`xrpl-trade nft-stage` first.")
    if len(matches) > 1:
        sys.exit(f"Ambiguous stage id {stage_id!r}: "
                 f"{[m.stem[:12] for m in matches]}")
    try:
        rec = json.loads(matches[0].read_text())
    except (ValueError, OSError) as e:
        sys.exit(f"Stage record unreadable: {e}")
    if not isinstance(rec, dict) or rec.get("format") != STAGE_FORMAT:
        sys.exit("Stage record has an unsupported format - re-run nft-stage "
                 "(old stage records predate the digest binding and are "
                 "not accepted).")
    for key in ("stage_id", "source_path", "sha256", "bytes", "mime",
                "name", "description", "metadata", "royalty_bps", "taxon",
                "stage_digest", "account", "network"):
        if key not in rec:
            sys.exit(f"Stage record is missing {key!r} - re-run nft-stage.")
    if (not isinstance(rec["stage_digest"], str)
            or len(rec["stage_digest"]) != 64
            or any(c not in "0123456789abcdef"
                   for c in rec["stage_digest"])):
        sys.exit("Stage record has a malformed stage digest - re-run "
                 "nft-stage.")
    meta = rec["metadata"]
    if (not isinstance(meta, dict)
            or set(meta) != {"name", "description", "image"}
            or meta["image"] is not None
            or meta["name"] != rec["name"]
            or meta["description"] != rec["description"]):
        sys.exit("Stage record metadata is inconsistent - re-run nft-stage.")
    return rec


def pin_and_propose_stage(stage_id, cfg, client, pinner=None):
    """Pin the staged artwork + metadata, then propose the NFTokenMint.

    The approval-gated step: the human reviewed the stage record and ran
    this command deliberately. Before ANY byte leaves the machine, the
    stage digest is recomputed from the CURRENT file bytes, the CURRENT
    stage-record values, and the CURRENT account/network, and compared
    against the digest recorded at staging time. ANY mismatch — edited
    metadata, swapped file, changed path, different minter or network —
    refuses without contacting Pinata. The upload then sends the EXACT
    bytes that were hashed (no file reopen between hash and upload).

    Prints the full stage digest as part of the approval ceremony: the
    human's --approve of the proposal hash approves THAT digest.
    Returns the proposal hash.
    """
    if xrpl_pin is None:
        sys.exit("xrpl_pin module missing - cannot pin.")
    pinner = pinner or xrpl_pin
    rec = load_stage_record(stage_id)
    # The permitted media directory comes from protected configuration —
    # the stage record's media_dir field is informational only and is
    # NOT trusted here.
    mdir = xrpl_pin.protected_media_dir()
    # Read the artwork ONCE: these are the bytes we hash AND upload.
    data, info = pinner.read_validated_source(
        rec["source_path"], media_dir=mdir)
    file_sha256 = hashlib.sha256(data).hexdigest()
    if file_sha256 != rec["sha256"]:
        sys.exit("refusing: the artwork file changed since staging "
                 "(hash mismatch) - re-run `xrpl-trade nft-stage`.")
    acct = need_account(cfg)
    network = cfg.get("network", "testnet")
    # Recompute the digest from CURRENT state. The stage record is not
    # trusted: any edit to its metadata (or a swapped file, path, minter,
    # or network) fails this check before Pinata is contacted.
    recomputed = _compute_stage_digest(
        file_sha256, rec["name"], rec["description"],
        rec["royalty_bps"], rec["taxon"], NFT_MINT_FLAGS,
        acct, network, info["path"], info["media_dir"])
    if not hmac.compare_digest(recomputed, rec["stage_digest"]):
        sys.exit(
            "refusing: the stage digest does not match what was recorded "
            "at staging time.\n"
            "Something changed after staging: the stage record's metadata "
            "(name, description, royalty, taxon), the artwork file, its "
            "path, the minting account, or the network.\n"
            f"  staged digest:    {rec['stage_digest']}\n"
            f"  recomputed now:   {recomputed}\n"
            "Re-run `xrpl-trade nft-stage` and review the new record "
            "before approving. Pinata was NOT contacted.")
    name = rec["name"]
    print("pinning to IPFS via Pinata (external write):")
    print(f"  stage digest: {rec['stage_digest']}")
    print(f"    ^ the human approval below covers THIS digest. If it does")
    print(f"      not match the digest shown at staging time, STOP.")
    print(f"  file:      {C.safe_terminal_text(info['path'])}")
    print(f"  sha256:    {file_sha256}")
    print(f"  size/mime: {info['bytes']} bytes, {info['mime']}")
    print(f"  name:      {C.safe_terminal_text(name, 120)}")
    print(f"  account:   {acct}")
    print(f"  network:   {network}")
    # TOCTOU-safe: upload the exact bytes that were hashed above. The
    # file is never reopened between the hash check and the upload.
    image_cid = pinner.pin_data(data, os.path.basename(info["path"]))
    meta = dict(rec["metadata"])
    meta["image"] = f"ipfs://{image_cid}"
    metadata_cid = pinner.pin_json(meta, name=f"{name}-metadata.json")
    uri = f"ipfs://{metadata_cid}"
    uri_hex = uri.encode("utf-8").hex().upper()
    if len(uri.encode("utf-8")) > 256:
        sys.exit("metadata URI exceeds the 256-byte ledger limit")
    # XRPL TransferFee is in 1/100000 units: 10000 = 10% = 1000 bps.
    transfer_fee = int(rec["royalty_bps"]) * 10
    tx = NFTokenMint(
        account=acct,
        nftoken_taxon=int(rec["taxon"]),
        uri=uri_hex,
        transfer_fee=transfer_fee,
        flags=NFT_MINT_FLAGS,
    )
    return propose(tx, client, cfg, "nft-mint",
                   [f"stage digest: {rec['stage_digest']}",
                    "  ^ approving the proposal hash below approves the "
                    "mint of EXACTLY this staged artwork + metadata",
                    f"nft:      {C.safe_terminal_text(name, 120)}",
                    f"image:    ipfs://{image_cid}",
                    f"metadata: {uri}",
                    f"royalty:  {int(rec['royalty_bps']) / 100:.2f}% "
                    f"(immutable after mint - verify it)",
                    f"flags:    transferable + burnable",
                    f"taxon:    {rec['taxon']}",
                    "note:     the ledger stores the URI, not the art - "
                    "keep the IPFS pin alive"])


def cmd_nft_stage(args, cfg, client):
    """Step 1: validate + hash artwork locally, write a stage record."""
    acct = need_account(cfg)
    network = cfg.get("network", "testnet")
    rec = stage_artwork(args.file, args.name, args.description or "",
                        args.royalty_bps, args.taxon,
                        account=acct, network=network)
    print("STAGED - nothing has left this machine (zero network calls).")
    print(f"  stage id: {rec['stage_id']}")
    print(f"  stage digest: {rec['stage_digest'][:16]}... "
          f"(full digest is bound into the pin approval)")
    print(f"  file:     {C.safe_terminal_text(rec['source_path'])}")
    print(f"  sha256:   {rec['sha256']}")
    print(f"  size:     {rec['bytes']} bytes ({rec['mime']})")
    print(f"  name:     {C.safe_terminal_text(rec['name'], 120)}")
    print(f"  account:  {rec['account']} (the minter)")
    print(f"  network:  {rec['network']}")
    print(f"  royalty:  {rec['royalty_bps'] / 100:.2f}% "
          f"(immutable after mint - verify it)")
    print(f"  taxon:    {rec['taxon']}")
    print(f"\nReview the above, then run:")
    print(f"  xrpl-trade nft-pin-and-propose --stage {rec['stage_id']}")
    print("That step re-verifies the digest, pins to IPFS (external "
          "write), and proposes the mint.")


def cmd_nft_pin_and_propose(args, cfg, client):
    """Step 2: pin the staged artwork + metadata, propose the mint."""
    pin_and_propose_stage(args.stage, cfg, client)


def cmd_nft_list(args, cfg, client):
    """PROPOSE an NFTokenCreateOffer SELL offer for an owned NFT.
    v1: XRP-denominated only, Expiration always required."""
    acct = need_account(cfg)
    nid = args.token_id.strip()
    if len(nid) != 64 or any(c not in "0123456789abcdefABCDEF" for c in nid):
        sys.exit("token id must be 64 hex characters")
    price = C.dec(args.price_xrp, "price")
    dest = args.destination
    if dest is not None and not C.is_valid_classic_address(dest):
        sys.exit("destination is not a valid classic address "
                 "(base58 checksum failed)")
    tx = NFTokenCreateOffer(
        account=acct,
        nftoken_id=nid.upper(),
        amount=xrp_to_drops(price),
        expiration=C.ripple_time_from_now(args.expires_in),
        destination=dest,
        flags=int(NFTokenCreateOfferFlag.TF_SELL_NFTOKEN),
    )
    lines = [f"token:    {nid.upper()}",
             f"price:    {price} XRP (SELL offer)"]
    if dest:
        lines.append(f"buyer:    {dest} (PRIVATE — only they can accept)")
    else:
        lines.append("buyer:    anyone (public listing)")
    propose(tx, client, cfg, "nft-list", lines)


def provisional_spend_check(spends):
    """Best-effort proposal-time spend-limit check. The signer always
    re-enforces these — this just refuses doomed proposals early, and
    makes the reservation math visible before approval."""
    pol_path = C.POLICY_PATH
    if not pol_path.exists():
        print("  note: no policy file — spend limits enforced by xrpl-sign")
        return
    try:
        pol = json.loads(pol_path.read_text())
    except json.JSONDecodeError:
        print("  note: unreadable policy file — spend limits enforced by "
              "xrpl-sign")
        return
    if pol.get("policy_version") != C.POLICY_VERSION:
        print("  note: policy version mismatch — spend limits enforced by "
              "xrpl-sign")
        return
    # Best-effort: merge over defaults. The signer validates the schema
    # strictly and will refuse a violating policy — say so now, cleanly.
    pol = {**C.DEFAULT_POLICY, **pol}
    try:
        denials = C.SpentTracker().check(spends, pol)
    except C.StateCorruptError as e:
        # Fail closed at proposal time too: never propose against unknown
        # limits. The signer would refuse anyway; say so now, cleanly.
        sys.exit(str(e))
    if denials:
        print("  pre-check: this purchase would breach spend limits:")
        for d in denials:
            print(f"    ✗ {d}")
        sys.exit("nft-buy refused by spend limits (xrpl-sign would deny it)")


def cmd_nft_inventory(args, cfg, client):
    """Read-only: list every NFToken owned by an account (marker-paged,
    so large collections are fully enumerated). The address argument
    also accepts a favorite name — writes never do."""
    arg = args.address
    if arg:
        try:
            favs = C.load_favorites()
        except C.FavoritesError as e:
            sys.exit(str(e))
        addr, problem = C.resolve_fav_or_addr(arg, favs)
        if problem:
            sys.exit(problem)
    else:
        addr = cfg.get("address")
    if not addr:
        sys.exit("No address. Pass one, a favorite name, "
                 "or run `xrpl-trade setup`.")
    nfts = []
    marker = None
    while True:
        r = client.request(AccountNFTs(account=addr, limit=400,
                                       marker=marker))
        if not r.is_successful():
            sys.exit(f"account_nfts failed: {r.result}")
        nfts.extend((r.result or {}).get("account_nfts", []))
        marker = (r.result or {}).get("marker")
        if not marker:
            break
    if not nfts:
        print(f"No NFTs owned by {addr} [{cfg['network']}]")
        return
    print(f"{len(nfts)} NFT(s) owned by {addr} [{cfg['network']}]")
    for n in nfts:
        uri_txt = C.decode_nft_uri(n.get("URI", ""), 90)
        flags = int(n.get("Flags", 0) or 0)
        names = [C.NFT_MINT_FLAG_NAMES[b]
                 for b in sorted(C.NFT_MINT_FLAG_NAMES) if flags & b]
        print(f"  {n.get('NFTokenID')}")
        print(f"    uri:   {uri_txt}")
        print(f"    taxon: {n.get('NFTokenTaxon')}  "
              f"flags: {', '.join(names) or 'none'}")
        issuer = n.get("Issuer")
        if issuer:
            print(f"    issuer: {issuer}")


def cmd_nft_buy(args, cfg, client):
    """Verify an NFT sell offer from the ledger, then PROPOSE accepting
    it. The on-ledger verification (seller, issuer, token URI, taxon,
    price) is printed BEFORE the proposal so the human reviews facts —
    never trust the picture. The signer re-verifies before signing."""
    acct = need_account(cfg)
    idx = args.offer_index.strip()
    lines, denials, amount = C.nft_sell_offer_report(client, idx)
    print("=" * 60)
    print("SELL-OFFER VERIFICATION — read from the ledger just now.")
    print("Verify the ISSUER is the artist you expect: anyone can mint")
    print("the same artwork. The seller is only the current owner; the")
    print("issuer is the minter. This skill reports on-ledger facts; it")
    print("does NOT authenticate art.")
    print("=" * 60)
    for ln in lines:
        print("  " + ln)
    print("=" * 60)
    if denials:
        for d in denials:
            print(f"  ✗ {d}")
        sys.exit("nft-buy refused: " + "; ".join(denials))
    provisional_spend_check({"XRP": amount})
    tx = NFTokenAcceptOffer(account=acct, nftoken_sell_offer=idx.upper())
    propose(tx, client, cfg, "nft-buy",
            ["buy:      accept the sell offer above",
             f"max spend: {amount} XRP (+ fee)",
             "note:     the signer re-verifies the offer from the ledger",
             "          before signing — a cancelled/changed offer is denied"])


def cmd_nft_bid(args, cfg, client):
    """PROPOSE a buy-side NFTokenCreateOffer (a bid) on someone else's
    NFT. v1: XRP-denominated only, Expiration always required. The bid
    XRP is locked in the offer until it is accepted, cancelled, or
    expires — the signer counts it toward spend limits."""
    acct = need_account(cfg)
    nid = args.token_id.strip()
    if len(nid) != 64 or any(c not in "0123456789abcdefABCDEF" for c in nid):
        sys.exit("token id must be 64 hex characters")
    seller = args.seller
    if not C.is_valid_classic_address(seller):
        sys.exit("seller is not a valid classic address "
                 "(base58 checksum failed)")
    if seller == acct:
        sys.exit("seller is your own account — use nft-list to sell your own "
                 "NFT")
    price = C.dec(args.price_xrp, "price")
    tx = NFTokenCreateOffer(
        account=acct,
        nftoken_id=nid.upper(),
        amount=xrp_to_drops(price),
        owner=seller,
        expiration=C.ripple_time_from_now(args.expires_in),
    )
    propose(tx, client, cfg, "nft-bid",
            [f"token:    {nid.upper()}",
             f"bid:      {price} XRP (BUY offer — locked until accepted, "
             "cancelled, or expired)",
             f"seller:   {seller} (only they can accept)",
             "note:     policy must enable nft.allow_buy_offers for this to "
             "sign"])


def cmd_nft_send(args, cfg, client):
    """PROPOSE a 0-XRP NFTokenCreateOffer transfer (a gift) of an owned
    NFT to a favorite name or classic address. --to resolves against the
    local favorites file first (case-insensitive), then as a classic
    address — anything else is refused. The offer carries a 0-drops
    Amount and a Destination: it is a TRANSFER, never a sale. The
    recipient must accept it before it expires; nothing moves until
    they do. Expiration always required."""
    acct = need_account(cfg)
    nid = args.token_id.strip()
    if len(nid) != 64 or any(c not in "0123456789abcdefABCDEF" for c in nid):
        sys.exit("token id must be 64 hex characters")
    try:
        favs = C.load_favorites()
    except C.FavoritesError as e:
        sys.exit(str(e))
    token = args.to
    key = token.lower() if isinstance(token, str) else token
    fav_name = None
    if isinstance(key, str) and key in favs and isinstance(favs[key], dict):
        dest = favs[key].get("address")
        if not C.is_valid_classic_address(dest):
            sys.exit(f"favorite {key!r} has an invalid address — fix it "
                     "with `favorites remove` / `favorites add`")
        fav_name = key
    elif C.is_valid_classic_address(token):
        dest = token
    else:
        sys.exit(f"{token!r} is neither a favorite name nor a valid classic "
                 "address (base58 checksum failed)")
    if dest == acct:
        sys.exit("destination is your own account — a transfer offer to "
                 "yourself is pointless")
    tx = NFTokenCreateOffer(
        account=acct,
        nftoken_id=nid.upper(),
        amount="0",  # 0 drops: gift transfer, NOT a sale
        destination=dest,
        expiration=C.ripple_time_from_now(args.expires_in),
        flags=int(NFTokenCreateOfferFlag.TF_SELL_NFTOKEN),
    )
    lines = [f"token:    {nid.upper()}",
             "action:   TRANSFER (gift — 0 XRP, NOT a sale)",
             f"to:       {dest}"]
    if fav_name:
        lines.append(f"favorite: {fav_name}")
    lines.append("note:     the recipient must accept the offer before it "
                 "expires — nothing moves until they do")
    propose(tx, client, cfg, "nft-send", lines)


def cmd_favorites(args):
    """Local named watchlist of artist wallets. Entirely local: no
    network, no proposals, no signing. Names are lowercase
    [a-z0-9_-], 1-32 chars; addresses get the real base58-checksum
    validation."""
    try:
        favs = C.load_favorites()
    except C.FavoritesError as e:
        sys.exit(str(e))
    cmd = args.fav_cmd
    if cmd == "add":
        problem = C.validate_favorite_name(args.name)
        if problem:
            sys.exit(problem)
        if args.name in favs:
            sys.exit(f"favorite {args.name!r} already exists "
                     f"({favs[args.name].get('address')}) — "
                     "remove it first to re-add")
        if not C.is_valid_classic_address(args.address):
            sys.exit("address is not a valid classic address "
                     "(base58 checksum failed)")
        favs[args.name] = {"address": args.address,
                           "added_at": int(time.time()),
                           "last_checked_ledger": None}
        if args.note:
            favs[args.name]["note"] = args.note
        C.save_favorites(favs)
        print(f"favorite {args.name!r} → {args.address}")
    elif cmd == "remove":
        if args.name not in favs:
            sys.exit(f"no favorite named {args.name!r}")
        del favs[args.name]
        C.save_favorites(favs)
        print(f"removed favorite {args.name!r}")
    elif cmd == "rename":
        if args.old not in favs:
            sys.exit(f"no favorite named {args.old!r}")
        problem = C.validate_favorite_name(args.new)
        if problem:
            sys.exit(problem)
        if args.new in favs:
            sys.exit(f"favorite {args.new!r} already exists")
        favs[args.new] = favs.pop(args.old)
        C.save_favorites(favs)
        print(f"renamed {args.old!r} → {args.new!r}")
    elif cmd == "list":
        if not favs:
            print("no favorites yet — add one with: "
                  "xrpl-trade favorites add <name> <r-address>")
            return
        for name in sorted(favs):
            f = favs[name]
            added = time.strftime("%Y-%m-%d",
                                  time.gmtime(f.get("added_at", 0)))
            note = f"  ({C.safe_terminal_text(f['note'], 120)})" \
                if f.get("note") else ""
            print(f"  {name} → {f.get('address')}  added {added}{note}")
    else:  # pragma: no cover — argparse restricts choices
        sys.exit(f"unknown favorites command {cmd!r}")


def _profile_input(prompt, default="", _input=input):
    try:
        ans = _input(prompt).strip()
    except EOFError:
        return None  # signal: stop the questionnaire
    if ans.lower() == "quit":
        return None
    return ans if ans else default


def run_profile_init(prof, _input=input, cfg=None, client=None):
    """Interactive onboarding questionnaire. Everything stays local.
    Seed-like input at the address prompt is refused with the loud
    warning and re-prompted — never stored.
    The last question offers the Friday community giveaway opt-in: answering
    yes creates a normal 1-drop Payment proposal to the donation wallet
    (still needs human approval); the profile is marked opted-in only after
    that payment is validated on-ledger."""
    print("XRPL skill onboarding — everything stays on this machine "
          "(~/.xrpl/profile.json, owner-only).")
    print("Skip any question with Enter. Type 'quit' to stop.\n")

    ans = _profile_input(
        f"What should I call you? [{prof.get('display_name') or 'skip'}]: ",
        default=prof.get("display_name") or "", _input=_input)
    if ans is None:
        print("onboarding stopped — nothing was saved")
        return
    if ans:
        problem = C.set_profile_field(prof, "display_name", ans)
        if problem:
            print(f"  ({problem} — keeping previous)")

    print("\nAdd WATCH-ONLY XRPL addresses (they start with 'r').")
    print("NEVER enter a seed or secret key — those start with 's'.")
    while True:
        ans = _profile_input("  address [done]: ", default="", _input=_input)
        if ans is None:
            print("onboarding stopped — nothing was saved")
            return
        if not ans:
            break
        problem = C.add_profile_list_item(prof, "xrpl_addresses", ans)
        if problem:
            print(f"  {problem}")
            continue
        print(f"  added {ans.strip()}")

    ans = _profile_input(
        "\nAny DAO memberships? (comma-separated, e.g. xaodao) [skip]: ",
        default="", _input=_input)
    if ans is None:
        print("onboarding stopped — nothing was saved")
        return
    for raw in ans.split(","):
        raw = raw.strip()
        if not raw:
            continue
        problem = C.add_profile_list_item(prof, "memberships", raw)
        if problem:
            print(f"  ({problem} — skipped)")

    ans = _profile_input(
        "\nWhat do you use the skill for? (comma-separated, e.g. "
        + ", ".join(C.SUGGESTED_INTERESTS) + ") [skip]: ",
        default="", _input=_input)
    if ans is None:
        print("onboarding stopped — nothing was saved")
        return
    for raw in ans.split(","):
        raw = raw.strip()
        if not raw:
            continue
        problem = C.add_profile_list_item(prof, "interests", raw)
        if problem:
            print(f"  ({problem} — skipped)")

    ans = _profile_input(
        "\nPrice-move alerts when XRP swings? (y/N): ",
        default="", _input=_input)
    if ans is None:
        print("onboarding stopped — nothing was saved")
        return
    if ans.strip().lower() in C.PROFILE_BOOL_TRUE:
        C.set_profile_field(prof, "alerts.price_moves", "true")
        ans = _profile_input("  alert threshold in percent [3]: ",
                            default="3", _input=_input)
        if ans is None:
            print("onboarding stopped — nothing was saved")
            return
        problem = C.set_profile_field(prof, "alerts.threshold_pct", ans)
        if problem:
            print(f"  ({problem} — keeping 3)")

    # Friday community giveaway opt-in. Default is skip (Enter) — opting in
    # sends real value off your wallet, so silence must never mean yes.
    ans = _profile_input(
        "\nJoin the Friday community giveaway? (sends a 1-drop opt-in from "
        "your wallet — proves the address is yours, costs ~nothing) (y/N): ",
        default="", _input=_input)
    if ans is None:
        print("onboarding stopped — nothing was saved")
        return
    if ans.strip().lower() in C.PROFILE_BOOL_TRUE:
        print()
        print(giveaway_opt_in_flow(cfg, client, prof, C.load_giveaway_config()))

    C.save_profile(prof)
    print("\nProfile saved to ~/.xrpl/profile.json — "
          "review it anytime with: xrpl-trade profile show")


def cmd_profile(args, cfg=None, client=None):
    """Local assistant profile (onboarding). Entirely local: no network,
    no proposals, no signing — except `init`, which MAY propose the
    giveaway opt-in payment when the user answers yes (cfg/client are
    passed through only for that). Watch-only addresses only — seed-like
    input is refused, never stored."""
    try:
        raw = C.load_profile()
    except C.ProfileError as e:
        sys.exit(str(e))
    exists = bool(raw)
    prof = C.normalize_profile(raw) if exists else C.default_profile()
    cmd = args.prof_cmd
    if cmd == "init":
        if exists:
            print("you already have a profile — `profile show` to review, "
                  "`profile clear` to start over")
            return
        run_profile_init(prof, cfg=cfg, client=client)
    elif cmd == "show":
        if not exists:
            print("no profile yet — run: xrpl-trade profile init")
            return
        print(f"  name:        {prof.get('display_name') or '—'}")
        addrs = prof.get("xrpl_addresses") or []
        print(f"  addresses:   {', '.join(addrs) if addrs else '—'}")
        mems = prof.get("memberships") or []
        print(f"  memberships: {', '.join(mems) if mems else '—'}")
        ints = prof.get("interests") or []
        print(f"  interests:   {', '.join(ints) if ints else '—'}")
        al = prof.get("alerts") or {}
        print(f"  alerts:      price_moves={al.get('price_moves')} "
              f"threshold={al.get('threshold_pct')}%")
        gw = prof.get("giveaway") or {}
        print(f"  giveaway:    opt_in={gw.get('opt_in')} "
              f"tx={gw.get('opt_in_tx') or '—'}")
    elif cmd == "set":
        problem = C.set_profile_field(prof, args.field, args.value)
        if problem:
            sys.exit(problem)
        C.save_profile(prof)
        print(f"profile: {args.field} = {args.value}")
    elif cmd in ("add-address", "remove-address"):
        fn = (C.add_profile_list_item if cmd == "add-address"
              else C.remove_profile_list_item)
        problem = fn(prof, "xrpl_addresses", args.address)
        if problem:
            sys.exit(problem)
        C.save_profile(prof)
        verb = "added to" if cmd == "add-address" else "removed from"
        print(f"address {args.address.strip()} {verb} your profile")
    elif cmd in ("add-membership", "remove-membership"):
        fn = (C.add_profile_list_item if cmd == "add-membership"
              else C.remove_profile_list_item)
        problem = fn(prof, "memberships", args.name)
        if problem:
            sys.exit(problem)
        C.save_profile(prof)
        verb = "added to" if cmd == "add-membership" else "removed from"
        print(f"membership {args.name.strip().lower()} {verb} your profile")
    elif cmd in ("add-interest", "remove-interest"):
        fn = (C.add_profile_list_item if cmd == "add-interest"
              else C.remove_profile_list_item)
        problem = fn(prof, "interests", args.name)
        if problem:
            sys.exit(problem)
        C.save_profile(prof)
        verb = "added to" if cmd == "add-interest" else "removed from"
        print(f"interest {args.name.strip().lower()} {verb} your profile")
    elif cmd == "clear":
        if C.PROFILE_PATH.exists():
            C.PROFILE_PATH.unlink()
        print("profile cleared — run `xrpl-trade profile init` to start over")
    else:  # pragma: no cover — argparse restricts choices
        sys.exit(f"unknown profile command {cmd!r}")


def cmd_xrpresso(args):
    """Read-only XRPresso marketplace discovery.

    Anonymous, no API key, no wallet, no signing. Every result that
    carries a deep link shows it so the human can tap through and buy
    in XRPresso's own UI — the agent never buys, mints, or escrows.
    Deep links are validated: only https URLs on xrpresso.io are
    displayed; anything else is withheld, never printed."""
    cmd = args.xp_cmd
    print("XRPresso discovery (read-only) — open a link below to "
          "buy/bid in their UI.\n")
    try:
        if cmd == "listings":
            items = XP.get_listings(category=args.category, q=args.q,
                                    limit=args.limit, sort=args.sort,
                                    currency=args.currency)
            if not items:
                print("no listings found")
                return
            for it in items:
                print(XP.fmt_listing(it))
                print()
        elif cmd == "nfts":
            items = XP.get_nft_listings(q=args.q, limit=args.limit,
                                        sort=args.sort)
            if not items:
                print("no NFT listings found")
                return
            for it in items:
                print(XP.fmt_nft(it))
                print()
        elif cmd == "auctions":
            items = XP.get_nft_auctions(limit=args.limit)
            if not items:
                print("no live auctions")
                return
            for it in items:
                print(XP.fmt_auction(it))
                print()
        elif cmd == "listing":
            print(XP.fmt_listing(XP.get_listing(args.id), detail=True))
        elif cmd == "stats":
            print(XP.fmt_stats(XP.get_stats()))
        elif cmd == "categories":
            print(XP.fmt_categories(XP.get_categories()))
        else:  # pragma: no cover — argparse restricts choices
            sys.exit(f"unknown xrpresso command {cmd!r}")
    except XP.XRPressoError as e:
        sys.exit(f"XRPresso error: {e}")


def cmd_nft_new(args, cfg, client):
    """Read-only: what's new from favorite artists.

    For each favorite, finds NFTokenMint transactions since its
    per-favorite watermark (first run: last 7 days) and reports the
    token, mint time, current listing price if any, and an xrp.cafe
    link. The watermark then advances to the validated ledger.
    --days N is a pure window scan and does NOT move the watermark."""
    days = args.days
    if days is not None and not 1 <= days <= 90:
        sys.exit("--days must be between 1 and 90")
    try:
        favs = C.load_favorites()
    except C.FavoritesError as e:
        sys.exit(str(e))
    if not favs:
        print("no favorites yet — add one with: "
              "xrpl-trade favorites add <name> <r-address>")
        return
    now = int(time.time())
    validated, problem = C.get_validated_ledger(client)
    if problem:
        sys.exit(problem)
    for name in sorted(favs):
        fav = favs[name]
        addr = fav.get("address") or "?"
        if days is not None:
            cutoff, stop_ledger = now - days * 86400, None
            window = f"last {days}d"
        else:
            wm = fav.get("last_checked_ledger")
            if wm is None:
                cutoff, stop_ledger = now - 7 * 86400, None
                window = "last 7d (first check)"
            else:
                cutoff, stop_ledger = None, wm
                window = f"since ledger {wm}"
        mints, _pages, problem = C.scan_artist_mints(
            client, addr, stop_ledger=stop_ledger, cutoff_unix=cutoff)
        tag = f"{name} ({C.short_addr(addr)})"
        if problem:
            print(f"{tag} — note: {problem}")
            continue
        if not mints:
            print(f"{tag} — nothing new ({window})")
        else:
            print(f"{tag} — {len(mints)} new ({window}):")
            for m in mints:
                tids = m["token_ids"]
                nid = tids[0] if tids else None
                when = (time.strftime("%Y-%m-%d %H:%M UTC",
                                      time.gmtime(m["date_unix"]))
                        if m["date_unix"] else "unknown time")
                print(f"  • {nid or '<token id not found in metadata>'}")
                print(f"    minted:  {when}   taxon: {m['taxon']}")
                print(f"    uri:     {C.decode_nft_uri(m['uri_hex'], 80)}")
                if nid:
                    price, perr = C.nft_sell_price(client, nid)
                    link = C.XRP_CAFE_NFT_URL.format(nid)
                    if perr:
                        print(f"    listing: unknown ({perr})")
                    elif price:
                        print(f"    listing: {price}")
                    else:
                        print("    listing: not listed")
                    print(f"             {link}")
        if days is None:
            fav["last_checked_ledger"] = validated
    if days is None:
        C.save_favorites(favs)


# ---------- local wallet creation (v0.6.1) ----------
#
# New-user onboarding path: generate a fresh wallet LOCALLY and store the
# seed straight into ~/.xrpl/config.json (0600, atomic). The seed NEVER
# appears in stdout, stderr, logs, proposals, or chat — only the classic
# address is ever printed. This is the "local signer" deployment profile:
# convenient, but the seed lives on this machine. The vault-signer profile
# (seed injected as XRPL_SEED at approval time, never stored here) remains
# the safer option, and Xaman generation (seed never touches this machine
# at all) the safest. See "Wallets" in SKILL.md.

def generate_wallet_into_config(network, force=False):
    """Generate a fresh ed25519 wallet; store seed 0600, return address.

    Prints nothing. Refuses to overwrite an already-stored seed unless
    force is set.
    """
    from xrpl.wallet import Wallet
    cfg = {}
    if C.CONFIG_PATH.exists():
        cfg = json.loads(C.CONFIG_PATH.read_text())
    if cfg.get("seed") and not force:
        sys.exit("a wallet seed is already stored in ~/.xrpl/config.json — "
                 "refusing to overwrite. Use `xrpl-trade wallet create --force` "
                 "to replace it (treat the old wallet as burned if its seed "
                 "was ever exposed).")
    wallet = Wallet.create()  # ed25519 in this xrpl-py
    # Belt and braces: the seed must derive the address we report.
    if Wallet.from_seed(wallet.seed).classic_address != wallet.classic_address:
        sys.exit("internal error: generated seed does not derive its address")
    address = wallet.classic_address
    seed = wallet.seed
    del wallet
    cfg.update({"seed": seed, "address": address, "network": network})
    del seed
    C.XRPL_DIR.mkdir(parents=True, exist_ok=True)
    tmp = C.CONFIG_PATH.with_name(C.CONFIG_PATH.name + ".tmp")
    tmp.write_text(json.dumps(cfg, indent=2) + "\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, C.CONFIG_PATH)
    C.audit("wallet_create", None, None, network, address, "stored",
            note="seed stored 0600, never displayed")
    return address


def backup_ceremony(seed, address):
    """One-time seed display for write-down backup.

    Prints the seed exactly once with hard warnings, then requires the
    operator to type I HAVE WRITTEN IT DOWN. Returns True on confirmation.
    The seed itself is never logged, never returned, never stored here —
    the caller records the confirmation flag wherever fits.
    """
    print("=" * 64)
    print("ONE-TIME BACKUP — write this down NOW: on paper, or in your")
    print("password manager, offline. This is the ONLY time this seed will")
    print("be displayed. Anyone holding it controls the wallet. Never paste")
    print("it into chat, email, screenshots, or any app. If it ever touches")
    print("chat or a log, treat the wallet as BURNED and generate a new one.")
    print("=" * 64)
    print(f"  address: {address}")
    print(f"  seed:    {seed}")
    print("=" * 64)
    ans = input("Type I HAVE WRITTEN IT DOWN to confirm your backup: ").strip()
    return ans == "I HAVE WRITTEN IT DOWN"


def cmd_wallet(args, cfg):
    """Wallet management: vault-flow create for mainnet, local for testnet."""
    if args.wallet_cmd == "create":
        network = args.network or (cfg or {}).get("network", "testnet")
        if network not in C.NETWORKS:
            sys.exit(f"unknown network {network!r}")
        if network == "mainnet":
            # P1-2 vault-only mainnet: the CLI never generates, displays,
            # or stores a mainnet seed. Secret material in stdout/stderr
            # lands in transcripts and logs — the audit requires
            # secret-free output on mainnet wallet flows. Generate the
            # wallet in your password manager (the vault) or with Xaman,
            # then bind it with a signing profile (credential kind 'env').
            sys.exit(
                "refusing: mainnet wallets are vault-only — generate the "
                "wallet in your password manager (or Xaman), store the seed "
                "there, then run `xrpl-sign init-profiles` to bind the "
                "account with credential kind 'env'. This tool never creates "
                "or displays mainnet seed material.")
        if args.force:
            print("WARNING: --force replaces the stored seed. The old wallet is")
            print("no longer controlled by this machine — if its seed was ever")
            print("exposed, move any funds first.\n")
        address = generate_wallet_into_config(network, force=args.force)
        print("New TESTNET wallet generated locally (ed25519).")
        print(f"  address: {address}")
        print(f"  network: {network}")
        print("  seed: stored in ~/.xrpl/config.json (0600) — never displayed,")
        print("        never logged, never leaves this machine via this tool.")
        print("        (Local seed storage is TESTNET-ONLY. Mainnet wallets")
        print("         use the vault flow: `wallet create --network mainnet`.)")
        print()
        print("Back it up ONCE, right now (write it on paper, offline):")
        print("  xrpl-trade wallet backup --network testnet")
        print()
        print("On testnet:  xrpl-trade faucet --network testnet")
    elif args.wallet_cmd == "backup":
        network = args.network or (cfg or {}).get("network", "testnet")
        if network == "mainnet":
            # P1-2: mainnet seeds are vault-only; they are never in local
            # files, so there is nothing to back up — and printing one
            # would put it in capturable output.
            sys.exit("refusing: mainnet wallets are vault-only — the seed "
                     "lives in your password manager, not in local files. "
                     "There is nothing to back up from disk.")
        seed = (cfg or {}).get("seed")
        address = (cfg or {}).get("address")
        if not seed:
            sys.exit("no seed stored in ~/.xrpl/config.json — nothing to back "
                     "up (create one with `xrpl-trade wallet create`)")
        if not backup_ceremony(seed, address):
            sys.exit("backup NOT confirmed — the seed was displayed once and "
                     "will not be shown again by this command. Run `xrpl-trade "
                     "wallet backup` again when you are ready to write it down.")
        cfg["seed_backed_up"] = True
        tmp = C.CONFIG_PATH.with_name(C.CONFIG_PATH.name + ".tmp")
        tmp.write_text(json.dumps(cfg, indent=2) + "\n")
        os.chmod(tmp, 0o600)
        os.replace(tmp, C.CONFIG_PATH)
        print("Backup confirmed and recorded.")
        print("Note: if you ran this through a chat assistant, this transcript")
        print("now contains the seed — for maximum safety, run backup in your")
        print("own terminal instead.")
        C.audit("wallet_backup", None, None, network, address, "confirmed",
                note="one-time display + operator confirmation; seed never in the log")
    elif args.wallet_cmd == "forget-seed":
        # P1-2 migration: remove a legacy seed from a local file AFTER the
        # operator confirms it is vault-backed. Never silent, never forced.
        target = args.path or str(C.CONFIG_PATH)
        try:
            data = json.loads(open(target).read())
        except (OSError, json.JSONDecodeError):
            sys.exit(f"cannot read {target}")
        if not data.get("seed"):
            print(f"no seed in {target} — nothing to do.")
            return
        print(f"{target} holds a seed for address {data.get('address')}.")
        print("This is the vault-only migration: the seed must ALREADY be")
        print("stored in your password manager before removal.")
        ans = input("Confirm the seed is vault-backed and REMOVE it from disk? "
                    "(type the address to confirm): ").strip()
        if ans != str(data.get("address")):
            sys.exit("confirmation did not match — seed NOT removed.")
        data.pop("seed", None)
        tmp = target + ".tmp"
        open(tmp, "w").write(json.dumps(data, indent=2) + "\n")
        os.chmod(tmp, 0o600)
        os.replace(tmp, target)
        print(f"seed removed from {target}. Mainnet signing is now unblocked")
        print("(via --profile with vault injection).")
        C.audit("wallet_forget_seed", None, None,
                data.get("network", "?"), data.get("address"),
                "seed-removed-from-disk",
                note="operator-confirmed vault backup before removal")
    else:
        sys.exit(f"unknown wallet subcommand {args.wallet_cmd!r}")


AUTOPILOT_DISCLOSURE = """\
================================================================
AUTOPILOT MODE — AT YOUR OWN RISK
================================================================
You are about to store this wallet's seed on this machine
(~/.xrpl/autopilot.json, owner-only 0600) so the signer can sign
without fetching the seed from your vault each time.

What this DOES protect you from (the agent's mistakes):
  - Every signing still needs a hash-bound proposal from xrpl-trade.
  - The signer still enforces your policy file: per-transaction and
    rolling-24h spend caps, approved pairs/tokens, tx-type allowlist,
    price-deviation and book-quality bounds, fee caps, expirations.
  - In chat, nothing signs until you tap Submit on the proposal.

What this DOES NOT protect you from:
  - A compromised agent or machine. This is a same-user install: any
    process running as this user can read the seed file. If the agent
    is prompt-injected or the machine is rooted, the seed is exposed.
  - In short: the agent's mistakes are bounded; the agent's
    compromise is not defended against.

Reduce the blast radius:
  - Use a dedicated limited-funds wallet for autopilot, not your vault.
  - Keep spend caps tight in ~/.xrpl/policy.json.
  - Run `xrpl-trade autopilot disable` the moment you stop needing it.

The seed is stored 0600, never printed, never logged, never echoed.
================================================================
"""


def autopilot_seed_controls_account(seed, account, client):
    """True if the seed derives to the account address or its on-ledger
    RegularKey. Returns (ok, kind) where kind is 'master', 'regular', or
    None. Fail-closed: any ledger lookup failure yields (False, None)."""
    from xrpl.wallet import Wallet
    try:
        derived = Wallet.from_seed(seed).classic_address
    except Exception:
        return False, None
    if derived == account:
        return True, "master"
    try:
        from xrpl.models.requests import AccountInfo
        resp = client.request(AccountInfo(account=account,
                                          ledger_index="validated"))
        if resp.is_successful():
            rk = resp.result["account_data"].get("RegularKey")
            if rk and derived == rk:
                return True, "regular"
    except Exception:
        pass
    return False, None


def cmd_autopilot(args, cfg):
    """At-your-own-risk local mainnet signing: enable / disable / status."""
    if args.autopilot_cmd == "enable":
        if C.autopilot_enabled_for((cfg or {}).get("address", "")) or \
                (C.autopilot_state() or {}).get("enabled"):
            st = C.autopilot_state()
            sys.exit(f"autopilot is already enabled for {st.get('account')} "
                     f"— run `xrpl-trade autopilot disable` first to change it.")
        print(AUTOPILOT_DISCLOSURE)
        ans = input("Type ENABLE AUTOPILOT to accept this risk and continue: "
                    ).strip()
        if ans != "ENABLE AUTOPILOT":
            sys.exit("not enabled — nothing was stored.")
        network = (cfg or {}).get("network", "mainnet")
        if network not in C.NETWORKS:
            sys.exit(f"unknown network {network!r}")
        address = args.address or (cfg or {}).get("address")

        seed = None
        kind = None
        backed_up = False

        # 1. Adopt the locally-created seed when it matches the account.
        #    (Fixes the dead end: `wallet create` never displays the seed,
        #    so there is nothing to paste for `autopilot enable`.)
        local_seed = (cfg or {}).get("seed")
        local_addr = (cfg or {}).get("address")
        if local_seed and local_addr and (not address or local_addr == address):
            from xrpl.wallet import Wallet as _W
            try:
                derives = _W.from_seed(local_seed).classic_address == local_addr
            except Exception:
                derives = False
            if derives:
                adopt = input(
                    f"Found the locally-created seed for {local_addr} in "
                    f"~/.xrpl/config.json. Adopt it directly (no pasting)? "
                    f"(Y/n): ").strip().lower()
                if adopt in ("", "y", "yes"):
                    seed, address, kind = local_seed, local_addr, "master"
                    backed_up = bool((cfg or {}).get("seed_backed_up"))

        # 2. No adoptable seed: generate a fresh dedicated wallet, or paste
        #    your own. Generation is inside the autopilot opt-in (the
        #    at-your-own-risk exception to vault-only mainnet).
        if seed is None:
            if address and C.is_valid_classic_address(address):
                choice = input(
                    f"No local seed for {address}. [G]enerate a fresh dedicated "
                    f"autopilot wallet, or [P]aste your own seed? (g/p): "
                ).strip().lower()
            else:
                choice = input(
                    "No account address set. [G]enerate a fresh dedicated "
                    "autopilot wallet, or [A]bort? (g/A): ").strip().lower()
                if choice not in ("g", "generate"):
                    sys.exit("aborted — pass --address r... or set it in "
                             "~/.xrpl/config.json first.")
            if choice in ("g", "generate"):
                from xrpl.wallet import Wallet as _W
                w = _W.create()  # ed25519 in this xrpl-py
                if _W.from_seed(w.seed).classic_address != w.classic_address:
                    sys.exit("internal error: generated seed does not derive "
                             "its address")
                print(f"\nGenerated a fresh dedicated autopilot wallet "
                      f"({network}).")
                print("Keep the funds in it LIMITED — it is a hot wallet on "
                      "this machine.")
                if not backup_ceremony(w.seed, w.classic_address):
                    sys.exit("backup NOT confirmed — nothing was stored. Run "
                             "`xrpl-trade autopilot enable` again when you are "
                             "ready to write it down.")
                seed, address, kind, backed_up = \
                    w.seed, w.classic_address, "master", True
                del w
            else:
                if not address or not C.is_valid_classic_address(address):
                    sys.exit("no valid account address — pass --address r... "
                             "or set it in ~/.xrpl/config.json first.")
                import getpass
                try:
                    seed = getpass.getpass(
                        "Paste the wallet seed (hidden; stored 0600, never "
                        "displayed): ").strip()
                except (EOFError, KeyboardInterrupt):
                    sys.exit("\ncancelled — nothing was stored.")
                if not seed:
                    sys.exit("empty — nothing was stored.")
                if not C._looks_like_seed(seed):
                    sys.exit("that does not look like an XRPL seed — nothing was "
                             "stored.")
                client = get_client(network)
                ok, kind = autopilot_seed_controls_account(seed, address, client)
                if not ok:
                    sys.exit(
                        "that seed does not control the account — nothing was stored.\n"
                        f"  account: {address}\n"
                        "  The seed must derive to the account address (master key) "
                        "or its on-ledger RegularKey.")
                # Bring-your-own seed: the operator holds the backup.
                backed_up = False

        # 3. Adopted a local seed with no recorded backup? Offer the ceremony.
        if (seed is not None and not backed_up and local_seed
                and seed == local_seed and cfg is not None):
            again = input(
                "No backup recorded for this seed. Back it up now (strongly "
                "recommended)? (Y/n): ").strip().lower()
            if again in ("", "y", "yes") and backup_ceremony(seed, address):
                backed_up = True
                cfg["seed_backed_up"] = True
                tmp = C.CONFIG_PATH.with_name(C.CONFIG_PATH.name + ".tmp")
                tmp.write_text(json.dumps(cfg, indent=2) + "\n")
                os.chmod(tmp, 0o600)
                os.replace(tmp, C.CONFIG_PATH)
                print("Backup confirmed and recorded.")

        C.write_autopilot_state(address, network, seed,
                                seed_backed_up=backed_up)
        C.audit("autopilot_enable", None, None, network, address, "enabled",
                note="operator typed ENABLE AUTOPILOT after the at-your-own-"
                     "risk disclosure; seed stored 0600, never in the log; "
                     f"source={kind}; backed_up={backed_up}")
        print(f"\nautopilot ENABLED for {address} ({kind} key, {network}).")
        print("The signer will use the local seed for this account; every")
        print("signing still needs a proposal and still enforces the policy.")
        print("Review your caps: ~/.xrpl/policy.json")
        print("To remove the seed: xrpl-trade autopilot disable")
    elif args.autopilot_cmd == "disable":
        st = C.autopilot_state()
        if not st or not st.get("enabled"):
            print("autopilot is not enabled — nothing to do.")
            return
        account = st.get("account", "?")
        ans = input(f"Remove the autopilot seed for {account}? "
                    f"(type the address to confirm): ").strip()
        if ans != account:
            sys.exit("confirmation did not match — autopilot still enabled.")
        try:
            C.AUTOPILOT_PATH.unlink()
        except OSError as e:
            sys.exit(f"could not remove {C.AUTOPILOT_PATH}: {e}")
        C.audit("autopilot_disable", None, None, st.get("network", "?"),
                account, "disabled",
                note="operator-confirmed removal; seed deleted from disk")
        print("autopilot disabled — the seed was removed from disk.")
        print("Mainnet signing is vault-only again for this account.")
    elif args.autopilot_cmd == "status":
        st = C.autopilot_state()
        if not st or not st.get("enabled"):
            print("autopilot: disabled (vault-only mainnet signing)")
            return
        print("autopilot: ENABLED — at your own risk")
        print(f"  account:   {st.get('account')}")
        print(f"  network:   {st.get('network')}")
        print(f"  enabled:   {time.strftime('%Y-%m-%d %H:%M:%S', time.gmtime(st.get('enabled_at', 0)))} UTC")
        print(f"  seed file: {C.AUTOPILOT_PATH} (0600, never displayed)")
        print("  Every signing still needs a proposal + policy checks.")
    else:
        sys.exit(f"unknown autopilot subcommand {args.autopilot_cmd!r}")


def cmd_setup(_args):
    print("XRPL setup (v0.6). Two paths:")
    print("  1. Generate a brand new wallet — seed created locally, stored in")
    print("     ~/.xrpl/config.json (0600), never displayed.")
    print("  2. Register an existing address (watch-only) — your seed stays")
    print("     wherever it already is.\n")
    ans = input("Generate a brand new wallet? (y/N): ").strip().lower()
    net = input("network [mainnet/testnet/devnet] (testnet): ").strip() or "testnet"
    if net not in C.NETWORKS:
        sys.exit("unknown network")
    C.XRPL_DIR.mkdir(parents=True, exist_ok=True)
    if ans in ("y", "yes"):
        address = generate_wallet_into_config(net)
        print(f"\nWallet {address} generated and stored (seed never displayed).")
        print("Back it up once, right now:  xrpl-trade wallet backup")
        print("Next: xrpl-sign init-policy   (creates the signer policy)")
        return
    address = input("classic address (r...): ").strip()
    if not C.is_valid_classic_address(address):
        sys.exit("not a valid XRPL classic address (base58 checksum failed)")
    cfg = {}
    if C.CONFIG_PATH.exists():
        cfg = json.loads(C.CONFIG_PATH.read_text())
    if cfg.get("seed"):
        # P1-2: NEVER silently delete key material. The operator must
        # migrate it to the vault first (wallet forget-seed), with an
        # explicit confirmation — a watch-only switch must not destroy
        # the only copy of a seed.
        sys.exit(f"refusing: {C.CONFIG_PATH} already holds a seed. "
                 f"Migrate it to your vault first with "
                 f"`xrpl-trade wallet forget-seed`, then re-run setup.")
    cfg.update({"network": net, "address": address})
    tmp = C.CONFIG_PATH.with_name(C.CONFIG_PATH.name + ".tmp")
    tmp.write_text(json.dumps(cfg, indent=2) + "\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, C.CONFIG_PATH)
    print(f"\nSaved address {address} on {net} (watch-only).")
    print("Next: xrpl-sign init-policy   (creates the signer policy)")


def cmd_faucet(args, cfg, _client):
    net = args.network or cfg.get("network", "testnet")
    if net == "mainnet":
        sys.exit("No faucet on mainnet.")
    import httpx
    r = httpx.post(f"https://faucet.altnet.rippletest.net/accounts"
                   if net == "testnet" else
                   "https://faucet.devnet.rippletest.net/accounts",
                   json={}, timeout=30.0)
    r.raise_for_status()
    acct = r.json()["account"]
    address = acct.get("classicAddress") or acct["address"]
    seed = r.json()["seed"]
    # The seed NEVER goes to stdout: dedicated 0600 file, never displayed.
    # (A separate file — never the main config — so a throwaway testnet
    # wallet can't clobber a real one.)
    fp = C.XRPL_DIR / f"faucet-{address}.json"
    tmp = fp.with_name(fp.name + ".tmp")
    tmp.write_text(json.dumps({"seed": seed, "address": address,
                               "network": net}, indent=2) + "\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, fp)
    del seed
    print(f"address: {address}")
    print(f"seed: stored in {fp} (0600) — never displayed.")
    print("Throwaway testnet wallet. To sign with it, load XRPL_SEED from")
    print("that file in your own terminal — never paste it into chat.")


# ---------- main ----------

def giveaway_opt_in_flow(cfg, client, prof, gw):
    """The shared giveaway opt-in logic (profile init + `giveaway opt-in`).

    Returns a message for the caller to print. The profile is marked
    opted-in (and saved) ONLY after a matching 1-drop opt-in Payment is
    found validated on-ledger — creating a proposal is NOT opt-in.
    Every branch is non-fatal: problems come back as text, never exits,
    so the onboarding questionnaire can't be derailed by a network hiccup.
    """
    gw_prof = prof.get("giveaway") or {}
    if gw_prof.get("opt_in"):
        return (f"already opted in — entry tx {gw_prof.get('opt_in_tx') or '—'}; "
                f"you're in the Friday draw")
    if client is None:
        return ("opt-in needs a network client — run "
                "`xrpl-trade giveaway opt-in` from a terminal with network")
    acct = (cfg or {}).get("address")
    if not acct:
        return ("no address configured — run `xrpl-trade setup` first, then "
                "`xrpl-trade giveaway opt-in`")
    wallet, tag = gw["donation_wallet"], gw["opt_in_tag"]

    # 1. Already on-ledger? (covers: they sent it by hand, or they approved
    #    a proposal earlier and re-ran this.) Nothing proposed, no duplicates.
    found, problem = C.find_opt_in_tx(client, acct, wallet, tag)
    if problem:
        return f"couldn't check the ledger for an existing opt-in: {problem}"
    if found:
        prof["giveaway"] = {"opt_in": True, "opt_in_tx": found}
        C.save_profile(prof)
        return (f"opt-in already on-ledger: {found}\n"
                "recorded — you're in the Friday draw")

    # 2. Add the exact (donation wallet, tag) pair to the payment
    #    destination allowlist — the signer refuses anything not listed.
    problem = C.add_destination_allowlist_entry(wallet, tag)
    if problem:
        return f"couldn't update your payment destination allowlist: {problem}"
    print(f"  added ({wallet}, tag {tag}) to your payment destination allowlist")

    # 3. Propose the 1-drop opt-in through the normal ceremony: human
    #    approval still required, and the profile stays unmarked until the
    #    payment validates. Re-run this command afterwards to record it.
    tx = Payment(account=acct, destination=wallet,
                 amount=xrp_to_drops(Decimal("0.000001")),
                 destination_tag=tag)
    propose(tx, client, cfg, "giveaway-opt-in",
            ["opt-in:   Friday community giveaway",
             f"to:       {wallet} (donation wallet)",
             "amount:   1 drop (0.000001 XRP)",
             f"dest tag: {tag}"])
    return ("proposal created — after you approve it, re-run "
            "`xrpl-trade giveaway opt-in` to record your entry")


def cmd_giveaway(args, cfg, client):
    """Friday community giveaway. entrants/draw/status are read-only;
    opt-in goes through the normal propose → human-approve → sign flow.
    The draw only SELECTS a winner — it never builds or submits a gift
    transaction (that stays human-approved, gift by gift)."""
    gw = C.load_giveaway_config(getattr(args, "donation_wallet", None))
    wallet, tag = gw["donation_wallet"], gw["opt_in_tag"]
    network = cfg.get("network", "?")
    cmd = args.gw_cmd

    if cmd == "opt-in":
        try:
            raw = C.load_profile()
        except C.ProfileError as e:
            sys.exit(str(e))
        prof = C.normalize_profile(raw) if raw else C.default_profile()
        print(giveaway_opt_in_flow(cfg, client, prof, gw))
        return

    if cmd == "entrants":
        entrants, problem = C.eligible_entrants(client, wallet, tag)
        if problem:
            sys.exit(problem)
        print(f"Giveaway entrants — donation wallet {wallet} [{network}]")
        print(f"  opt-in: 1 drop (0.000001 XRP) with destination tag {tag}")
        n_elig = sum(1 for e in entrants if e["eligible"])
        for e in entrants:
            yn = "yes" if e["eligible"] else "no"
            print(f"  {e['address']:<36} tx {e['opt_in_tx'][:12]}… "
                  f"actions {e['action_count']:>3}  eligible {yn}")
        print(f"\n{n_elig}/{len(entrants)} eligible "
              f"(eligibility: opt-in + ≥1 wallet action)")
        return

    if cmd == "draw":
        if args.ledger_offset < 0:
            sys.exit("--ledger-offset must be >= 0")
        entrants, problem = C.eligible_entrants(client, wallet, tag)
        if problem:
            sys.exit(problem)
        eligible = [e for e in entrants if e["eligible"]]
        if not eligible:
            print("no eligible entrants — nothing to draw")
            return
        current, problem = C.get_validated_ledger(client)
        if problem:
            sys.exit(problem)
        target = current + args.ledger_offset
        if args.ledger_offset:
            print(f"waiting for ledger {target} "
                  f"(validated {current} + offset {args.ledger_offset})…")
        lhash, problem = C.wait_for_ledger_hash(client, target)
        if problem:
            sys.exit(problem)
        idx, digest, _seed = C.pick_giveaway_winner(eligible, lhash)
        winner = eligible[idx]
        print("=" * 64)
        print("GIVEAWAY DRAW — selection only. No transaction was built, "
              "proposed, or submitted.")
        print("=" * 64)
        print(f"  entrants:    {len(eligible)} eligible")
        print(f"  ledger:      {target}")
        print(f"  ledger hash: {lhash}")
        print("  method:      sha256(ledger_hash + ':' + opt-in tx hashes "
              "in address order) mod entrants")
        print(f"  digest:      {digest}")
        print(f"  winner idx:  {idx} (= digest mod {len(eligible)})")
        print(f"  WINNER:      {winner['address']}")
        print("Verify independently: take the ledger hash above and the "
              "opt-in tx hashes below (sorted by address), sha256 the "
              f"colon/comma-joined string, take mod {len(eligible)}.")
        for e in eligible:
            print(f"    {e['address']}  {e['opt_in_tx']}")
        # Persist the public draw result for `giveaway announce`. This is a
        # local record of public data — the draw still never transacts.
        C.save_last_draw({
            "drawn_at": int(time.time()),
            "network": network,
            "donation_wallet": wallet,
            "ledger_index": target,
            "ledger_hash": lhash,
            "method": ("sha256(ledger_hash + ':' + opt-in tx hashes in "
                       "address order) mod entrants"),
            "digest": digest,
            "winner_index": idx,
            "winner": winner["address"],
            "entrant_count": len(eligible),
            "opt_in_txs": {e["address"]: e["opt_in_tx"] for e in eligible},
        })
        return

    if cmd == "gift":
        cmd_giveaway_gift(args, gw, wallet)
        return

    if cmd == "setup":
        cmd_giveaway_setup(args, gw)
        return

    if cmd == "announce":
        cmd_giveaway_announce(args, gw)
        return

    if cmd == "status":
        try:
            info = client.request(AccountInfo(account=wallet,
                                              ledger_index="validated"))
        except Exception as e:
            sys.exit(f"status: account info failed: {e}")
        if not info.is_successful():
            sys.exit(f"status: account info failed: "
                     f"{(info.result or {}).get('error', info.result)}")
        bal = drops_to_xrp((info.result or {}).get("account_data", {})
                           .get("Balance", "0"))
        print(f"Giveaway pot — {wallet} [{network}]")
        print(f"  XRP: {bal}")
        try:
            lines = client.request(AccountLines(account=wallet,
                                                ledger_index="validated",
                                                limit=400))
        except Exception as e:
            sys.exit(f"status: trustlines failed: {e}")
        if lines.is_successful():
            nonzero = [ln for ln in (lines.result or {}).get("lines", [])
                       if float(ln.get("balance", 0)) != 0]
            print(f"  trustlines with balance: {len(nonzero)}")
            for ln in sorted(nonzero, key=lambda x: x.get("currency", "")):
                print(f"    {ln.get('balance')} {ln.get('currency')} "
                      f"({ln.get('account')})")
        else:
            print("  trustlines: (lookup failed)")
        # marker-paged NFT inventory (same shape as nft-inventory)
        nfts, marker = [], None
        while True:
            kw = {"account": wallet, "limit": 400, "ledger_index": "validated"}
            if marker:
                kw["marker"] = marker
            try:
                resp = client.request(AccountNFTs(**kw))
            except Exception as e:
                sys.exit(f"status: NFT inventory failed: {e}")
            if not resp.is_successful():
                sys.exit(f"status: NFT inventory failed: "
                         f"{(resp.result or {}).get('error', resp.result)}")
            res = resp.result or {}
            # Same item-2 standard as nft-inventory: refuse unvalidated data.
            if res.get("validated") is not True:
                sys.exit("status: NFT inventory returned unvalidated "
                         "ledger data — refusing")
            nfts.extend(res.get("account_nfts") or [])
            marker = res.get("marker")
            if not marker:
                break
        print(f"  NFTs owned: {len(nfts)}")
        for n in nfts:
            print(f"    {n.get('NFTokenID')} (taxon {n.get('NFTokenTaxon')})")
        return

    sys.exit(f"unknown giveaway command {cmd!r}")


def cmd_giveaway_gift(args, gw, wallet):
    """PROPOSE a gift from the donation wallet to a winner.

    Nothing is submitted — the normal ceremony applies: the human reviews
    the exact proposal hash, then signs with the donation wallet's key
    under the giveaway policy. There is no auto-send path.
    """
    network = gw["network"]
    max_gift = gw["max_gift_xrp"]

    problem = C.validate_gift_destination(args.to, wallet)
    if problem:
        sys.exit(problem)
    dest = args.to.strip()

    has_amount = args.amount is not None
    has_nft = args.token_id is not None
    if has_amount == has_nft:
        sys.exit("give exactly one of --amount (XRP/IOU gift) "
                 "or --token-id (NFT gift)")

    # All pure validation happens BEFORE any network call, so bad input
    # exits without touching the ledger.
    if has_nft:
        nid = args.token_id.strip().upper()
        if len(nid) != 64 or any(c not in "0123456789abcdefABCDEF"
                                 for c in nid):
            sys.exit("token id must be 64 hex characters")
    else:
        amt = C.dec(args.amount, "amount")
        if amt <= 0:
            sys.exit("amount must be positive")
        ccy = (args.ccy or "XRP").upper()
        issuer = args.issuer
        if ccy == "XRP":
            if issuer:
                sys.exit("XRP gifts take no --issuer")
        elif not issuer:
            sys.exit(f"IOU gift needs --issuer for {ccy}")
        elif not C.is_valid_classic_address(issuer):
            sys.exit("issuer is not a valid classic address")
        cap_problem = C.check_gift_cap(amt, ccy, max_gift)
        if cap_problem:
            sys.exit(cap_problem)

    gclient = get_client(network)

    # Winner sanity check: warn (never block) when the destination is not
    # a currently-eligible entrant. Best effort — a scan failure must not
    # block a legitimate gift.
    try:
        entrants, eproblem = C.eligible_entrants(gclient, wallet,
                                                gw["opt_in_tag"])
        if eproblem:
            print(f"  note: entrant list unavailable ({eproblem}) — "
                  "skipping winner check")
        elif not any(e["address"] == dest and e["eligible"]
                     for e in entrants):
            print(f"  WARNING: {dest} is not in the current eligible "
                  "entrant list.")
            print("  The gift will still be proposed — verify the winner "
                  "out of band.")
    except Exception as e:  # noqa: BLE001
        print(f"  note: entrant check failed ({e}) — continuing")

    if has_nft:
        if not donation_wallet_owns_nft(gclient, wallet, nid):
            sys.exit(f"donation wallet {wallet} does not own NFT {nid} — "
                     "refusing")
        tx = build_gift_nft_offer(wallet, dest, nid, args.expires_in)
        lines = ["gift:     NFT transfer (0 XRP, NOT a sale)",
                 f"token:    {nid}",
                 f"from:     {wallet} (donation wallet)",
                 f"to:       {dest}",
                 "note:     the recipient must accept the offer before it "
                 "expires — nothing moves until they do"]
    else:
        tx = build_gift_payment(wallet, dest, amt, ccy, issuer)
        lines = [f"gift:     {amt} {ccy}"
                 + (f" ({issuer[:12]}…)" if issuer else ""),
                 f"from:     {wallet} (donation wallet)",
                 f"to:       {dest}"]
        if ccy != "XRP":
            lines.append("note:     IOU gifts must be in the approved token "
                         "allowlist AND have a")
            lines.append("          spend_limits entry in the giveaway policy, "
                         "or xrpl-sign")
            lines.append("          denies them (fail-closed)")

    propose(tx, gclient, {"network": network}, C.GIFT_ACTION, lines)


def cmd_giveaway_setup(args, gw):
    """Interactive donation-wallet setup: writes the narrow giveaway signer
    policy, then optionally stores the donation-wallet seed locally.

    The seed is read via getpass — never echoed, never printed, never
    logged. It is validated (must derive the donation wallet) before
    anything is stored. Skipping the seed means the vault injects
    XRPL_GIVEAWAY_SEED at signing time (preferred)."""
    import getpass

    wallet, network, max_gift = (gw["donation_wallet"], gw["network"],
                                 gw["max_gift_xrp"])
    print(f"Giveaway setup — donation wallet {wallet} [{network}]")

    if C.write_giveaway_policy(max_gift, network):
        print(f"  wrote giveaway policy: {C.GIVEAWAY_POLICY_PATH}")
        print(f"    network_lock={network}, Payment+NFTokenCreateOffer only, "
              f"XRP per-tx cap={max_gift}")
    else:
        print(f"  policy exists: {C.GIVEAWAY_POLICY_PATH} (edit it directly)")

    print(f"\nSeed storage. Preferred: the vault injects {C.GIVEAWAY_SEED_ENV}")
    print("at signing time after human approval (nothing stored on disk).")
    print("Fallback: store it here — owner-only 0600, read only by xrpl-sign.")
    try:
        seed = getpass.getpass(
            "Donation wallet seed (Enter to skip, use the vault): ").strip()
    except (EOFError, KeyboardInterrupt):
        print("\nskipped.")
        return
    if not seed:
        print(f"skipped — the signer will read {C.GIVEAWAY_SEED_ENV} "
              "from the environment.")
        return
    try:
        from xrpl.wallet import Wallet
        derived = Wallet.from_seed(seed).classic_address
    except Exception:  # noqa: BLE001
        sys.exit("that is not a valid XRPL seed — nothing was stored")
    if derived != wallet:
        sys.exit(f"that seed derives {derived}, not the donation wallet "
                 f"{wallet} — nothing was stored")
    C.write_giveaway_seed(seed)
    print(f"seed stored in {C.GIVEAWAY_PATH} (0600). It will never be printed.")


def cmd_giveaway_announce(args, gw):
    """Print a draft winner announcement. Read-only — nothing is posted."""
    rec = C.load_last_draw()
    if rec is None:
        sys.exit("no draw on record — run `giveaway draw` first")
    winner = (args.winner or rec.get("winner") or "").strip()
    problem = C.validate_gift_destination(winner, gw["donation_wallet"])
    if problem:
        sys.exit(f"winner: {problem}")
    prize = (args.prize or "").strip() or "(prize not specified)"
    print("Draft announcement — copy, edit, post wherever the community lives:")
    print()
    print("Friday Giveaway winner!")
    print()
    print(f"Winner: {winner}")
    # The prize text is human-supplied free text: sanitize for the
    # terminal like any other untrusted string (item 3).
    print(f"Prize: {C.safe_terminal_text(prize, 200)} — from the community "
          "donation pot")
    print()
    print("Draw proof (verify it yourself):")
    print(f"  ledger:      {rec.get('ledger_index')}")
    print(f"  ledger hash: {rec.get('ledger_hash')}")
    print(f"  method:      {rec.get('method')}")
    print(f"  digest:      {rec.get('digest')}")
    print(f"  entrants:    {rec.get('entrant_count')} eligible")
    print()
    print("Thanks to everyone who entered — and to our donors! Chip in:")
    print(gw["donation_wallet"])
    print()
    print("Next draw: Friday 7:37 AM PT.")


def main():
    ap = argparse.ArgumentParser(prog="xrpl-trade",
                                 description="XRPL proposer: builds tx, never signs.")
    ap.add_argument("--network", choices=list(C.NETWORKS),
                    help="override configured network")
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("setup", help="onboarding: new wallet or address+network")
    p = sub.add_parser("wallet", help="local wallet: create / one-time backup")
    w = p.add_subparsers(dest="wallet_cmd", required=True)
    wc = w.add_parser("create",
                      help="generate a fresh wallet; seed stored 0600, never displayed")
    wc.add_argument("--force", action="store_true",
                    help="replace an already-stored seed")
    w.add_parser("backup",
                 help="ONE-TIME display of the stored seed — write it down")
    wf = w.add_parser("forget-seed",
                      help="vault migration: remove a legacy seed from a local "
                           "file after operator-confirmed vault backup")
    wf.add_argument("--path", default=None,
                    help="file to strip the seed from "
                         "(default ~/.xrpl/config.json)")
    p = sub.add_parser("autopilot",
                       help="at-your-own-risk local mainnet signing: "
                            "enable / disable / status")
    ap_ = p.add_subparsers(dest="autopilot_cmd", required=True)
    ape = ap_.add_parser("enable",
                         help="store the seed locally (0600) after the risk "
                              "disclosure — explicit opt-in")
    ape.add_argument("--address", default=None,
                     help="account address (default: config.json address)")
    ap_.add_parser("disable",
                   help="remove the autopilot seed from disk "
                        "(vault-only again)")
    ap_.add_parser("status",
                   help="show autopilot state (never displays the seed)")
    p = sub.add_parser("balance", help="XRP + trustline balances")
    p.add_argument("address", nargs="?", help="classic address (default: configured)")
    p = sub.add_parser("quote", help="order book for any pair")
    p.add_argument("--pair", default=None)
    p.add_argument("--base", default="XRP"); p.add_argument("--quote", default="RLUSD")
    p.add_argument("--base-issuer", default=None); p.add_argument("--quote-issuer", default=None)
    p.add_argument("--limit", type=int, default=5)
    sub.add_parser("pairs", help="list approved trading pairs")
    p = sub.add_parser("inspect-token", help="issuer risk: domain, transfer fee, freeze flags")
    p.add_argument("--currency", required=True); p.add_argument("--issuer", required=True)
    p = sub.add_parser("plan-trade", help="estimate fill, impact, max spend (read-only)")
    p.add_argument("--pair", default=None)
    p.add_argument("--base", default="XRP"); p.add_argument("--quote", default="RLUSD")
    p.add_argument("--base-issuer", default=None); p.add_argument("--quote-issuer", default=None)
    p.add_argument("--side", required=True, choices=["buy", "sell"])
    p.add_argument("--amount", required=True); p.add_argument("--price", required=True)
    p = sub.add_parser("reconcile", help="validated outcome of a submitted tx hash")
    p.add_argument("--hash", required=True)

    def add_offer(p_):
        p_.add_argument("--pair", default=None)
        p_.add_argument("--base", default="XRP"); p_.add_argument("--quote", default="RLUSD")
        p_.add_argument("--base-issuer", default=None); p_.add_argument("--quote-issuer", default=None)
        p_.add_argument("--amount", required=True, help="amount of BASE")
        p_.add_argument("--price", required=True, help="QUOTE per BASE")
        p_.add_argument("--expires-in", type=int, default=3600,
                       help="offer expiry seconds (default 3600)")

    p = sub.add_parser("buy", help="PROPOSE buy BASE with QUOTE at limit price")
    add_offer(p)
    p = sub.add_parser("sell", help="PROPOSE sell BASE for QUOTE at limit price")
    add_offer(p)
    p = sub.add_parser("trustline", help="PROPOSE a trustline")
    p.add_argument("--pair", default=None)
    p.add_argument("--currency", default="RLUSD"); p.add_argument("--issuer", default=None)
    p.add_argument("--limit", default="1000000")
    p = sub.add_parser("cancel", help="PROPOSE cancelling an open offer")
    p.add_argument("--seq", required=True, type=int)
    p = sub.add_parser("send", help="PROPOSE sending XRP or an IOU")
    p.add_argument("--to", required=True); p.add_argument("--amount", required=True)
    p.add_argument("--ccy", default="XRP"); p.add_argument("--issuer", default=None)
    p.add_argument("--destination-tag", default=None, type=int)
    p = sub.add_parser("faucet", help="fund a fresh testnet/devnet wallet")
    p.add_argument("--network", choices=["testnet", "devnet"], default=None)
    p = sub.add_parser("nft-stage", help="STAGE artwork for an NFT mint: "
                                        "validate + hash locally, zero "
                                        "network calls")
    p.add_argument("--file", required=True,
                   help="artwork file (must be inside the NFT media "
                        "directory, ~/.xrpl/media by default)")
    p.add_argument("--name", required=True, help="NFT name")
    p.add_argument("--description", default="",
                   help="NFT description (goes in the metadata JSON)")
    p.add_argument("--royalty-bps", default=1000, type=int,
                   help="creator royalty in basis points, 0..5000 "
                        "(default 1000 = 10%%; IMMUTABLE after mint)")
    p.add_argument("--taxon", default=0, type=int,
                   help="NFTokenTaxon grouping id (default 0)")
    p = sub.add_parser("nft-pin-and-propose",
                       help="PIN staged artwork + metadata to IPFS "
                            "(external write via your Pinata key) and "
                            "PROPOSE the mint")
    p.add_argument("--stage", required=True,
                   help="stage id printed by nft-stage")
    p = sub.add_parser("nft-list", help="PROPOSE listing an owned NFT for "
                                       "sale (XRP only, sell offer)")
    p.add_argument("--token-id", required=True,
                   help="NFTokenID (64 hex chars)")
    p.add_argument("--price-xrp", required=True, help="asking price in XRP")
    p.add_argument("--destination", default=None,
                   help="optional buyer address for a private sale")
    p.add_argument("--expires-in", type=int, default=86400,
                   help="listing expiry seconds (default 86400)")
    p = sub.add_parser("nft-inventory", help="list NFTs owned by an account "
                                            "(read-only)")
    p.add_argument("address", nargs="?",
                   help="classic address (default: configured)")
    p = sub.add_parser("nft-buy", help="verify an NFT sell offer, then PROPOSE "
                                      "accepting it (XRP only)")
    p.add_argument("--offer-index", required=True,
                   help="sell offer index (64 hex chars)")
    p = sub.add_parser("nft-bid", help="PROPOSE a buy offer (bid) on someone "
                                      "else's NFT (XRP only)")
    p.add_argument("--token-id", required=True,
                   help="NFTokenID (64 hex chars)")
    p.add_argument("--seller", required=True,
                   help="owner's classic address (only they can accept)")
    p.add_argument("--price-xrp", required=True, help="bid in XRP")
    p.add_argument("--expires-in", type=int, default=86400,
                   help="bid expiry seconds (default 86400)")
    p = sub.add_parser("nft-send", help="PROPOSE gifting an owned NFT "
                                       "(0-XRP transfer offer to a favorite "
                                       "name or r-address)")
    p.add_argument("--token-id", required=True,
                   help="NFTokenID (64 hex chars)")
    p.add_argument("--to", required=True,
                   help="recipient: favorite name (case-insensitive) or "
                        "classic r-address")
    p.add_argument("--expires-in", type=int, default=86400,
                   help="transfer-offer expiry seconds (default 86400)")
    p = sub.add_parser("favorites", help="named watchlist of artist wallets "
                                         "(local, read-only)")
    fav = p.add_subparsers(dest="fav_cmd", required=True)
    a = fav.add_parser("add", help="watch an artist wallet")
    a.add_argument("name", help="short name, e.g. lara")
    a.add_argument("address", help="artist's classic r-address")
    a.add_argument("--note", default=None, help="optional note")
    r = fav.add_parser("remove", help="stop watching a wallet")
    r.add_argument("name")
    fav.add_parser("list", help="show the watchlist")
    rn = fav.add_parser("rename", help="rename a favorite")
    rn.add_argument("old")
    rn.add_argument("new")
    p = sub.add_parser("profile", help="your local assistant profile: name, "
                                       "watch-only addresses, memberships, "
                                       "interests (local only, never leaves "
                                       "this machine)")
    prof = p.add_subparsers(dest="prof_cmd", required=True)
    prof.add_parser("init", help="interactive onboarding questionnaire")
    prof.add_parser("show", help="show your profile")
    s = prof.add_parser("set", help="set a scalar field")
    s.add_argument("field", help="display_name | alerts.price_moves | "
                                 "alerts.threshold_pct")
    s.add_argument("value", help="new value")
    aa = prof.add_parser("add-address",
                         help="add a WATCH-ONLY classic address (never a seed)")
    aa.add_argument("address")
    ra = prof.add_parser("remove-address", help="remove a watch-only address")
    ra.add_argument("address")
    am = prof.add_parser("add-membership",
                         help="add a DAO membership, e.g. xaodao")
    am.add_argument("name")
    rm = prof.add_parser("remove-membership", help="remove a DAO membership")
    rm.add_argument("name")
    ai = prof.add_parser("add-interest",
                         help="add an interest, e.g. trading")
    ai.add_argument("name")
    ri = prof.add_parser("remove-interest", help="remove an interest")
    ri.add_argument("name")
    prof.add_parser("clear", help="delete your local profile")
    p = sub.add_parser("nft-new", help="new mints from favorite artists "
                                       "(read-only)")
    p.add_argument("--days", type=int, default=None,
                   help="window in days, 1-90 (default: since last check; "
                        "--days never moves the watermark)")
    p = sub.add_parser("xrpresso", help="search the XRPresso marketplace "
                                        "(read-only, no key)")
    xp = p.add_subparsers(dest="xp_cmd", required=True)
    l = xp.add_parser("listings", help="search marketplace listings")
    l.add_argument("--category", default=None,
                   help="category key (see: xrpresso categories)")
    l.add_argument("--q", default=None,
                   help="search title/description (min 2 chars)")
    l.add_argument("--limit", type=int, default=20,
                   help="1-50 (default 20)")
    l.add_argument("--sort", default="newest",
                   choices=["newest", "price_asc", "price_desc",
                            "ending_soon"])
    l.add_argument("--currency", default=None, choices=["XRP", "RLUSD"])
    n = xp.add_parser("nfts", help="XRPresso-native NFT listings")
    n.add_argument("--q", default=None,
                   help="search token name (min 2 chars)")
    n.add_argument("--limit", type=int, default=20,
                   help="1-50 (default 20)")
    n.add_argument("--sort", default="newest",
                   choices=["newest", "price_asc", "price_desc"])
    a = xp.add_parser("auctions", help="live NFT auctions")
    a.add_argument("--limit", type=int, default=12,
                   help="1-50 (default 12)")
    d = xp.add_parser("listing", help="full detail for one listing")
    d.add_argument("id", help="listing id")
    xp.add_parser("stats", help="marketplace aggregate stats")
    xp.add_parser("categories", help="listing category keys")
    p = sub.add_parser("giveaway", help="Friday community giveaway: opt in, "
                                        "list entrants, draw a winner, show "
                                        "the pot (draw only selects — it "
                                        "never sends)")
    gp = p.add_subparsers(dest="gw_cmd", required=True)
    gp.add_parser("opt-in", help="opt in: checks for an on-ledger 1-drop "
                                 "entry, otherwise PROPOSES one (human "
                                 "approval still required; recorded only "
                                 "after validation)")
    e = gp.add_parser("entrants", help="list opt-ins + eligibility "
                                       "(read-only)")
    e.add_argument("--donation-wallet", default=None,
                   help="donation wallet (default: ~/.xrpl/giveaway.json)")
    d = gp.add_parser("draw", help="deterministic draw from a future ledger "
                                   "hash (read-only; selects only)")
    d.add_argument("--donation-wallet", default=None,
                   help="donation wallet (default: ~/.xrpl/giveaway.json)")
    d.add_argument("--ledger-offset", type=int, default=20,
                   help="ledgers ahead of the current validated index to "
                        "draw from (default 20)")
    s = gp.add_parser("status", help="the pot: XRP balance, nonzero "
                                     "trustlines, NFT inventory (read-only)")
    s.add_argument("--donation-wallet", default=None,
                   help="donation wallet (default: ~/.xrpl/giveaway.json)")
    g = gp.add_parser("gift", help="PROPOSE a gift from the donation wallet "
                                  "(human approval still required; never "
                                  "auto-sends)")
    g.add_argument("--to", required=True, help="winner's classic address")
    g.add_argument("--amount", default=None,
                   help="gift amount (XRP or IOU; exactly one of --amount / "
                        "--token-id)")
    g.add_argument("--ccy", default="XRP", help="currency code (default XRP)")
    g.add_argument("--issuer", default=None,
                   help="issuer (required for IOU gifts)")
    g.add_argument("--token-id", default=None,
                   help="NFT id to gift (0-XRP transfer offer)")
    g.add_argument("--donation-wallet", default=None,
                   help="donation wallet (default: ~/.xrpl/giveaway.json)")
    g.add_argument("--expires-in", type=int, default=86400,
                   help="NFT transfer offer expiry in seconds (default 86400)")
    gp.add_parser("setup", help="interactive donation-wallet setup: signer "
                               "policy + optional local seed (getpass, never "
                               "echoed)").add_argument(
        "--donation-wallet", default=None,
        help="donation wallet to set up (default: ~/.xrpl/giveaway.json)")
    a = gp.add_parser("announce", help="print a draft winner announcement "
                                      "(read-only, nothing posted)")
    a.add_argument("--winner", default=None,
                   help="winner address (default: last draw's winner)")
    a.add_argument("--prize", default=None,
                   help="prize description, e.g. '5 XRP'")
    a.add_argument("--donation-wallet", default=None,
                   help="donation wallet (default: ~/.xrpl/giveaway.json)")

    args = ap.parse_args()
    if args.cmd == "favorites":
        # Local-only: no config, no network client needed.
        cmd_favorites(args)
        return
    if args.cmd == "profile" and args.prof_cmd != "init":
        # Local-only: no config, no network client needed.
        cmd_profile(args)
        return
    if args.cmd == "xrpresso":
        # Public HTTP API: no wallet, no XRPL client, no config needed.
        cmd_xrpresso(args)
        return
    if args.cmd == "wallet":
        # Local-only: key generation and backup display need no network.
        cmd_wallet(args, load_config())
        return
    if args.cmd == "autopilot":
        # Local-only state + (for enable) one ledger read to verify the
        # seed controls the account. No XRPL client needed up front.
        cmd_autopilot(args, load_config())
        return
    cfg = load_config()
    network = args.network or cfg.get("network", "testnet")
    if network not in C.NETWORKS:
        sys.exit(f"unknown network {network!r}")
    cfg["network"] = network
    client = get_client(network)

    if args.cmd == "profile":
        # Only `init` reaches here (others returned above); it may PROPOSE
        # the giveaway opt-in when the user answers yes.
        cmd_profile(args, cfg, client)
        return

    {
        "setup": lambda: cmd_setup(args),
        "balance": lambda: cmd_balance(args, cfg, client),
        "quote": lambda: cmd_quote(args, cfg, client),
        "pairs": lambda: cmd_pairs(args, cfg, client),
        "inspect-token": lambda: cmd_inspect_token(args, cfg, client),
        "plan-trade": lambda: cmd_plan_trade(args, cfg, client),
        "reconcile": lambda: cmd_reconcile(args, cfg, client),
        "buy": lambda: cmd_buy(args, cfg, client),
        "sell": lambda: cmd_sell(args, cfg, client),
        "trustline": lambda: cmd_trustline(args, cfg, client),
        "cancel": lambda: cmd_cancel(args, cfg, client),
        "send": lambda: cmd_send(args, cfg, client),
        "faucet": lambda: cmd_faucet(args, cfg, client),
        "nft-stage": lambda: cmd_nft_stage(args, cfg, client),
        "nft-pin-and-propose": lambda: cmd_nft_pin_and_propose(args, cfg,
                                                              client),
        "nft-list": lambda: cmd_nft_list(args, cfg, client),
        "nft-send": lambda: cmd_nft_send(args, cfg, client),
        "nft-inventory": lambda: cmd_nft_inventory(args, cfg, client),
        "nft-buy": lambda: cmd_nft_buy(args, cfg, client),
        "nft-bid": lambda: cmd_nft_bid(args, cfg, client),
        "nft-new": lambda: cmd_nft_new(args, cfg, client),
        "giveaway": lambda: cmd_giveaway(args, cfg, client),
    }[args.cmd]()


if __name__ == "__main__":
    main()
