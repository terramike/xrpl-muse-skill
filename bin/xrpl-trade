# ---------- config / client ----------

def load_config():
    cfg = {}
    if C.CONFIG_PATH.exists():
        cfg = json.loads(C.CONFIG_PATH.read_text())
    cfg["address"] = os.environ.get("XRPL_ADDRESS") or cfg.get("address")
    cfg["network"] = os.environ.get("XRPL_NETWORK") or cfg.get("network", "testnet")
    return cfg


def get_client(network):
    def _request(self, request):
        return asyncio.run(self._request_impl(request, timeout=30.0))

    last_err = None
    for url in C.NETWORKS[network]:
        c = JsonRpcClient(url)
        c.request = _request.__get__(c, JsonRpcClient)
        for attempt in range(3):
            try:
                if c.request(ServerInfo()).is_successful():
                    return c
                break
            except Exception as e:  # noqa: BLE001
                last_err = e
                time.sleep(1 + attempt)
    sys.exit(f"No healthy {network} node ({last_err}).")


# ---------- builders (pure: no network, no signing) ----------

def iou_amount(currency, issuer, value: Decimal):
    return IssuedCurrencyAmount(
        currency=C.currency_code(currency), issuer=issuer, value=format(value, "f"))


def make_amount(ccy, issuer, value: Decimal):
    if ccy == "XRP":
        return xrp_to_drops(value)
    if not issuer:
        sys.exit(f"issuer required for {ccy} "
                 f"(pass --base-issuer/--quote-issuer or use --pair)")
    return iou_amount(ccy, issuer, value)


def make_currency(ccy, issuer):
    if ccy == "XRP":
        return XRP()
    if not issuer:
        sys.exit(f"issuer required for {ccy}")
    return IssuedCurrency(currency=C.currency_code(ccy), issuer=issuer)


def build_gift_payment(donation_wallet, dest, amount: Decimal, ccy, issuer):
    """Pure builder: a gift Payment FROM the donation wallet. Never signs."""
    return Payment(account=donation_wallet, destination=dest,
                   amount=make_amount(ccy, issuer, amount))


def build_gift_nft_offer(donation_wallet, dest, token_id, expires_in=86400):
    """Pure builder: a 0-XRP destination-restricted NFTokenCreateOffer gift
    (transfer, never a sale) FROM the donation wallet. Never signs."""
    return NFTokenCreateOffer(
        account=donation_wallet,
        nftoken_id=token_id.strip().upper(),
        amount="0",  # 0 drops: gift transfer, NOT a sale
        destination=dest,
        expiration=C.ripple_time_from_now(expires_in),
        flags=int(NFTokenCreateOfferFlag.TF_SELL_NFTOKEN),
    )


def donation_wallet_owns_nft(client, wallet, token_id):
    """Fail-closed check that the donation wallet owns the NFT (marker-paged)."""
    marker = None
    while True:
        kw = {"account": wallet, "limit": 400, "ledger_index": "validated"}
        if marker:
            kw["marker"] = marker
        try:
            resp = client.request(AccountNFTs(**kw))
        except Exception as e:  # noqa: BLE001
            sys.exit(f"gift: NFT ownership lookup failed: {e}")
        if not resp.is_successful():
            sys.exit("gift: NFT ownership lookup failed — refusing")
        res = resp.result or {}
        # Item 2 standard: ledger_index="validated" is a request, not a
        # guarantee — refuse the data unless the node confirms it.
        if res.get("validated") is not True:
            sys.exit("gift: NFT ownership lookup returned unvalidated "
                     "ledger data — refusing")
        for n in res.get("account_nfts", []):
            if n.get("NFTokenID") == token_id:
                return True
        marker = res.get("marker")
        if not marker:
            return False


def build_offer_tx(account, base, base_issuer, quote, quote_issuer,
                  amount: Decimal, price: Decimal, side: str, expires_in: int):
    """side=buy: BUY base, SELL quote (TakerPays=base amount, TakerGets=quote cost).
    side=sell: SELL base, BUY quote (TakerPays=quote proceeds, TakerGets=base amount).
    (XRPL: TakerPays is the currency the offer creator BUYS; TakerGets is what they SELL.)"""
    if side == "buy":
        cost = (amount * price).quantize(Decimal("0.000001"), rounding=ROUND_DOWN)
        taker_pays = make_amount(base, base_issuer, amount)
        taker_gets = make_amount(quote, quote_issuer, cost)
    elif side == "sell":
        proceeds = (amount * price).quantize(Decimal("0.000001"), rounding=ROUND_DOWN)
        taker_pays = make_amount(quote, quote_issuer, proceeds)
        taker_gets = make_amount(base, base_issuer, amount)
    else:
        sys.exit("side must be buy or sell")
    return OfferCreate(
        account=account, taker_pays=taker_pays, taker_gets=taker_gets,
        expiration=C.ripple_time_from_now(expires_in))


def fmt_amt(a):
    if isinstance(a, dict):
        return f"{a['value']} {C.display_currency(a['currency'])}.{a['issuer'][:8]}…"
    return f"{drops_to_xrp(a)} XRP"


# ---------- ceremony ----------

def propose(tx, client, cfg, action, summary_lines):
    """Autofill, hash into a bound envelope, save. Never submits."""
    filled = autofill(tx, client)
    txd = filled.to_xrpl()  # PascalCase wire format (to_dict() is snake_case)
    # Unsigned proposals must not carry signature material — autofill adds
    # an empty SigningPubKey, which the signer's envelope invariants reject.
    txd.pop("SigningPubKey", None)
    txd.pop("TxnSignature", None)
    lines = [
        f"network:  {cfg['network']}",
        f"account:  {txd['Account']}",
        f"action:   {action}",
        *summary_lines,
        f"fee:      {drops_to_xrp(txd['Fee'])} XRP",
        f"sequence: {txd['Sequence']}",
        f"last_ledger: {txd.get('LastLedgerSequence', 'n/a')}",
    ]
    if "Expiration" in txd:
        exp = time.strftime("%Y-%m-%dT%H:%M:%SZ",
                            time.gmtime(txd["Expiration"] + C.RIPPLE_EPOCH))
        lines.append(f"expires:  {exp}")
    # P1-1 approval binding: the proposal is bound to the signing profile
    # (account+network+credential+policy+state) and the exact policy digest
    # the human reviews against. The signer rejects cross-profile use.
    prof_name, _prof, _ppath, pdigest = C.resolve_proposal_profile(
        cfg["network"], txd["Account"], action)
    h, _ = C.save_proposal(txd, cfg["network"], txd["Account"], action,
                           profile=prof_name, policy_sha256=pdigest)
    print("=" * 60)
    print("PROPOSAL — review carefully. Nothing has been submitted.")
    print("=" * 60)
    for ln in lines:
        print("  " + ln)
    print("=" * 60)
    print(f"proposal hash: {h}")
    print(f"\nA HUMAN must review the hash above, then run:")
    print(f"  bound profile: {prof_name} (policy sha256 {pdigest[:16]}…)")
    if action == C.GIFT_ACTION:
        # Donation-wallet gifts sign under the giveaway policy with the
        # giveaway seed — never the main wallet's key or policy.
        print(f"  {C.giveaway_sign_command(h, prof_name)}")
        if C.GIVEAWAY_POLICY_PATH.exists():
            print(f"\nGiveaway policy: {C.GIVEAWAY_POLICY_PATH}")
        else:
            print(f"\nGiveaway policy: {C.GIVEAWAY_POLICY_PATH} "
                  "(missing — run `giveaway setup` first)")
        print(f"Seed: {C.GIVEAWAY_SEED_ENV} (vault-injected) or `giveaway setup`")
    else:
        if prof_name == "adhoc-testnet":
            print(f"  xrpl-sign --hash {h} --approve")
        else:
            print(f"  xrpl-sign --profile {prof_name} --hash {h} --approve")
    print(f"\nFull autofilled transaction saved to:\n"
          f"  {C.PROPOSALS_DIR / (h + '.json')}")
    return h


# ---------- read commands ----------

def cmd_balance(args, cfg, client):
    addr = args.address or cfg.get("address")
    if not addr:
        sys.exit("No address. Pass one or run `xrpl-trade setup`.")
    info = client.request(AccountInfo(account=addr, ledger_index="validated"))
    if not info.is_successful():
        sys.exit(f"AccountInfo failed: {info.result}")
    xrp_bal = drops_to_xrp(info.result['account_data']['Balance'])
    px = C.fetch_xrp_usd()
    if px is not None:
        print(f"XRP/USD (Bitstamp): ${px:.5f}")
        print(f"XRP: {xrp_bal} (~${float(xrp_bal) * px:,.2f})")
    else:
        print(f"XRP: {xrp_bal}")
    lines = client.request(AccountLines(account=addr, ledger_index="validated"))
    if lines.is_successful():
        for l in lines.result.get("lines", []):
            if Decimal(l["balance"]) != 0:
                print(f"{l['currency']}.{l['account'][:8]}…: {l['balance']} "
                      f"(limit {l['limit']})")


def book_side(client, gets, pays, limit):
    r = client.request(BookOffers(taker_gets=gets, taker_pays=pays,
                                  limit=limit, ledger_index="validated"))
    if not r.is_successful():
        sys.exit(f"BookOffers failed: {r.result}")
    return r.result.get("offers", [])


def amt_value(a):
    if isinstance(a, dict):
        return Decimal(a["value"]), C.display_currency(a["currency"])
    return Decimal(drops_to_xrp(a)), "XRP"


def funded_amt(offer, field):
    """P1-5: the funded quantity of a book level. Prefers the funded field
    (taker_gets_funded/taker_pays_funded) when present; a present-but-zero
    funded value means no real liquidity (never falls back to nominal).
    Returns (Decimal, currency-display)."""
    funded_key = {"TakerGets": "taker_gets_funded",
                  "TakerPays": "taker_pays_funded"}[field]
    if funded_key in offer:
        f = offer[funded_key]
        if isinstance(f, dict):
            return Decimal(f["value"]), C.display_currency(f["currency"])
        return Decimal(drops_to_xrp(f)), "XRP"
    return amt_value(offer[field])


def cmd_quote(args, cfg, client):
    base, base_issuer, quote, quote_issuer = C.resolve_pair(args)
    base_amt = make_currency(base, base_issuer)
    quote_amt = make_currency(quote, quote_issuer)
    asks = book_side(client, base_amt, quote_amt, args.limit)
    bids = book_side(client, quote_amt, base_amt, args.limit)
    print(f"--- {base}/{quote} asks (sell {base}) ---")
    for o in asks:
        qv, _ = amt_value(o["TakerPays"]); bv, _ = amt_value(o["TakerGets"])
        print(f"  {fmt_amt(o['TakerGets'])} @ {qv / bv:.6f} {quote}")
    print(f"--- {base}/{quote} bids (buy {base}) ---")
    for o in bids:
        qv, _ = amt_value(o["TakerGets"]); bv, _ = amt_value(o["TakerPays"])
        print(f"  {fmt_amt(o['TakerPays'])} @ {qv / bv:.6f} {quote}")


def cmd_pairs(args, cfg, client):
    pairs = C.load_approved()
    if not pairs:
        print(f"No approved pairs. Copy approved.example.json to {C.APPROVED_PATH}.")
        return
    for name in sorted(pairs):
        p = pairs[name]
        print(f"{name}: {p['base']} ({(p.get('base_issuer') or 'native')[:12]}) / "
              f"{p['quote']} ({(p.get('quote_issuer') or 'native')[:12]})")


def cmd_offers(args, cfg, client):
    addr = args.address or cfg.get("address")
    if not addr:
        sys.exit("No address. Pass one or run `xrpl-trade setup`.")
    r = client.request(AccountOffers(account=addr, ledger_index="validated"))
    if not r.is_successful():
        sys.exit(f"AccountOffers failed: {r.result}")
    offers = r.result.get("offers", [])
    if not offers:
        print("No open offers.")
        return
    for o in offers:
        print(f"seq={o['seq']} {fmt_amt(o['taker_gets'])} <- {fmt_amt(o['taker_pays'])}")


def cmd_inspect_token(args, cfg, client):
    ccy, issuer = args.currency.upper(), args.issuer
    r = client.request(AccountInfo(account=issuer, ledger_index="validated"))
    if not r.is_successful():
        sys.exit(f"Issuer account not found: {r.result}")
    ad = r.result["account_data"]
    flags = int(ad.get("Flags", 0))
    rate = int(ad.get("TransferRate", 1000000000))
    fee_pct = (rate - 1000000000) / 10000000
    domain = ad.get("Domain")
    if domain:
        try:
            domain = bytes.fromhex(domain).decode()
        except ValueError:
            pass
    print(f"token:  {ccy}.{issuer}")
    print(f"domain: {domain or 'NOT SET (no toml verification possible)'}")
    print(f"transfer fee: {fee_pct:.3f}%")
    print(f"global freeze: {'YES — issuer can freeze all holders' if flags & 0x00400000 else 'no'}")
    print(f"no-freeze enabled: {'yes (issuer gave up freeze power)' if flags & 0x00200000 else 'no'}")


def cmd_plan_trade(args, cfg, client):
    base, base_issuer, quote, quote_issuer = C.resolve_pair(args)
    amount = C.dec(args.amount, "amount")
    price = C.dec(args.price, "price")
    side = args.side
    base_amt = make_currency(base, base_issuer)
    quote_amt = make_currency(quote, quote_issuer)
    # walk the side we'd take from: buys take asks, sells take bids
    if side == "buy":
        book = book_side(client, base_amt, quote_amt, 50)  # asks
        get_f, pay_f = "TakerGets", "TakerPays"
    else:
        book = book_side(client, quote_amt, base_amt, 50)  # bids
        get_f, pay_f = "TakerPays", "TakerGets"
    if not book:
        sys.exit("Empty book — no liquidity.")
    # P1-5: preview on FUNDED amounts, like the signer's guard.
    best_q, best_b = funded_amt(book[0], pay_f), funded_amt(book[0], get_f)
    mid = best_q[0] / best_b[0]
    dev = (price - mid) / mid * 100
    # walk depth at-or-better than our limit
    filled_base = Decimal(0); spent_quote = Decimal(0)
    for o in book:
        qv, _ = funded_amt(o, pay_f); bv, _ = funded_amt(o, get_f)
        if bv == 0:
            continue  # unfunded level: no real liquidity
        px = qv / bv
        if (side == "buy" and px > price) or (side == "sell" and px < price):
            break
        take = min(bv, amount - filled_base)
        filled_base += take; spent_quote += take * px
        if filled_base >= amount:
            break
    pct = filled_base / amount * 100
    avg = spent_quote / filled_base if filled_base else Decimal(0)
    max_spend = (amount * price).quantize(Decimal("0.000001"), rounding=ROUND_DOWN)
    print(f"plan: {side} {amount} {base} @ limit {price} {quote} [{cfg['network']}]")
    print(f"book mid: {mid:.6f} {quote}  (limit is {dev:+.2f}% vs mid)")
    print(f"est. fill at limit: {filled_base} {base} ({pct:.1f}%)")
    if filled_base:
        print(f"avg fill price: {avg:.6f} {quote}")
    print(f"max spend: {max_spend} {quote}")
    if pct < 100:
        print("NOTE: book is thin at this limit — expect a partial fill, "
              "rest becomes a resting offer.")


def cmd_reconcile(args, cfg, client):
    r = client.request(Tx(transaction=args.hash))
    if not r.is_successful():
        sys.exit(f"tx lookup failed: {r.result}")
    res = r.result
    meta = res.get("meta", {})
    validated = res.get("validated", False)
    print(f"hash:      {args.hash}")
    print(f"validated: {validated}")
    print(f"result:    {meta.get('TransactionResult', '?')}")
    print(f"ledger:    {res.get('ledger_index', '?')}")


# ---------- write commands (propose only) ----------

def need_account(cfg):
    if not cfg.get("address"):
        sys.exit("No address configured. Run `xrpl-trade setup` first.")
    return cfg["address"]


# ---------- xrpl.to safety checks (pre-trade path) ----------

def safety_lines(args, base, base_issuer, quote, quote_issuer):
    """Advisory scam-check + token-risk lines for a proposal's IOU legs.

    Default-on; --no-safety skips. Fail-open: if xrpl.to is unreachable the
    lines say UNAVAILABLE (unknown, NOT clean) and the proposal proceeds —
    the human and the signer policy stay the gate. A positive scam hit is
    printed LOUD but never blocks: blocklists can false-positive.
    """
    if getattr(args, "no_safety", False) or xrpl_to is None:
        return []
    try:
        return xrpl_to.check_pair_legs(base, base_issuer, quote, quote_issuer)
    except Exception:
        return ["  ⚠️  xrpl.to safety check errored — treat as UNKNOWN, "
                "not clean."]


def cmd_token_safety(args, cfg, client):
    if xrpl_to is None:
        sys.exit("xrpl_to module unavailable")
    for ln in xrpl_to.format_safety_lines(args.issuer, args.currency):
        print(ln)


